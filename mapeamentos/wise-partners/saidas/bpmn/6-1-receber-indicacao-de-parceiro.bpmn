<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-25" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-25">
    <bpmn:participant id="Participant_P-25" name="6.1 Receber indicação de parceiro" processRef="Process_P-25" />
    <bpmn:participant id="Ext_P-25_X1" name="Parceiro" />
    <bpmn:participant id="Ext_P-25_X2" name="Cliente indicado" />
    <bpmn:messageFlow id="P-25_M1" name="Indicação" sourceRef="Ext_P-25_X1" targetRef="P-25_i1" />
    <bpmn:messageFlow id="P-25_M2" name="Confirmação de recebimento" sourceRef="P-25_t2" targetRef="Ext_P-25_X1" />
    <bpmn:messageFlow id="P-25_M3" name="Primeiro contato" sourceRef="P-25_t4" targetRef="Ext_P-25_X2" />
    <bpmn:messageFlow id="P-25_M4" name="Retorno sobre o primeiro contato" sourceRef="P-25_t5" targetRef="Ext_P-25_X1" />
    <bpmn:messageFlow id="P-25_M5" name="Motivo da recusa" sourceRef="P-25_t6" targetRef="Ext_P-25_X1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-25" name="6.1 Receber indicação de parceiro" isExecutable="false">
    <bpmn:documentation>Registrar a indicação com o parceiro de origem, validar duplicidade e ICP, fazer o primeiro contato e dar retorno ao parceiro. [status do fluxo: Declarado; evidências: EV-0063, EV-0033, EV-0101, EV-0102, EV-0075, EV-0076]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-25">
      <bpmn:lane id="Lane_P-25_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-25_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-25_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-25_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-25_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-25_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-25_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-25_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-25_f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-25_f2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-25_PA-07" name="Comercial das empresas do grupo (Wise, Tríade, Swallow)">
        <bpmn:flowNodeRef>P-25_t4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-25_i1" name="Indicação recebida"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:outgoing>P-25_F1</bpmn:outgoing><bpmn:messageEventDefinition id="P-25_i1_def" /></bpmn:startEvent>
    <bpmn:userTask id="P-25_t1" name="Registrar a indicação com o parceiro de origem"><bpmn:documentation>sistema: Portal Wise Partners; status: Declarado</bpmn:documentation><bpmn:incoming>P-25_F1</bpmn:incoming><bpmn:outgoing>P-25_F2</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P-25_t2" name="Confirmar o recebimento ao parceiro"><bpmn:documentation>sistema: Portal Wise Partners; status: Declarado</bpmn:documentation><bpmn:incoming>P-25_F2</bpmn:incoming><bpmn:outgoing>P-25_F3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:task id="P-25_t3" name="Validar duplicidade e ICP"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-25_F3</bpmn:incoming><bpmn:outgoing>P-25_F4</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="P-25_g1" name="Indicação válida?"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-25_F4</bpmn:incoming><bpmn:outgoing>P-25_F5</bpmn:outgoing><bpmn:outgoing>P-25_F6</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="P-25_t4" name="Contatar o cliente indicado"><bpmn:documentation>Quem faz o primeiro contato não está escrito em nenhum documento; está em pergunta.; status: Hipótese</bpmn:documentation><bpmn:incoming>P-25_F5</bpmn:incoming><bpmn:outgoing>P-25_F7</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-25_t5" name="Retornar ao parceiro sobre o primeiro contato"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-25_F7</bpmn:incoming><bpmn:outgoing>P-25_F8</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-25_t6" name="Informar o parceiro do motivo"><bpmn:documentation>Dedução: indicação recusada também precisa de retorno ao parceiro. Em pergunta.; status: Hipótese</bpmn:documentation><bpmn:incoming>P-25_F6</bpmn:incoming><bpmn:outgoing>P-25_F9</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="P-25_f1" name="Indicação em atendimento"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-25_F8</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-25_f2" name="Indicação recusada"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-25_F9</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-25_F1" name="" sourceRef="P-25_i1" targetRef="P-25_t1" />
    <bpmn:sequenceFlow id="P-25_F2" name="" sourceRef="P-25_t1" targetRef="P-25_t2" />
    <bpmn:sequenceFlow id="P-25_F3" name="" sourceRef="P-25_t2" targetRef="P-25_t3" />
    <bpmn:sequenceFlow id="P-25_F4" name="" sourceRef="P-25_t3" targetRef="P-25_g1" />
    <bpmn:sequenceFlow id="P-25_F5" name="Sim" sourceRef="P-25_g1" targetRef="P-25_t4" />
    <bpmn:sequenceFlow id="P-25_F6" name="Não" sourceRef="P-25_g1" targetRef="P-25_t6" />
    <bpmn:sequenceFlow id="P-25_F7" name="" sourceRef="P-25_t4" targetRef="P-25_t5" />
    <bpmn:sequenceFlow id="P-25_F8" name="" sourceRef="P-25_t5" targetRef="P-25_f1" />
    <bpmn:sequenceFlow id="P-25_F9" name="" sourceRef="P-25_t6" targetRef="P-25_f2" />
  </bpmn:process>

    <bpmn:sequenceFlow id="P-06_F9" name="Não" sourceRef="P-06_g2" targetRef="P-06_f2" />
    <bpmn:sequenceFlow id="P-06_F10" name="Agora não" sourceRef="P-06_g2" targetRef="P-06_s4" />
    <bpmn:sequenceFlow id="P-06_F11" name="" sourceRef="P-06_s4" targetRef="P-06_s3" />
    <bpmn:sequenceFlow id="P-06_F12" name="" sourceRef="P-06_s5" targetRef="P-06_f3" />
  </bpmn:process>

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-06" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-06">
    <bpmn:participant id="Participant_P-06" name="2 Recrutar parceiros" processRef="Process_P-06" />
    <bpmn:participant id="Ext_P-06_X1" name="Empresa prospectada" />
    <bpmn:messageFlow id="P-06_M1" name="Abordagem" sourceRef="P-06_s2" targetRef="Ext_P-06_X1" />
    <bpmn:messageFlow id="P-06_M2" name="Resposta" sourceRef="Ext_P-06_X1" targetRef="P-06_e1" />
    <bpmn:messageFlow id="P-06_M3" name="Minuta do termo" sourceRef="P-06_s5" targetRef="Ext_P-06_X1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-06" name="2 Recrutar parceiros" isExecutable="false">
    <bpmn:documentation>Levar uma empresa que atende ao IPP do primeiro contato ao termo assinado. [status do fluxo: Declarado; evidências: EV-0038, EV-0055, EV-0090, EV-0091, EV-0074]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-06">
      <bpmn:lane id="Lane_P-06_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-06_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-06_s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-06_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-06_s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-06_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-06_s3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-06_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-06_s4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-06_s5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-06_f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-06_f2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-06_f3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-06_PA-02" name="Diretor">
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-06_i1" name="Empresa mapeada"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:outgoing>P-06_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:subProcess id="P-06_s1" name="Qualificar empresa mapeada"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-06_F1</bpmn:incoming><bpmn:outgoing>P-06_F2</bpmn:outgoing></bpmn:subProcess>
    <bpmn:exclusiveGateway id="P-06_g1" name="Empresa atende ao IPP?"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-06_F2</bpmn:incoming><bpmn:outgoing>P-06_F3</bpmn:outgoing><bpmn:outgoing>P-06_F4</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:subProcess id="P-06_s2" name="Abordar prospect"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-06_F3</bpmn:incoming><bpmn:outgoing>P-06_F5</bpmn:outgoing></bpmn:subProcess>
    <bpmn:intermediateCatchEvent id="P-06_e1" name="Resposta do prospect"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-06_F5</bpmn:incoming><bpmn:outgoing>P-06_F6</bpmn:outgoing><bpmn:messageEventDefinition id="P-06_e1_def" /></bpmn:intermediateCatchEvent>
    <bpmn:subProcess id="P-06_s3" name="Apresentar o programa em reunião"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-06_F6</bpmn:incoming><bpmn:incoming>P-06_F11</bpmn:incoming><bpmn:outgoing>P-06_F7</bpmn:outgoing></bpmn:subProcess>
    <bpmn:exclusiveGateway id="P-06_g2" name="Prospect quer seguir?"><bpmn:documentation>Os jeitos de terminar vêm do Playbook (perdas: não elegível, sem interesse); a pausa em nutrição vem da especificação 002. A ordem exata é dedução e está em pergunta.; status: Hipótese</bpmn:documentation><bpmn:incoming>P-06_F7</bpmn:incoming><bpmn:outgoing>P-06_F8</bpmn:outgoing><bpmn:outgoing>P-06_F9</bpmn:outgoing><bpmn:outgoing>P-06_F10</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:subProcess id="P-06_s4" name="Nutrir prospect"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-06_F10</bpmn:incoming><bpmn:outgoing>P-06_F11</bpmn:outgoing></bpmn:subProcess>
    <bpmn:subProcess id="P-06_s5" name="Formalizar a parceria"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-06_F8</bpmn:incoming><bpmn:outgoing>P-06_F12</bpmn:outgoing></bpmn:subProcess>
    <bpmn:endEvent id="P-06_f1" name="Empresa não elegível"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-06_F4</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-06_f2" name="Prospect sem interesse"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-06_F9</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-06_f3" name="Termo assinado"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-06_F12</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-06_F1" name="" sourceRef="P-06_i1" targetRef="P-06_s1" />

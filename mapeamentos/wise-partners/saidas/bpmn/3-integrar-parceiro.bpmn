<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-12" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-12">
    <bpmn:participant id="Participant_P-12" name="3 Integrar parceiro" processRef="Process_P-12" />
    <bpmn:participant id="Ext_P-12_X1" name="Empresa parceira" />
    <bpmn:messageFlow id="P-12_M1" name="Pedido de logo, cores e dados" sourceRef="P-12_t3" targetRef="Ext_P-12_X1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-12" name="3 Integrar parceiro" isExecutable="false">
    <bpmn:documentation>Do termo assinado até o parceiro começar a indicar. [status do fluxo: Contestado; evidências: EV-0042, EV-0072, EV-0073, EV-0071, EV-0055]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-12">
      <bpmn:lane id="Lane_P-12_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-12_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-12_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-12_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-12_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-12_s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-12_s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-12_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-12_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-12_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-12_f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-12_f2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-12_i1" name="Termo assinado"><bpmn:documentation>status: Contestado</bpmn:documentation><bpmn:outgoing>P-12_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P-12_t1" name="Mover a negociação para Onboarding"><bpmn:documentation>sistema: RD Station CRM (da Tríade); status: Contestado</bpmn:documentation><bpmn:incoming>P-12_F1</bpmn:incoming><bpmn:outgoing>P-12_F2</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P-12_t2" name="Criar o grupo de WhatsApp"><bpmn:documentation>sistema: WhatsApp (grupo com cada parceiro); status: Contestado</bpmn:documentation><bpmn:incoming>P-12_F2</bpmn:incoming><bpmn:outgoing>P-12_F3</bpmn:outgoing></bpmn:userTask>
    <bpmn:task id="P-12_t3" name="Solicitar logo, cores e dados cadastrais"><bpmn:documentation>status: Contestado</bpmn:documentation><bpmn:incoming>P-12_F3</bpmn:incoming><bpmn:outgoing>P-12_F4</bpmn:outgoing></bpmn:task>
    <bpmn:subProcess id="P-12_s1" name="Entregar o primeiro valor do pacote"><bpmn:documentation>status: Contestado</bpmn:documentation><bpmn:incoming>P-12_F4</bpmn:incoming><bpmn:outgoing>P-12_F5</bpmn:outgoing></bpmn:subProcess>
    <bpmn:subProcess id="P-12_s2" name="Conduzir o plano de 90 dias"><bpmn:documentation>status: Contestado</bpmn:documentation><bpmn:incoming>P-12_F5</bpmn:incoming><bpmn:outgoing>P-12_F6</bpmn:outgoing></bpmn:subProcess>
    <bpmn:exclusiveGateway id="P-12_g1" name="Parceiro ativado em 90 dias?"><bpmn:documentation>status: Contestado</bpmn:documentation><bpmn:incoming>P-12_F6</bpmn:incoming><bpmn:outgoing>P-12_F7</bpmn:outgoing><bpmn:outgoing>P-12_F8</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P-12_t4" name="Estender o plano até 120 dias"><bpmn:documentation>sistema: Portal Wise Partners; status: Contestado</bpmn:documentation><bpmn:incoming>P-12_F8</bpmn:incoming><bpmn:outgoing>P-12_F9</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P-12_g2" name="Parceiro ativado em 120 dias?"><bpmn:documentation>status: Contestado</bpmn:documentation><bpmn:incoming>P-12_F9</bpmn:incoming><bpmn:outgoing>P-12_F10</bpmn:outgoing><bpmn:outgoing>P-12_F11</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="P-12_f1" name="Parceiro ativado"><bpmn:documentation>status: Contestado</bpmn:documentation><bpmn:incoming>P-12_F7</bpmn:incoming><bpmn:incoming>P-12_F10</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-12_f2" name="Parceiro não ativado"><bpmn:documentation>status: Contestado</bpmn:documentation><bpmn:incoming>P-12_F11</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-12_F1" name="" sourceRef="P-12_i1" targetRef="P-12_t1" />
    <bpmn:sequenceFlow id="P-12_F2" name="" sourceRef="P-12_t1" targetRef="P-12_t2" />
    <bpmn:sequenceFlow id="P-12_F3" name="" sourceRef="P-12_t2" targetRef="P-12_t3" />
    <bpmn:sequenceFlow id="P-12_F4" name="" sourceRef="P-12_t3" targetRef="P-12_s1" />
    <bpmn:sequenceFlow id="P-12_F5" name="" sourceRef="P-12_s1" targetRef="P-12_s2" />
    <bpmn:sequenceFlow id="P-12_F6" name="" sourceRef="P-12_s2" targetRef="P-12_g1" />
    <bpmn:sequenceFlow id="P-12_F7" name="Sim" sourceRef="P-12_g1" targetRef="P-12_f1" />
    <bpmn:sequenceFlow id="P-12_F8" name="Não" sourceRef="P-12_g1" targetRef="P-12_t4" />
    <bpmn:sequenceFlow id="P-12_F9" name="" sourceRef="P-12_t4" targetRef="P-12_g2" />
    <bpmn:sequenceFlow id="P-12_F10" name="Sim" sourceRef="P-12_g2" targetRef="P-12_f1" />
    <bpmn:sequenceFlow id="P-12_F11" name="Não" sourceRef="P-12_g2" targetRef="P-12_f2" />
  </bpmn:process>

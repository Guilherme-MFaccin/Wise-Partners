  <bpmn:collaboration id="Collaboration_P-15">
    <bpmn:participant id="Participant_P-15" name="4 Conduzir o Base Ativa" processRef="Process_P-15" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-15" name="4 Conduzir o Base Ativa" isExecutable="false">
    <bpmn:documentation>Conduzir o parceiro de pacote A, em 12 semanas e 6 encontros, na transformação da carteira em comunidade, com evento no fim. [status do fluxo: Declarado; evidências: EV-0049, EV-0050, EV-0099, EV-0051, EV-0100, EV-0092, EV-0093, EV-0094, EV-0095, EV-0096, EV-0097, EV-0098]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-15">
      <bpmn:lane id="Lane_P-15_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-15_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-15_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-15_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-15_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-15_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-15_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-15_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-15_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-15_t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-15_t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-15_f1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-15_PA-06" name="Responsável nomeado no parceiro">
        <bpmn:flowNodeRef>P-15_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-15_t8</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-15_i1" name="Parceiro de pacote A assinado"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:outgoing>P-15_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:exclusiveGateway id="P-15_g1" name="Há horas disponíveis?"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-15_F1</bpmn:incoming><bpmn:outgoing>P-15_F2</bpmn:outgoing><bpmn:outgoing>P-15_F3</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="P-15_t1" name="Colocar o parceiro na fila com a data prevista"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-15_F3</bpmn:incoming><bpmn:outgoing>P-15_F4</bpmn:outgoing></bpmn:task>
    <bpmn:intermediateCatchEvent id="P-15_e1" name="Vez do parceiro na fila"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-15_F4</bpmn:incoming><bpmn:outgoing>P-15_F5</bpmn:outgoing><bpmn:timerEventDefinition id="P-15_e1_def" /></bpmn:intermediateCatchEvent>
    <bpmn:task id="P-15_t2" name="Diagnosticar a base do parceiro"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-15_F2</bpmn:incoming><bpmn:incoming>P-15_F5</bpmn:incoming><bpmn:outgoing>P-15_F6</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-15_t3" name="Categorizar a carteira"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-15_F6</bpmn:incoming><bpmn:outgoing>P-15_F7</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-15_t4" name="Definir estrutura e anúncio da comunidade"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-15_F7</bpmn:incoming><bpmn:outgoing>P-15_F8</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="P-15_t5" name="Definir oferta e nutrição"><bpmn:documentation>sistema: Wise Hub; status: Declarado</bpmn:documentation><bpmn:incoming>P-15_F8</bpmn:incoming><bpmn:outgoing>P-15_F9</bpmn:outgoing></bpmn:userTask>
    <bpmn:task id="P-15_t6" name="Planejar formação e evento"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-15_F9</bpmn:incoming><bpmn:outgoing>P-15_F10</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-15_t7" name="Preparar roteiro, divulgação e logística do evento"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-15_F10</bpmn:incoming><bpmn:outgoing>P-15_F11</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-15_t8" name="Promover o evento da comunidade"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-15_F11</bpmn:incoming><bpmn:outgoing>P-15_F12</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-15_t9" name="Emitir o certificado metodológico"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-15_F12</bpmn:incoming><bpmn:outgoing>P-15_F13</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="P-15_f1" name="Comunidade validada"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-15_F13</bpmn:incoming></bpmn:endEvent>

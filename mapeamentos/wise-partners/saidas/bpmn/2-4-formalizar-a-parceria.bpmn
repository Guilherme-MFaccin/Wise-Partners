<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-10" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-10">
    <bpmn:participant id="Participant_P-10" name="2.4 Formalizar a parceria" processRef="Process_P-10" />
    <bpmn:participant id="Ext_P-10_X1" name="Empresa prospectada" />
    <bpmn:messageFlow id="P-10_M1" name="Minuta do termo" sourceRef="P-10_t1" targetRef="Ext_P-10_X1" />
    <bpmn:messageFlow id="P-10_M2" name="Termo para assinatura" sourceRef="P-10_t4" targetRef="Ext_P-10_X1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-10" name="2.4 Formalizar a parceria" isExecutable="false">
    <bpmn:documentation>Enviar a minuta do termo, obter a aprovação do Diretor e colher a assinatura. [status do fluxo: Declarado; evidências: EV-0041, EV-0091]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-10">
      <bpmn:lane id="Lane_P-10_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-10_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-10_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-10_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-10_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-10_f1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-10_PA-02" name="Diretor">
        <bpmn:flowNodeRef>P-10_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-10_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-10_f2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-10_i1" name="Próximo passo combinado na reunião"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:outgoing>P-10_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="P-10_t1" name="Enviar a minuta do termo"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-10_F1</bpmn:incoming><bpmn:outgoing>P-10_F2</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-10_t2" name="Aprovar a assinatura"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-10_F2</bpmn:incoming><bpmn:outgoing>P-10_F3</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="P-10_g1" name="Assinatura aprovada?"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-10_F3</bpmn:incoming><bpmn:outgoing>P-10_F4</bpmn:outgoing><bpmn:outgoing>P-10_F5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P-10_t3" name="Registrar o ok na negociação"><bpmn:documentation>sistema: RD Station CRM (da Tríade); status: Declarado</bpmn:documentation><bpmn:incoming>P-10_F4</bpmn:incoming><bpmn:outgoing>P-10_F6</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P-10_t4" name="Coletar a assinatura digital"><bpmn:documentation>sistema: Autentique; status: Declarado</bpmn:documentation><bpmn:incoming>P-10_F6</bpmn:incoming><bpmn:outgoing>P-10_F7</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P-10_f1" name="Termo assinado"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-10_F7</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-10_f2" name="Assinatura não aprovada"><bpmn:documentation>O Playbook não diz o que acontece quando a assinatura não é aprovada; está em pergunta ao Igor.; status: Hipótese</bpmn:documentation><bpmn:incoming>P-10_F5</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-10_F1" name="" sourceRef="P-10_i1" targetRef="P-10_t1" />
    <bpmn:sequenceFlow id="P-10_F2" name="" sourceRef="P-10_t1" targetRef="P-10_t2" />
    <bpmn:sequenceFlow id="P-10_F3" name="" sourceRef="P-10_t2" targetRef="P-10_g1" />
    <bpmn:sequenceFlow id="P-10_F4" name="Sim" sourceRef="P-10_g1" targetRef="P-10_t3" />
    <bpmn:sequenceFlow id="P-10_F5" name="Não" sourceRef="P-10_g1" targetRef="P-10_f2" />
    <bpmn:sequenceFlow id="P-10_F6" name="" sourceRef="P-10_t3" targetRef="P-10_t4" />
    <bpmn:sequenceFlow id="P-10_F7" name="" sourceRef="P-10_t4" targetRef="P-10_f1" />
  </bpmn:process>

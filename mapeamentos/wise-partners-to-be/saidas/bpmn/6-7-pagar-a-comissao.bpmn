    <bpmn:sequenceFlow id="P-38_F10" name="" sourceRef="P-38_t6" targetRef="P-38_t7" />
    <bpmn:sequenceFlow id="P-38_F11" name="" sourceRef="P-38_t7" targetRef="P-38_f2" />
  </bpmn:process>

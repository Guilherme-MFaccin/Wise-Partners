<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-38" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-38">
    <bpmn:participant id="Participant_P-38" name="6.7 Pagar a comissão" processRef="Process_P-38" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-38" name="6.7 Pagar a comissão" isExecutable="false">
    <bpmn:documentation>Regra única: calcular quando o cliente fecha, aguardar a compensação do primeiro pagamento, receber a nota e pagar. No portal: calcula e avisa o financeiro. [status do fluxo: Hipótese; evidências: nenhuma]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-38">
      <bpmn:lane id="Lane_P-38_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-38_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-38_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-38_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-38_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-38_t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-38_f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-38_f2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-38_PA-04" name="Financeiro">
        <bpmn:flowNodeRef>P-38_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-38_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-38_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-38_t6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-38_PA-05" name="Responsável nomeado no parceiro">
        <bpmn:flowNodeRef>P-38_t5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-38_i1" name="Cliente fechado com origem em parceiro"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-38_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="P-38_t1" name="Calcular a comissão prevista e avisar o parceiro"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-38_F1</bpmn:incoming><bpmn:outgoing>P-38_F2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="P-38_e1" name="Primeiro pagamento do cliente"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-38_F2</bpmn:incoming><bpmn:outgoing>P-38_F3</bpmn:outgoing></bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="P-38_g1" name="O pagamento compensou?"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-38_F3</bpmn:incoming><bpmn:outgoing>P-38_F4</bpmn:outgoing><bpmn:outgoing>P-38_F6</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="P-38_t2" name="Avisar o parceiro de que não haverá comissão"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Hipótese</bpmn:documentation><bpmn:incoming>P-38_F4</bpmn:incoming><bpmn:outgoing>P-38_F5</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-38_t3" name="Avisar o Gerente da compensação"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-38_F6</bpmn:incoming><bpmn:outgoing>P-38_F7</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-38_t4" name="Pedir a nota fiscal ao parceiro"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Hipótese</bpmn:documentation><bpmn:incoming>P-38_F7</bpmn:incoming><bpmn:outgoing>P-38_F8</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-38_t5" name="Emitir a nota fiscal"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-38_F8</bpmn:incoming><bpmn:outgoing>P-38_F9</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-38_t6" name="Pagar a comissão ao CNPJ do parceiro"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-38_F9</bpmn:incoming><bpmn:outgoing>P-38_F10</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="P-38_t7" name="Registrar o pagamento e avisar o parceiro"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-38_F10</bpmn:incoming><bpmn:outgoing>P-38_F11</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P-38_f1" name="Comissão cancelada"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-38_F5</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-38_f2" name="Comissão paga"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-38_F11</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-38_F1" name="" sourceRef="P-38_i1" targetRef="P-38_t1" />
    <bpmn:sequenceFlow id="P-38_F2" name="" sourceRef="P-38_t1" targetRef="P-38_e1" />
    <bpmn:sequenceFlow id="P-38_F3" name="" sourceRef="P-38_e1" targetRef="P-38_g1" />

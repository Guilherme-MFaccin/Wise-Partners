    <bpmn:sequenceFlow id="P-38_F5" name="" sourceRef="P-38_t2" targetRef="P-38_f1" />
    <bpmn:sequenceFlow id="P-38_F6" name="Sim" sourceRef="P-38_g1" targetRef="P-38_t3" />
    <bpmn:sequenceFlow id="P-38_F7" name="" sourceRef="P-38_t3" targetRef="P-38_t4" />
    <bpmn:sequenceFlow id="P-38_F8" name="" sourceRef="P-38_t4" targetRef="P-38_t5" />

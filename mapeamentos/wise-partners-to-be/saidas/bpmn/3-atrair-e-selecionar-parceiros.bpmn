        <bpmn:flowNodeRef>P-29_f2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-29_f3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-29_PA-02" name="Diretor">
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-29_i1" name="Candidato identificado"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:outgoing>P-29_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:subProcess id="P-29_s1" name="Manter a lista de candidatos"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-29_F1</bpmn:incoming><bpmn:outgoing>P-29_F2</bpmn:outgoing></bpmn:subProcess>
    <bpmn:userTask id="P-29_t1" name="Agendar a primeira reunião"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Declarado</bpmn:documentation><bpmn:incoming>P-29_F2</bpmn:incoming><bpmn:outgoing>P-29_F3</bpmn:outgoing></bpmn:userTask>
    <bpmn:intermediateCatchEvent id="P-29_e1" name="Resposta do candidato"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-29_F3</bpmn:incoming><bpmn:outgoing>P-29_F4</bpmn:outgoing><bpmn:messageEventDefinition id="P-29_e1_def" /></bpmn:intermediateCatchEvent>
    <bpmn:subProcess id="P-29_s2" name="Apresentar o programa e mapear interesses"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-29_F4</bpmn:incoming><bpmn:incoming>P-29_F12</bpmn:incoming><bpmn:outgoing>P-29_F5</bpmn:outgoing></bpmn:subProcess>
    <bpmn:subProcess id="P-29_s3" name="Qualificar candidato"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-29_F5</bpmn:incoming><bpmn:outgoing>P-29_F6</bpmn:outgoing></bpmn:subProcess>
    <bpmn:exclusiveGateway id="P-29_g1" name="Candidato elegível?"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-29_F6</bpmn:incoming><bpmn:outgoing>P-29_F7</bpmn:outgoing><bpmn:outgoing>P-29_F8</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="P-29_g2" name="Candidato quer seguir agora?"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-29_F7</bpmn:incoming><bpmn:outgoing>P-29_F9</bpmn:outgoing><bpmn:outgoing>P-29_F10</bpmn:outgoing><bpmn:outgoing>P-29_F11</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:subProcess id="P-29_s4" name="Nutrir candidato"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-29_F10</bpmn:incoming><bpmn:outgoing>P-29_F12</bpmn:outgoing></bpmn:subProcess>
    <bpmn:subProcess id="P-29_s5" name="Conduzir o workshop de alinhamento"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-29_F9</bpmn:incoming><bpmn:outgoing>P-29_F13</bpmn:outgoing></bpmn:subProcess>
    <bpmn:subProcess id="P-29_s6" name="Negociar e formalizar o termo"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-29_F13</bpmn:incoming><bpmn:outgoing>P-29_F14</bpmn:outgoing></bpmn:subProcess>
    <bpmn:endEvent id="P-29_f1" name="Candidato não elegível"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-29_F8</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-29_f2" name="Candidato sem interesse"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-29_F11</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-29_f3" name="Termo assinado"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-29_F14</bpmn:incoming></bpmn:endEvent>

  <bpmn:collaboration id="Collaboration_P-29">
    <bpmn:participant id="Participant_P-29" name="3 Atrair e selecionar parceiros" processRef="Process_P-29" />
    <bpmn:participant id="Ext_P-29_X1" name="Empresa candidata" />
    <bpmn:messageFlow id="P-29_M1" name="Convite para reunião" sourceRef="P-29_t1" targetRef="Ext_P-29_X1" />
    <bpmn:messageFlow id="P-29_M2" name="Resposta" sourceRef="Ext_P-29_X1" targetRef="P-29_e1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-29" name="3 Atrair e selecionar parceiros" isExecutable="false">
    <bpmn:documentation>Do candidato na lista ao termo assinado: consciência, educação, seleção e decisão de ingresso da jornada do parceiro. [status do fluxo: Declarado; evidências: EV-0112, EV-0186, EV-0114, EV-0124]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-29">
      <bpmn:lane id="Lane_P-29_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-29_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-29_s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-29_t1</bpmn:flowNodeRef>

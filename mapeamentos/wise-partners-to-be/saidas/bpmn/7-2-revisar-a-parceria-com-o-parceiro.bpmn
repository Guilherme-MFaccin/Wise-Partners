<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-43" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-43">
    <bpmn:participant id="Participant_P-43" name="7.2 Revisar a parceria com o parceiro" processRef="Process_P-43" />
    <bpmn:participant id="Ext_P-43_X1" name="Parceiro" />
    <bpmn:messageFlow id="P-43_M1" name="Pauta e resultados" sourceRef="P-43_t3" targetRef="Ext_P-43_X1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-43" name="7.2 Revisar a parceria com o parceiro" isExecutable="false">
    <bpmn:documentation>Revisão conjunta com pauta montada pelo portal; trimestral para todos os ativos e mensal para os destaques; o Diretor participa nas dos parceiros Elite. As ações nascem da ata. No portal: monta a pauta com os dados do parceiro e transforma a ata em ações. [status do fluxo: Confirmado; evidências: EV-0151, EV-0152, EV-0153]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-43">
      <bpmn:lane id="Lane_P-43_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-43_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-43_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-43_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-43_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-43_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-43_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-43_f1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-43_PA-02" name="Diretor">
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-43_i1" name="Data da revisão pela cadência"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:outgoing>P-43_F1</bpmn:outgoing><bpmn:timerEventDefinition id="P-43_i1_def" /></bpmn:startEvent>
    <bpmn:serviceTask id="P-43_t1" name="Montar a pauta com os dados do parceiro"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-43_F1</bpmn:incoming><bpmn:outgoing>P-43_F2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P-43_g1" name="Parceiro Elite?"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-43_F2</bpmn:incoming><bpmn:outgoing>P-43_F3</bpmn:outgoing><bpmn:outgoing>P-43_F4</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P-43_t2" name="Convidar o Diretor"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Confirmado</bpmn:documentation><bpmn:incoming>P-43_F3</bpmn:incoming><bpmn:outgoing>P-43_F5</bpmn:outgoing></bpmn:userTask>
    <bpmn:task id="P-43_t3" name="Conduzir a revisão com o parceiro"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-43_F4</bpmn:incoming><bpmn:incoming>P-43_F5</bpmn:incoming><bpmn:outgoing>P-43_F6</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="P-43_t4" name="Registrar a ata e as ações"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-43_F6</bpmn:incoming><bpmn:outgoing>P-43_F7</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P-43_f1" name="Plano do próximo período combinado"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-43_F7</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-43_F1" name="" sourceRef="P-43_i1" targetRef="P-43_t1" />
    <bpmn:sequenceFlow id="P-43_F2" name="" sourceRef="P-43_t1" targetRef="P-43_g1" />
    <bpmn:sequenceFlow id="P-43_F3" name="Sim" sourceRef="P-43_g1" targetRef="P-43_t2" />
    <bpmn:sequenceFlow id="P-43_F4" name="Não" sourceRef="P-43_g1" targetRef="P-43_t3" />
    <bpmn:sequenceFlow id="P-43_F5" name="" sourceRef="P-43_t2" targetRef="P-43_t3" />
    <bpmn:sequenceFlow id="P-43_F6" name="" sourceRef="P-43_t3" targetRef="P-43_t4" />
    <bpmn:sequenceFlow id="P-43_F7" name="" sourceRef="P-43_t4" targetRef="P-43_f1" />
  </bpmn:process>

      <bpmndi:BPMNShape id="P-80_f1_di" bpmnElement="P-80_f1" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="512" y="56" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="475" y="98" width="110" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>

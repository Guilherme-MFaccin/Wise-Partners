  <bpmn:collaboration id="Collaboration_P-80">
    <bpmn:participant id="Participant_P-80" name="6.2.2 Agradecer e confirmar ao parceiro" processRef="Process_P-80" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-80" name="6.2.2 Agradecer e confirmar ao parceiro" isExecutable="false">
    <bpmn:documentation>Confirmar o recebimento e agradecer na hora. No portal: envia a confirmação. [status do fluxo: Hipótese; evidências: nenhuma]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-80">
      <bpmn:lane id="Lane_P-80_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-80_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-80_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-80_f1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-80_i1" name="Oportunidade registrada"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-80_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="P-80_t1" name="Enviar a confirmação e o agradecimento ao parceiro"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-80_F1</bpmn:incoming><bpmn:outgoing>P-80_F2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="P-80_f1" name="Parceiro agradecido"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-80_F2</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-80_F1" name="" sourceRef="P-80_i1" targetRef="P-80_t1" />
    <bpmn:sequenceFlow id="P-80_F2" name="" sourceRef="P-80_t1" targetRef="P-80_f1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_P-80">
    <bpmndi:BPMNPlane id="BPMNPlane_P-80" bpmnElement="Collaboration_P-80">
      <bpmndi:BPMNShape id="Participant_P-80_di" bpmnElement="Participant_P-80" isHorizontal="true"><dc:Bounds x="0" y="0" width="648" height="148" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_P-80_PA-01_di" bpmnElement="Lane_P-80_PA-01" isHorizontal="true"><dc:Bounds x="30" y="0" width="618" height="148" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-80_i1_di" bpmnElement="P-80_i1" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="160" y="56" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="123" y="98" width="110" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-71" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-71">
    <bpmn:participant id="Participant_P-71" name="7 Reter ou encerrar a parceria" processRef="Process_P-71" />
    <bpmn:participant id="Ext_P-71_X1" name="Parceiro" />
    <bpmn:messageFlow id="P-71_M1" name="Convite com oportunidade" sourceRef="P-71_t1" targetRef="Ext_P-71_X1" />
    <bpmn:messageFlow id="P-71_M2" name="Aviso formal" sourceRef="P-71_t5" targetRef="Ext_P-71_X1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-71" name="7 Reter ou encerrar a parceria" isExecutable="false">
    <bpmn:documentation>Tratar parceiro em risco com retomada focada numa oportunidade concreta e, sem resposta, desligar de forma formal e amigável, passando o cliente sem atrito. [status do fluxo: Declarado; evidências: EV-0196, EV-0197, EV-0173, EV-0198]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-71">
      <bpmn:lane id="Lane_P-71_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-71_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-71_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-71_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-71_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-71_e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-71_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-71_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-71_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-71_e3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-71_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-71_f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-71_f2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-71_f3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-71_PA-02" name="Diretor">
        <bpmn:flowNodeRef>P-71_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-71_g2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-71_i1" name="Parceiro em risco"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:outgoing>P-71_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P-71_t1" name="Propor reunião com uma oportunidade concreta"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Hipótese</bpmn:documentation><bpmn:incoming>P-71_F1</bpmn:incoming><bpmn:outgoing>P-71_F2</bpmn:outgoing></bpmn:userTask>
    <bpmn:intermediateCatchEvent id="P-71_e1" name="15 dias"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-71_F2</bpmn:incoming><bpmn:outgoing>P-71_F3</bpmn:outgoing><bpmn:timerEventDefinition id="P-71_e1_def" /></bpmn:intermediateCatchEvent>
    <bpmn:task id="P-71_t2" name="Ligar para o parceiro na segunda tentativa"><bpmn:documentation>Conversa difícil por voz, não por texto.; status: Hipótese</bpmn:documentation><bpmn:incoming>P-71_F3</bpmn:incoming><bpmn:outgoing>P-71_F4</bpmn:outgoing></bpmn:task>
    <bpmn:intermediateCatchEvent id="P-71_e2" name="30 dias"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-71_F4</bpmn:incoming><bpmn:outgoing>P-71_F5</bpmn:outgoing><bpmn:timerEventDefinition id="P-71_e2_def" /></bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="P-71_g1" name="Parceiro voltou a ter atividade?"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-71_F5</bpmn:incoming><bpmn:outgoing>P-71_F6</bpmn:outgoing><bpmn:outgoing>P-71_F7</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P-71_t3" name="Sugerir o desligamento"><bpmn:documentation>sistema: Portal Wise Partners; status: Declarado</bpmn:documentation><bpmn:incoming>P-71_F7</bpmn:incoming><bpmn:outgoing>P-71_F8</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P-71_t4" name="Responder sim ou não ao desligamento"><bpmn:documentation>sistema: Portal Wise Partners; status: Declarado</bpmn:documentation><bpmn:incoming>P-71_F8</bpmn:incoming><bpmn:outgoing>P-71_F9</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P-71_g2" name="Desligamento aprovado?"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-71_F9</bpmn:incoming><bpmn:outgoing>P-71_F10</bpmn:outgoing><bpmn:outgoing>P-71_F11</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="P-71_t5" name="Comunicar o encerramento em conversa e por escrito"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-71_F11</bpmn:incoming><bpmn:outgoing>P-71_F12</bpmn:outgoing></bpmn:task>
    <bpmn:intermediateCatchEvent id="P-71_e3" name="30 dias de aviso"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-71_F12</bpmn:incoming><bpmn:outgoing>P-71_F13</bpmn:outgoing><bpmn:timerEventDefinition id="P-71_e3_def" /></bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="P-71_t6" name="Encerrar a parceria e revogar acessos"><bpmn:documentation>sistema: Portal Wise Partners; status: Declarado</bpmn:documentation><bpmn:incoming>P-71_F13</bpmn:incoming><bpmn:outgoing>P-71_F14</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="P-71_f1" name="Parceiro retomado"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-71_F6</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-71_f2" name="Parceiro mantido"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-71_F10</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-71_f3" name="Parceria encerrada"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-71_F14</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-71_F1" name="" sourceRef="P-71_i1" targetRef="P-71_t1" />

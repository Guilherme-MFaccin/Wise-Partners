<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-104" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-104">
    <bpmn:participant id="Participant_P-104" name="10.4 Validar as ofertas do catálogo" processRef="Process_P-104" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-104" name="10.4 Validar as ofertas do catálogo" isExecutable="false">
    <bpmn:documentation>A Wise confere cada oferta (o que é, para quem serve e a condição para membros) antes de publicar. Oferta publicada que muda de texto volta para validação. [status do fluxo: Declarado; evidências: EV-0454]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-104">
      <bpmn:lane id="Lane_P-104_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-104_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-104_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-104_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-104_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-104_f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-104_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-104_f2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-104_i1" name="Oferta enviada para validação"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:outgoing>P-104_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="P-104_t1" name="Ler a oferta e a condição para membros"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-104_F1</bpmn:incoming><bpmn:outgoing>P-104_F2</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="P-104_g1" name="A oferta está clara e tem condição só para membros?"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-104_F2</bpmn:incoming><bpmn:outgoing>P-104_F3</bpmn:outgoing><bpmn:outgoing>P-104_F5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P-104_t2" name="Publicar a oferta"><bpmn:documentation>sistema: Portal Wise Partners; status: Declarado</bpmn:documentation><bpmn:incoming>P-104_F3</bpmn:incoming><bpmn:outgoing>P-104_F4</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P-104_f1" name="Oferta publicada"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-104_F4</bpmn:incoming></bpmn:endEvent>
    <bpmn:userTask id="P-104_t3" name="Recusar com o motivo"><bpmn:documentation>sistema: Portal Wise Partners; status: Declarado</bpmn:documentation><bpmn:incoming>P-104_F5</bpmn:incoming><bpmn:outgoing>P-104_F6</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P-104_f2" name="Oferta devolvida para ajuste"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-104_F6</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-104_F1" name="" sourceRef="P-104_i1" targetRef="P-104_t1" />
    <bpmn:sequenceFlow id="P-104_F2" name="" sourceRef="P-104_t1" targetRef="P-104_g1" />
    <bpmn:sequenceFlow id="P-104_F3" name="Sim" sourceRef="P-104_g1" targetRef="P-104_t2" />
    <bpmn:sequenceFlow id="P-104_F4" name="" sourceRef="P-104_t2" targetRef="P-104_f1" />
    <bpmn:sequenceFlow id="P-104_F5" name="Não" sourceRef="P-104_g1" targetRef="P-104_t3" />
    <bpmn:sequenceFlow id="P-104_F6" name="" sourceRef="P-104_t3" targetRef="P-104_f2" />
  </bpmn:process>

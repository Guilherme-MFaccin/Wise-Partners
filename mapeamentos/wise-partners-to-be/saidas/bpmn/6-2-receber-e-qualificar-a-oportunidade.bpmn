<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-32" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-32">
    <bpmn:participant id="Participant_P-32" name="6.2 Receber e qualificar a oportunidade" processRef="Process_P-32" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-32" name="6.2 Receber e qualificar a oportunidade" isExecutable="false">
    <bpmn:documentation>Registrar com a porta de origem, agradecer e confirmar ao parceiro, validar duplicidade, ICP e proteção. No portal: registra pelo link, pelo cruzamento ou à mão, envia a confirmação e calcula a nota de qualidade. [status do fluxo: Hipótese; evidências: nenhuma]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-32">
      <bpmn:lane id="Lane_P-32_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-32_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-32_s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-32_s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-32_s3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-32_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-32_f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-32_f2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-32_i1" name="Oportunidade chega por uma das portas"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-32_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:subProcess id="P-32_s1" name="Registrar a oportunidade com a porta de origem"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-32_F1</bpmn:incoming><bpmn:outgoing>P-32_F2</bpmn:outgoing></bpmn:subProcess>
    <bpmn:subProcess id="P-32_s2" name="Agradecer e confirmar ao parceiro"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-32_F2</bpmn:incoming><bpmn:outgoing>P-32_F3</bpmn:outgoing></bpmn:subProcess>
    <bpmn:subProcess id="P-32_s3" name="Validar duplicidade e ICP"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-32_F3</bpmn:incoming><bpmn:outgoing>P-32_F4</bpmn:outgoing></bpmn:subProcess>
    <bpmn:exclusiveGateway id="P-32_g1" name="A oportunidade é válida?"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-32_F4</bpmn:incoming><bpmn:outgoing>P-32_F5</bpmn:outgoing><bpmn:outgoing>P-32_F6</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="P-32_f1" name="Oportunidade recusada"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-32_F5</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-32_f2" name="Oportunidade qualificada"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-32_F6</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-32_F1" name="" sourceRef="P-32_i1" targetRef="P-32_s1" />
    <bpmn:sequenceFlow id="P-32_F2" name="" sourceRef="P-32_s1" targetRef="P-32_s2" />
    <bpmn:sequenceFlow id="P-32_F3" name="" sourceRef="P-32_s2" targetRef="P-32_s3" />
    <bpmn:sequenceFlow id="P-32_F4" name="" sourceRef="P-32_s3" targetRef="P-32_g1" />
    <bpmn:sequenceFlow id="P-32_F5" name="Não" sourceRef="P-32_g1" targetRef="P-32_f1" />
    <bpmn:sequenceFlow id="P-32_F6" name="Sim" sourceRef="P-32_g1" targetRef="P-32_f2" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_P-32">
    <bpmndi:BPMNPlane id="BPMNPlane_P-32" bpmnElement="Collaboration_P-32">
      <bpmndi:BPMNShape id="Participant_P-32_di" bpmnElement="Participant_P-32" isHorizontal="true"><dc:Bounds x="0" y="0" width="1176" height="252" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_P-32_PA-01_di" bpmnElement="Lane_P-32_PA-01" isHorizontal="true"><dc:Bounds x="30" y="0" width="1146" height="252" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-32_i1_di" bpmnElement="P-32_i1" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="160" y="56" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="123" y="98" width="110" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-32_s1_di" bpmnElement="P-32_s1" isExpanded="false" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="290" y="38" width="128" height="72" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-32_s2_di" bpmnElement="P-32_s2" isExpanded="false" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="466" y="38" width="128" height="72" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-32_s3_di" bpmnElement="P-32_s3" isExpanded="false" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="642" y="38" width="128" height="72" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-32_g1_di" bpmnElement="P-32_g1" isMarkerVisible="true" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="857" y="49" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="827" y="15" width="110" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-32_f1_di" bpmnElement="P-32_f1" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="1040" y="56" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1003" y="98" width="110" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-32_f2_di" bpmnElement="P-32_f2" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="1040" y="160" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1003" y="202" width="110" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P-32_F1_di" bpmnElement="P-32_F1"><di:waypoint x="196" y="74" /><di:waypoint x="290" y="74" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-32_F2_di" bpmnElement="P-32_F2"><di:waypoint x="418" y="74" /><di:waypoint x="466" y="74" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-32_F3_di" bpmnElement="P-32_F3"><di:waypoint x="594" y="74" /><di:waypoint x="642" y="74" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-32_F4_di" bpmnElement="P-32_F4"><di:waypoint x="770" y="74" /><di:waypoint x="857" y="74" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-32_F5_di" bpmnElement="P-32_F5"><di:waypoint x="907" y="74" /><di:waypoint x="1040" y="74" /><bpmndi:BPMNLabel><dc:Bounds x="913" y="54" width="30" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-32_F6_di" bpmnElement="P-32_F6"><di:waypoint x="882" y="99" /><di:waypoint x="882" y="178" /><di:waypoint x="1040" y="178" /><bpmndi:BPMNLabel><dc:Bounds x="890" y="158" width="30" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-35" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-35">
    <bpmn:participant id="Participant_P-35" name="6.4 Atender necessidade do cliente pela Prateleira" processRef="Process_P-35" />
    <bpmn:participant id="Ext_P-35_X1" name="Parceiro" />
    <bpmn:participant id="Ext_P-35_X2" name="Cliente industrial" />
    <bpmn:messageFlow id="P-35_M1" name="Pedido de contrapartida" sourceRef="P-35_t4" targetRef="Ext_P-35_X1" />
    <bpmn:messageFlow id="P-35_M2" name="Clique em falar com o parceiro" sourceRef="Ext_P-35_X2" targetRef="P-35_e1" />
    <bpmn:messageFlow id="P-35_M3" name="Aviso de contato" sourceRef="P-35_t6" targetRef="Ext_P-35_X1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-35" name="6.4 Atender necessidade do cliente pela Prateleira" isExecutable="false">
    <bpmn:documentation>O consultor relata a necessidade, o Gerente registra o pedido e publica a página do cliente; o fornecedor que entra no pedido dá uma contrapartida não financeira. No portal: recomenda parceiros por categoria, monta a página e registra a contrapartida combinada. [status do fluxo: Confirmado; evidências: EV-0213, EV-0021]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-35">
      <bpmn:lane id="Lane_P-35_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-35_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-35_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-35_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-35_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-35_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-35_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-35_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-35_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-35_f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-35_f2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-35_PA-03" name="Closer da empresa do grupo">
        <bpmn:flowNodeRef>P-35_i1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-35_i1" name="Consultor relata a necessidade do cliente"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:outgoing>P-35_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P-35_t1" name="Registrar o pedido do cliente"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-35_F1</bpmn:incoming><bpmn:outgoing>P-35_F2</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P-35_t2" name="Recomendar parceiros por categoria"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-35_F2</bpmn:incoming><bpmn:outgoing>P-35_F3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P-35_g1" name="Há parceiros assinados na categoria?"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-35_F3</bpmn:incoming><bpmn:outgoing>P-35_F4</bpmn:outgoing><bpmn:outgoing>P-35_F5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P-35_t3" name="Registrar a categoria a prospectar"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-35_F5</bpmn:incoming><bpmn:outgoing>P-35_F6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P-35_t4" name="Combinar a contrapartida com cada fornecedor"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Confirmado</bpmn:documentation><bpmn:incoming>P-35_F4</bpmn:incoming><bpmn:outgoing>P-35_F7</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P-35_t5" name="Publicar a página do cliente"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-35_F7</bpmn:incoming><bpmn:outgoing>P-35_F8</bpmn:outgoing></bpmn:userTask>
    <bpmn:intermediateCatchEvent id="P-35_e1" name="Cliente escolhe falar com um parceiro"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-35_F8</bpmn:incoming><bpmn:outgoing>P-35_F9</bpmn:outgoing><bpmn:messageEventDefinition id="P-35_e1_def" /></bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="P-35_t6" name="Avisar o consultor e o parceiro"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-35_F9</bpmn:incoming><bpmn:outgoing>P-35_F10</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="P-35_f1" name="Categoria sem fornecedor"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-35_F6</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-35_f2" name="Cliente em contato com o parceiro"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-35_F10</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-35_F1" name="" sourceRef="P-35_i1" targetRef="P-35_t1" />
    <bpmn:sequenceFlow id="P-35_F2" name="" sourceRef="P-35_t1" targetRef="P-35_t2" />
    <bpmn:sequenceFlow id="P-35_F3" name="" sourceRef="P-35_t2" targetRef="P-35_g1" />
    <bpmn:sequenceFlow id="P-35_F4" name="Sim" sourceRef="P-35_g1" targetRef="P-35_t4" />
    <bpmn:sequenceFlow id="P-35_F5" name="Não" sourceRef="P-35_g1" targetRef="P-35_t3" />
    <bpmn:sequenceFlow id="P-35_F6" name="" sourceRef="P-35_t3" targetRef="P-35_f1" />
    <bpmn:sequenceFlow id="P-35_F7" name="" sourceRef="P-35_t4" targetRef="P-35_t5" />
    <bpmn:sequenceFlow id="P-35_F8" name="" sourceRef="P-35_t5" targetRef="P-35_e1" />
    <bpmn:sequenceFlow id="P-35_F9" name="" sourceRef="P-35_e1" targetRef="P-35_t6" />
    <bpmn:sequenceFlow id="P-35_F10" name="" sourceRef="P-35_t6" targetRef="P-35_f2" />
  </bpmn:process>

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-31" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-31">
    <bpmn:participant id="Participant_P-31" name="6 Gerar oportunidades no ecossistema" processRef="Process_P-31" />
    <bpmn:participant id="Ext_P-31_X1" name="Parceiro" />
    <bpmn:messageFlow id="P-31_M1" name="Indicação, pedido ou jogada" sourceRef="Ext_P-31_X1" targetRef="P-31_i1" />
    <bpmn:messageFlow id="P-31_M2" name="Motivo" sourceRef="P-31_t1" targetRef="Ext_P-31_X1" />
    <bpmn:messageFlow id="P-31_M3" name="Retorno a cada etapa" sourceRef="P-31_s3" targetRef="Ext_P-31_X1" />
    <bpmn:messageFlow id="P-31_M4" name="Comissão" sourceRef="P-31_s4" targetRef="Ext_P-31_X1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-31" name="6 Gerar oportunidades no ecossistema" isExecutable="false">
    <bpmn:documentation>A interação central: cada oportunidade compartilhada percorre uma esteira única até o cliente fechado, a comissão paga e a checagem do cliente. No portal: um card por oportunidade, com a porta como etiqueta; registra cada etapa e prepara a mensagem de retorno ao parceiro. [status do fluxo: Confirmado; evidências: EV-0044, EV-0009, EV-0045, EV-0065, EV-0229]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-31">
      <bpmn:lane id="Lane_P-31_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-31_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-31_s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-31_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-31_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-31_s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-31_s3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-31_s5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-31_f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-31_f2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-31_f3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-31_PA-03" name="Closer da empresa do grupo">
        <bpmn:flowNodeRef>P-31_g2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-31_PA-04" name="Financeiro">
        <bpmn:flowNodeRef>P-31_s4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-31_i1" name="Oportunidade chega por uma das portas"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:outgoing>P-31_F1</bpmn:outgoing><bpmn:messageEventDefinition id="P-31_i1_def" /></bpmn:startEvent>
    <bpmn:subProcess id="P-31_s1" name="Receber e qualificar a oportunidade"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-31_F1</bpmn:incoming><bpmn:outgoing>P-31_F2</bpmn:outgoing></bpmn:subProcess>
    <bpmn:exclusiveGateway id="P-31_g1" name="Oportunidade válida?"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-31_F2</bpmn:incoming><bpmn:outgoing>P-31_F3</bpmn:outgoing><bpmn:outgoing>P-31_F5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P-31_t1" name="Explicar o motivo ao parceiro"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Confirmado</bpmn:documentation><bpmn:incoming>P-31_F3</bpmn:incoming><bpmn:outgoing>P-31_F4</bpmn:outgoing></bpmn:userTask>
    <bpmn:subProcess id="P-31_s2" name="Entregar o lead ao closer"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-31_F5</bpmn:incoming><bpmn:outgoing>P-31_F6</bpmn:outgoing></bpmn:subProcess>
    <bpmn:subProcess id="P-31_s3" name="Fechar o ciclo com o parceiro"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-31_F6</bpmn:incoming><bpmn:outgoing>P-31_F7</bpmn:outgoing></bpmn:subProcess>
    <bpmn:exclusiveGateway id="P-31_g2" name="Cliente fechou?"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-31_F7</bpmn:incoming><bpmn:outgoing>P-31_F8</bpmn:outgoing><bpmn:outgoing>P-31_F11</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:subProcess id="P-31_s4" name="Pagar a comissão"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-31_F8</bpmn:incoming><bpmn:outgoing>P-31_F9</bpmn:outgoing></bpmn:subProcess>
    <bpmn:subProcess id="P-31_s5" name="Checar o cliente aos 6 e 12 meses"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-31_F9</bpmn:incoming><bpmn:outgoing>P-31_F10</bpmn:outgoing></bpmn:subProcess>
    <bpmn:endEvent id="P-31_f1" name="Oportunidade recusada"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-31_F4</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-31_f2" name="Cliente fechado, comissão paga e checado"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-31_F10</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-31_f3" name="Oportunidade perdida"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-31_F11</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-31_F1" name="" sourceRef="P-31_i1" targetRef="P-31_s1" />
    <bpmn:sequenceFlow id="P-31_F2" name="" sourceRef="P-31_s1" targetRef="P-31_g1" />
    <bpmn:sequenceFlow id="P-31_F3" name="Não" sourceRef="P-31_g1" targetRef="P-31_t1" />
    <bpmn:sequenceFlow id="P-31_F4" name="" sourceRef="P-31_t1" targetRef="P-31_f1" />
    <bpmn:sequenceFlow id="P-31_F5" name="Sim" sourceRef="P-31_g1" targetRef="P-31_s2" />
    <bpmn:sequenceFlow id="P-31_F6" name="" sourceRef="P-31_s2" targetRef="P-31_s3" />
    <bpmn:sequenceFlow id="P-31_F7" name="" sourceRef="P-31_s3" targetRef="P-31_g2" />
    <bpmn:sequenceFlow id="P-31_F8" name="Sim" sourceRef="P-31_g2" targetRef="P-31_s4" />
    <bpmn:sequenceFlow id="P-31_F9" name="" sourceRef="P-31_s4" targetRef="P-31_s5" />
    <bpmn:sequenceFlow id="P-31_F10" name="" sourceRef="P-31_s5" targetRef="P-31_f2" />
    <bpmn:sequenceFlow id="P-31_F11" name="Não" sourceRef="P-31_g2" targetRef="P-31_f3" />
  </bpmn:process>

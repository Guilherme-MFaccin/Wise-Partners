      <bpmndi:BPMNShape id="P-64_f1_di" bpmnElement="P-64_f1" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="1040" y="156" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1003" y="198" width="110" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>

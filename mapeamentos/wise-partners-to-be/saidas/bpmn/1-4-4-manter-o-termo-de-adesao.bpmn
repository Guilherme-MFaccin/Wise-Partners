      <bpmndi:BPMNShape id="Lane_P-64_PA-02_di" bpmnElement="Lane_P-64_PA-02" isHorizontal="true"><dc:Bounds x="30" y="248" width="1146" height="148" /></bpmndi:BPMNShape>

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-35" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-35">
    <bpmn:participant id="Participant_P-35" name="6.5 Recomendar parceiros ao cliente pela Prateleira" processRef="Process_P-35" />
    <bpmn:participant id="Ext_P-35_X3" name="Cliente da Wise" />
    <bpmn:messageFlow id="P-35_M1" name="Página com os recomendados" sourceRef="P-35_t5" targetRef="Ext_P-35_X3" />
    <bpmn:messageFlow id="P-35_M2" name="Escolha do parceiro" sourceRef="Ext_P-35_X3" targetRef="P-35_e1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-35" name="6.5 Recomendar parceiros ao cliente pela Prateleira" isExecutable="false">
    <bpmn:documentation>O consultor relata a necessidade, o Gerente registra o pedido e publica a página do cliente com os parceiros Premium e Elite da categoria, sem recomendação suspensa; cada parceiro que entra no pedido dá uma contrapartida não financeira. Quando o consultor já sabe quem resolve, a página pode ter um parceiro só. Trinta dias depois, o Gerente pergunta ao cliente e ao parceiro como foi. No portal: lista os parceiros Premium e Elite por categoria, monta a página, registra a contrapartida combinada e o retorno do cliente. [status do fluxo: Hipótese; evidências: nenhuma]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-35">
      <bpmn:lane id="Lane_P-35_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-35_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-35_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-35_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-35_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-35_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-35_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-35_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-35_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-35_e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-35_t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-35_f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-35_f2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-35_PA-07" name="Consultor da Wise Makers">
        <bpmn:flowNodeRef>P-35_i1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-35_i1" name="Consultor relata a necessidade do cliente"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-35_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P-35_t1" name="Registrar o pedido do cliente"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-35_F1</bpmn:incoming><bpmn:outgoing>P-35_F2</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P-35_t2" name="Listar os parceiros Premium e Elite da categoria"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-35_F2</bpmn:incoming><bpmn:outgoing>P-35_F3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P-35_g1" name="Há parceiro recomendável na categoria?"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-35_F3</bpmn:incoming><bpmn:outgoing>P-35_F4</bpmn:outgoing><bpmn:outgoing>P-35_F6</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P-35_t3" name="Registrar a categoria a buscar"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-35_F4</bpmn:incoming><bpmn:outgoing>P-35_F5</bpmn:outgoing></bpmn:userTask>
    <bpmn:task id="P-35_t4" name="Combinar a contrapartida com cada parceiro"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Hipótese</bpmn:documentation><bpmn:incoming>P-35_F6</bpmn:incoming><bpmn:outgoing>P-35_F7</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="P-35_t5" name="Publicar a página do cliente com os recomendados"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-35_F7</bpmn:incoming><bpmn:outgoing>P-35_F8</bpmn:outgoing></bpmn:userTask>
    <bpmn:intermediateCatchEvent id="P-35_e1" name="Cliente escolhe falar com um parceiro"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-35_F8</bpmn:incoming><bpmn:outgoing>P-35_F9</bpmn:outgoing><bpmn:messageEventDefinition id="P-35_e1_def" /></bpmn:intermediateCatchEvent>
    <bpmn:task id="P-35_t6" name="Avisar o consultor e o parceiro"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Hipótese</bpmn:documentation><bpmn:incoming>P-35_F9</bpmn:incoming><bpmn:outgoing>P-35_F10</bpmn:outgoing></bpmn:task>
    <bpmn:intermediateCatchEvent id="P-35_e2" name="30 dias"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-35_F10</bpmn:incoming><bpmn:outgoing>P-35_F11</bpmn:outgoing><bpmn:timerEventDefinition id="P-35_e2_def" /></bpmn:intermediateCatchEvent>
    <bpmn:task id="P-35_t7" name="Perguntar ao cliente e ao parceiro como foi e registrar"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-35_F11</bpmn:incoming><bpmn:outgoing>P-35_F12</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="P-35_f1" name="Categoria sem parceiro recomendável"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-35_F5</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-35_f2" name="Recomendação feita e avaliada"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-35_F12</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-35_F1" name="" sourceRef="P-35_i1" targetRef="P-35_t1" />
    <bpmn:sequenceFlow id="P-35_F2" name="" sourceRef="P-35_t1" targetRef="P-35_t2" />
    <bpmn:sequenceFlow id="P-35_F3" name="" sourceRef="P-35_t2" targetRef="P-35_g1" />
    <bpmn:sequenceFlow id="P-35_F4" name="Não" sourceRef="P-35_g1" targetRef="P-35_t3" />
    <bpmn:sequenceFlow id="P-35_F5" name="" sourceRef="P-35_t3" targetRef="P-35_f1" />
    <bpmn:sequenceFlow id="P-35_F6" name="Sim" sourceRef="P-35_g1" targetRef="P-35_t4" />
    <bpmn:sequenceFlow id="P-35_F7" name="" sourceRef="P-35_t4" targetRef="P-35_t5" />
    <bpmn:sequenceFlow id="P-35_F8" name="" sourceRef="P-35_t5" targetRef="P-35_e1" />
    <bpmn:sequenceFlow id="P-35_F9" name="" sourceRef="P-35_e1" targetRef="P-35_t6" />
    <bpmn:sequenceFlow id="P-35_F10" name="" sourceRef="P-35_t6" targetRef="P-35_e2" />
    <bpmn:sequenceFlow id="P-35_F11" name="" sourceRef="P-35_e2" targetRef="P-35_t7" />
    <bpmn:sequenceFlow id="P-35_F12" name="" sourceRef="P-35_t7" targetRef="P-35_f2" />
  </bpmn:process>

  <bpmn:collaboration id="Collaboration_P-83">
    <bpmn:participant id="Participant_P-83" name="8.2.2 Conduzir o encontro trimestral de parceiros" processRef="Process_P-83" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-83" name="8.2.2 Conduzir o encontro trimestral de parceiros" isExecutable="false">
    <bpmn:documentation>Encontro online de todos os parceiros, com casos, resultados do trimestre e reconhecimento, aberto por uma mensagem gravada do Igor como voz do programa. A gravação e o resumo vão para quem não foi. No portal: agenda, convida, lembra o Igor de gravar a mensagem, registra a presença e envia a gravação. [status do fluxo: Hipótese; evidências: nenhuma]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-83">
      <bpmn:lane id="Lane_P-83_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-83_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-83_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-83_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-83_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-83_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-83_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-83_f1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-83_PA-02" name="Diretor">
        <bpmn:flowNodeRef>P-83_t2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-83_i1" name="Trimestre fechado"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-83_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="P-83_t1" name="Agendar o encontro e convidar todos os parceiros"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-83_F1</bpmn:incoming><bpmn:outgoing>P-83_F2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:task id="P-83_t2" name="Gravar a mensagem de abertura"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-83_F2</bpmn:incoming><bpmn:outgoing>P-83_F3</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-83_t3" name="Escolher os casos e os reconhecimentos do trimestre"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-83_F3</bpmn:incoming><bpmn:outgoing>P-83_F4</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-83_t4" name="Conduzir o encontro online"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-83_F4</bpmn:incoming><bpmn:outgoing>P-83_F5</bpmn:outgoing></bpmn:task>
    <bpmn:serviceTask id="P-83_t5" name="Registrar a presença"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-83_F5</bpmn:incoming><bpmn:outgoing>P-83_F6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P-83_t6" name="Enviar a gravação e o resumo a todos os parceiros"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-83_F6</bpmn:incoming><bpmn:outgoing>P-83_F7</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="P-83_f1" name="Encontro trimestral realizado"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-83_F7</bpmn:incoming></bpmn:endEvent>

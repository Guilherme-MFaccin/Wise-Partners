    <bpmn:sequenceFlow id="P-45_F8" name="" sourceRef="P-45_s2" targetRef="P-45_t3" />
    <bpmn:sequenceFlow id="P-45_F9" name="" sourceRef="P-45_t3" targetRef="P-45_t4" />
    <bpmn:sequenceFlow id="P-45_F10" name="" sourceRef="P-45_t4" targetRef="P-45_f1" />
  </bpmn:process>

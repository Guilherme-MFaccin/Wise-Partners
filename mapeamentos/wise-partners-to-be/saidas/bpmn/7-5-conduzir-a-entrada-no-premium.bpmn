<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-45" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-45">
    <bpmn:participant id="Participant_P-45" name="7.5 Conduzir a entrada no Premium" processRef="Process_P-45" />
    <bpmn:participant id="Ext_P-45_X1" name="Parceiro" />
    <bpmn:messageFlow id="P-45_M1" name="Resposta ao convite" sourceRef="Ext_P-45_X1" targetRef="P-45_e0" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-45" name="7.5 Conduzir a entrada no Premium" isExecutable="false">
    <bpmn:documentation>O Premium é o nível em que a Wise passa a recomendar o parceiro aos próprios clientes, e por isso começa pelo encontro de alinhamento. Depois dele, o parceiro sobe, tem o perfil revisado para as recomendações e a Prateleira, os consultores da Wise ficam sabendo que podem recomendá-lo e o novo nível é anunciado. No portal: registra a subida, publica a ficha na Prateleira e avisa os dois lados. [status do fluxo: Hipótese; evidências: nenhuma]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-45">
      <bpmn:lane id="Lane_P-45_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-45_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-45_e0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-45_g0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-45_s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-45_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-45_s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-45_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-45_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-45_f0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-45_f1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-45_PA-05" name="Responsável nomeado no parceiro">
        <bpmn:flowNodeRef>P-45_t2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-45_i1" name="Parceiro convidado para o Premium"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-45_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="P-45_e0" name="Resposta do parceiro ao convite"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-45_F1</bpmn:incoming><bpmn:outgoing>P-45_F2</bpmn:outgoing><bpmn:messageEventDefinition id="P-45_e0_def" /></bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="P-45_g0" name="O parceiro aceitou o convite?"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-45_F2</bpmn:incoming><bpmn:outgoing>P-45_F3</bpmn:outgoing><bpmn:outgoing>P-45_F4</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:subProcess id="P-45_s1" name="Conduzir o encontro de alinhamento"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-45_F4</bpmn:incoming><bpmn:outgoing>P-45_F5</bpmn:outgoing></bpmn:subProcess>
    <bpmn:userTask id="P-45_t1" name="Registrar a subida para Premium"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-45_F5</bpmn:incoming><bpmn:outgoing>P-45_F6</bpmn:outgoing></bpmn:userTask>
    <bpmn:task id="P-45_t2" name="Enviar a apresentação de vendas e os casos"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-45_F6</bpmn:incoming><bpmn:outgoing>P-45_F7</bpmn:outgoing></bpmn:task>
    <bpmn:subProcess id="P-45_s2" name="Verificar a ficha do fornecedor"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-45_F7</bpmn:incoming><bpmn:outgoing>P-45_F8</bpmn:outgoing></bpmn:subProcess>
    <bpmn:task id="P-45_t3" name="Avisar os consultores da Wise de que ele pode ser recomendado"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-45_F8</bpmn:incoming><bpmn:outgoing>P-45_F9</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-45_t4" name="Anunciar o novo nível ao parceiro, com o certificado"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Hipótese</bpmn:documentation><bpmn:incoming>P-45_F9</bpmn:incoming><bpmn:outgoing>P-45_F10</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="P-45_f0" name="Parceiro segue como Select"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-45_F3</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-45_f1" name="Parceiro Premium recomendável"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-45_F10</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-45_F1" name="" sourceRef="P-45_i1" targetRef="P-45_e0" />
    <bpmn:sequenceFlow id="P-45_F2" name="" sourceRef="P-45_e0" targetRef="P-45_g0" />
    <bpmn:sequenceFlow id="P-45_F3" name="Não" sourceRef="P-45_g0" targetRef="P-45_f0" />
    <bpmn:sequenceFlow id="P-45_F4" name="Sim" sourceRef="P-45_g0" targetRef="P-45_s1" />
    <bpmn:sequenceFlow id="P-45_F5" name="" sourceRef="P-45_s1" targetRef="P-45_t1" />
    <bpmn:sequenceFlow id="P-45_F6" name="" sourceRef="P-45_t1" targetRef="P-45_t2" />

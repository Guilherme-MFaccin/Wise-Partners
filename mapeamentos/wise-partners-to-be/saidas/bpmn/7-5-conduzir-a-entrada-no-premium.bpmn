<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-45" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-45">
    <bpmn:participant id="Participant_P-45" name="7.5 Conduzir a entrada no Premium" processRef="Process_P-45" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-45" name="7.5 Conduzir a entrada no Premium" isExecutable="false">
    <bpmn:documentation>O Premium é o nível em que a Wise passa a recomendar o parceiro aos próprios clientes, e por isso começa pelo encontro de alinhamento. Depois dele, o parceiro sobe, tem o perfil revisado para as recomendações e a Prateleira, os consultores da Wise ficam sabendo que podem recomendá-lo e o novo nível é anunciado. No portal: registra a subida, publica a ficha na Prateleira e avisa os dois lados. [status do fluxo: Confirmado; evidências: EV-0358]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-45">
      <bpmn:lane id="Lane_P-45_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-45_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-45_s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-45_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-45_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-45_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-45_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-45_f1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-45_i1" name="Parceiro convidado para o Premium"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:outgoing>P-45_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:subProcess id="P-45_s1" name="Conduzir o encontro de alinhamento"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-45_F1</bpmn:incoming><bpmn:outgoing>P-45_F2</bpmn:outgoing></bpmn:subProcess>
    <bpmn:userTask id="P-45_t1" name="Registrar a subida para Premium"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-45_F2</bpmn:incoming><bpmn:outgoing>P-45_F3</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P-45_t2" name="Revisar o perfil para as recomendações e a Prateleira"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-45_F3</bpmn:incoming><bpmn:outgoing>P-45_F4</bpmn:outgoing></bpmn:userTask>
    <bpmn:task id="P-45_t3" name="Avisar os consultores da Wise de que ele pode ser recomendado"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-45_F4</bpmn:incoming><bpmn:outgoing>P-45_F5</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-45_t4" name="Anunciar o novo nível ao parceiro e na comunidade"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Confirmado</bpmn:documentation><bpmn:incoming>P-45_F5</bpmn:incoming><bpmn:outgoing>P-45_F6</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="P-45_f1" name="Parceiro Premium recomendável"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-45_F6</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-45_F1" name="" sourceRef="P-45_i1" targetRef="P-45_s1" />
    <bpmn:sequenceFlow id="P-45_F2" name="" sourceRef="P-45_s1" targetRef="P-45_t1" />
    <bpmn:sequenceFlow id="P-45_F3" name="" sourceRef="P-45_t1" targetRef="P-45_t2" />
    <bpmn:sequenceFlow id="P-45_F4" name="" sourceRef="P-45_t2" targetRef="P-45_t3" />
    <bpmn:sequenceFlow id="P-45_F5" name="" sourceRef="P-45_t3" targetRef="P-45_t4" />
    <bpmn:sequenceFlow id="P-45_F6" name="" sourceRef="P-45_t4" targetRef="P-45_f1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_P-45">
    <bpmndi:BPMNPlane id="BPMNPlane_P-45" bpmnElement="Collaboration_P-45">
      <bpmndi:BPMNShape id="Participant_P-45_di" bpmnElement="Participant_P-45" isHorizontal="true"><dc:Bounds x="0" y="0" width="1352" height="148" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_P-45_PA-01_di" bpmnElement="Lane_P-45_PA-01" isHorizontal="true"><dc:Bounds x="30" y="0" width="1322" height="148" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-45_i1_di" bpmnElement="P-45_i1" color:background-color="#D9F2E1" color:border-color="#2F8F4E"><dc:Bounds x="160" y="56" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="123" y="98" width="110" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>

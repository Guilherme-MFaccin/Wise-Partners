<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-46" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-46">
    <bpmn:participant id="Participant_P-46" name="7.6 Manter a cadência de contato com o parceiro" processRef="Process_P-46" />
    <bpmn:participant id="Ext_P-46_X1" name="Parceiro, candidato ou ex-parceiro" />
    <bpmn:messageFlow id="P-46_M1" name="Retorno da reunião" sourceRef="P-46_t1" targetRef="Ext_P-46_X1" />
    <bpmn:messageFlow id="P-46_M2" name="Contato com algo de valor" sourceRef="P-46_t3" targetRef="Ext_P-46_X1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-46" name="7.6 Manter a cadência de contato com o parceiro" isExecutable="false">
    <bpmn:documentation>Contato curto e frequente, com ritmo pela importância: para o Select, contato automático (portal, e-mail do mês e resumo dos clientes) e o encontro trimestral de parceiros como o contato do trimestre; mensal para quem tem atenção alta; trimestral para os demais Premium e Elite; duas a três vezes por ano para candidatos em nutrição e ex-parceiros. Cada contato leva algo de valor; depois de cada encontro, retorno em até 24 horas. No portal: lembra quem passou da cadência sem contato e sugere o que levar; a lembrança entra na fila como exceção. [status do fluxo: Confirmado; evidências: EV-0247, EV-0103, EV-0105, EV-0104]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-46">
      <bpmn:lane id="Lane_P-46_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-46_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-46_i2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-46_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-46_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-46_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-46_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-46_f1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-46_i1" name="Reunião com parceiro ou candidato realizada"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:outgoing>P-46_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:startEvent id="P-46_i2" name="Cadência de contato vencida"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:outgoing>P-46_F3</bpmn:outgoing><bpmn:timerEventDefinition id="P-46_i2_def" /></bpmn:startEvent>
    <bpmn:userTask id="P-46_t1" name="Enviar o retorno da reunião em até 24 horas"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Confirmado</bpmn:documentation><bpmn:incoming>P-46_F1</bpmn:incoming><bpmn:outgoing>P-46_F2</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P-46_t2" name="Escolher o que levar: oportunidade, conteúdo ou apresentação"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-46_F3</bpmn:incoming><bpmn:outgoing>P-46_F4</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P-46_t3" name="Ligar ou escrever pessoalmente, sem mensagem em massa"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Confirmado</bpmn:documentation><bpmn:incoming>P-46_F4</bpmn:incoming><bpmn:outgoing>P-46_F5</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P-46_t4" name="Registrar o contato e a próxima data"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-46_F2</bpmn:incoming><bpmn:incoming>P-46_F5</bpmn:incoming><bpmn:outgoing>P-46_F6</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P-46_f1" name="Relação em dia"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-46_F6</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-46_F1" name="" sourceRef="P-46_i1" targetRef="P-46_t1" />
    <bpmn:sequenceFlow id="P-46_F2" name="" sourceRef="P-46_t1" targetRef="P-46_t4" />
    <bpmn:sequenceFlow id="P-46_F3" name="" sourceRef="P-46_i2" targetRef="P-46_t2" />
    <bpmn:sequenceFlow id="P-46_F4" name="" sourceRef="P-46_t2" targetRef="P-46_t3" />
    <bpmn:sequenceFlow id="P-46_F5" name="" sourceRef="P-46_t3" targetRef="P-46_t4" />
    <bpmn:sequenceFlow id="P-46_F6" name="" sourceRef="P-46_t4" targetRef="P-46_f1" />
  </bpmn:process>

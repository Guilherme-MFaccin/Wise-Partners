      <bpmndi:BPMNEdge id="P-66_F2_di" bpmnElement="P-66_F2"><di:waypoint x="418" y="74" /><di:waypoint x="466" y="74" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-66_F3_di" bpmnElement="P-66_F3"><di:waypoint x="594" y="74" /><di:waypoint x="642" y="74" /></bpmndi:BPMNEdge>

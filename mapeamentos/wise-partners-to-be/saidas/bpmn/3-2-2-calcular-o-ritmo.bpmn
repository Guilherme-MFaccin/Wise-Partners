<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-66" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-66">
    <bpmn:participant id="Participant_P-66" name="3.2.2 Calcular o Ritmo" processRef="Process_P-66" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-66" name="3.2.2 Calcular o Ritmo" isExecutable="false">
    <bpmn:documentation>Recência e frequência de ações de valor: cliente cadastrado pelo link, diagnóstico feito na base, indicação, retorno a oportunidade ou pedido da Prateleira, ação de Base Ativa e presença em revisão. No portal: calcula todo dia. [status do fluxo: Hipótese; evidências: nenhuma]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-66">
      <bpmn:lane id="Lane_P-66_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-66_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-66_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-66_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-66_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-66_f1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-66_i1" name="Leitura diária do portal"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-66_F1</bpmn:outgoing><bpmn:timerEventDefinition id="P-66_i1_def" /></bpmn:startEvent>
    <bpmn:serviceTask id="P-66_t1" name="Listar as ações de valor do parceiro"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-66_F1</bpmn:incoming><bpmn:outgoing>P-66_F2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P-66_t2" name="Medir a recência e a frequência"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-66_F2</bpmn:incoming><bpmn:outgoing>P-66_F3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P-66_t3" name="Comparar com o corte de Ritmo"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-66_F3</bpmn:incoming><bpmn:outgoing>P-66_F4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="P-66_f1" name="Ritmo alto ou baixo"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-66_F4</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-66_F1" name="" sourceRef="P-66_i1" targetRef="P-66_t1" />
    <bpmn:sequenceFlow id="P-66_F2" name="" sourceRef="P-66_t1" targetRef="P-66_t2" />
    <bpmn:sequenceFlow id="P-66_F3" name="" sourceRef="P-66_t2" targetRef="P-66_t3" />
    <bpmn:sequenceFlow id="P-66_F4" name="" sourceRef="P-66_t3" targetRef="P-66_f1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_P-66">
    <bpmndi:BPMNPlane id="BPMNPlane_P-66" bpmnElement="Collaboration_P-66">

      <bpmndi:BPMNShape id="Lane_P-66_PA-01_di" bpmnElement="Lane_P-66_PA-01" isHorizontal="true"><dc:Bounds x="30" y="0" width="970" height="148" /></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="P-66_t3_di" bpmnElement="P-66_t3" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="642" y="38" width="128" height="72" /></bpmndi:BPMNShape>

  <bpmn:collaboration id="Collaboration_P-89">
    <bpmn:participant id="Participant_P-89" name="11.2 Manter o kit de vendas e o simulador de ganho" processRef="Process_P-89" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-89" name="11.2 Manter o kit de vendas e o simulador de ganho" isExecutable="false">
    <bpmn:documentation>Material de vendas da Wise Makers, da Tríade e da Swallow e quanto o parceiro ganha por indicação em cada uma. No portal: mostra o kit e simula o ganho pela regra única. [status do fluxo: Hipótese; evidências: nenhuma]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-89">
      <bpmn:lane id="Lane_P-89_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-89_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-89_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-89_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-89_f1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-89_i1" name="Material ou regra de comissão nova"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-89_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P-89_t1" name="Atualizar o material de vendas e a arte do anúncio conjunto"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-89_F1</bpmn:incoming><bpmn:outgoing>P-89_F2</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P-89_t2" name="Recalcular o simulador pela regra vigente"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-89_F2</bpmn:incoming><bpmn:outgoing>P-89_F3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="P-89_f1" name="Kit e simulador atualizados"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-89_F3</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-89_F1" name="" sourceRef="P-89_i1" targetRef="P-89_t1" />
    <bpmn:sequenceFlow id="P-89_F2" name="" sourceRef="P-89_t1" targetRef="P-89_t2" />
    <bpmn:sequenceFlow id="P-89_F3" name="" sourceRef="P-89_t2" targetRef="P-89_f1" />
  </bpmn:process>

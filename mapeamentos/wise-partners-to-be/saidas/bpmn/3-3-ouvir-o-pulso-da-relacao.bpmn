      <bpmndi:BPMNShape id="P-17_e1_di" bpmnElement="P-17_e1" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="688" y="156" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="651" y="198" width="110" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-17_t3_di" bpmnElement="P-17_t3" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="818" y="138" width="128" height="72" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-17_f1_di" bpmnElement="P-17_f1" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="1040" y="156" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1003" y="198" width="110" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P-17_F1_di" bpmnElement="P-17_F1"><di:waypoint x="196" y="174" /><di:waypoint x="290" y="174" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-17_F2_di" bpmnElement="P-17_F2"><di:waypoint x="418" y="174" /><di:waypoint x="466" y="174" /></bpmndi:BPMNEdge>

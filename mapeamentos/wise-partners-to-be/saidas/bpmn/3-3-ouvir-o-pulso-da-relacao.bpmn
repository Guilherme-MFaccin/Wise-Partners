<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-17" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-17">
    <bpmn:participant id="Participant_P-17" name="3.3 Ouvir o pulso da relação" processRef="Process_P-17" />
    <bpmn:participant id="Ext_P-17_X1" name="Parceiro" />
    <bpmn:messageFlow id="P-17_M1" name="Pesquisa de pulso" sourceRef="P-17_t1" targetRef="Ext_P-17_X1" />
    <bpmn:messageFlow id="P-17_M2" name="Respostas" sourceRef="Ext_P-17_X1" targetRef="P-17_e1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-17" name="3.3 Ouvir o pulso da relação" isExecutable="false">
    <bpmn:documentation>Três perguntas de 1 a 5, respondidas pelo parceiro e pelo Gerente sobre o outro lado (daria referência positiva, a parceria cumpre o combinado, há equilíbrio no que cada lado dá), mais a nota de satisfação. No portal: envia a pesquisa, junta as respostas e alimenta o fator Relação. [status do fluxo: Hipótese; evidências: nenhuma]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-17">
      <bpmn:lane id="Lane_P-17_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-17_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-17_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-17_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-17_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-17_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-17_f1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-17_i1" name="Fechamento trimestral"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-17_F1</bpmn:outgoing><bpmn:timerEventDefinition id="P-17_i1_def" /></bpmn:startEvent>
    <bpmn:serviceTask id="P-17_t1" name="Enviar a pesquisa de pulso aos parceiros"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-17_F1</bpmn:incoming><bpmn:outgoing>P-17_F2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P-17_t2" name="Responder as perguntas sobre cada parceiro Premium e Elite"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-17_F2</bpmn:incoming><bpmn:outgoing>P-17_F3</bpmn:outgoing></bpmn:userTask>
    <bpmn:intermediateCatchEvent id="P-17_e1" name="Respostas dos parceiros"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-17_F3</bpmn:incoming><bpmn:outgoing>P-17_F4</bpmn:outgoing><bpmn:messageEventDefinition id="P-17_e1_def" /></bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="P-17_t3" name="Juntar as respostas e alimentar a Relação"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-17_F4</bpmn:incoming><bpmn:outgoing>P-17_F5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="P-17_f1" name="Pulso do trimestre registrado"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-17_F5</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-17_F1" name="" sourceRef="P-17_i1" targetRef="P-17_t1" />
    <bpmn:sequenceFlow id="P-17_F2" name="" sourceRef="P-17_t1" targetRef="P-17_t2" />
    <bpmn:sequenceFlow id="P-17_F3" name="" sourceRef="P-17_t2" targetRef="P-17_e1" />
    <bpmn:sequenceFlow id="P-17_F4" name="" sourceRef="P-17_e1" targetRef="P-17_t3" />
    <bpmn:sequenceFlow id="P-17_F5" name="" sourceRef="P-17_t3" targetRef="P-17_f1" />
  </bpmn:process>

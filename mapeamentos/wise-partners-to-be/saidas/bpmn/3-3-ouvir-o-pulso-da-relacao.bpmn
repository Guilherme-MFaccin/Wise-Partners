    <bpmndi:BPMNPlane id="BPMNPlane_P-17" bpmnElement="Collaboration_P-17">
      <bpmndi:BPMNShape id="Participant_P-17_di" bpmnElement="Participant_P-17" isHorizontal="true"><dc:Bounds x="0" y="100" width="1176" height="148" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_P-17_PA-01_di" bpmnElement="Lane_P-17_PA-01" isHorizontal="true"><dc:Bounds x="30" y="100" width="1146" height="148" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ext_P-17_X1_di" bpmnElement="Ext_P-17_X1" isHorizontal="true"><dc:Bounds x="0" y="0" width="1176" height="60" /></bpmndi:BPMNShape>

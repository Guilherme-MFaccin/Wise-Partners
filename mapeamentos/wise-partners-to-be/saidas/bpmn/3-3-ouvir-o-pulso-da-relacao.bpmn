      <bpmndi:BPMNEdge id="P-17_M1_di" bpmnElement="P-17_M1"><di:waypoint x="354" y="138" /><di:waypoint x="354" y="60" /><bpmndi:BPMNLabel><dc:Bounds x="360" y="73" width="119" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-17_M2_di" bpmnElement="P-17_M2"><di:waypoint x="706" y="60" /><di:waypoint x="706" y="156" /><bpmndi:BPMNLabel><dc:Bounds x="712" y="73" width="63" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

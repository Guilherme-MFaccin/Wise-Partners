<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-21" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-21">
    <bpmn:participant id="Participant_P-21" name="4.2 Receber o cadastro com o aceite" processRef="Process_P-21" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-21" name="4.2 Receber o cadastro com o aceite" isExecutable="false">
    <bpmn:documentation>No envio do formulário, o portal valida os campos e os dois aceites, barra quem já tem acesso, quem já é parceiro e quem já está na fila, registra o cadastro com a origem (campanha, anúncio e vídeo) e as versões do termo e da política, avisa os administradores e mostra ao candidato o próximo passo. Candidatos de outras origens recebem o link da página e entram pela mesma fila. No portal: é a fila de espera em Configurações, com a situação, a observação e os botões de WhatsApp, agenda e aprovação. [status do fluxo: Hipótese; evidências: nenhuma]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-21">
      <bpmn:lane id="Lane_P-21_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-21_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-21_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-21_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-21_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-21_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-21_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-21_f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-21_f2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-21_PA-06" name="Candidato a parceiro">
        <bpmn:flowNodeRef>P-21_i1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-21_i1" name="Formulário da página enviado"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-21_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="P-21_t1" name="Validar os campos e os dois aceites"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-21_F1</bpmn:incoming><bpmn:outgoing>P-21_F2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P-21_g1" name="E-mail com acesso, empresa já parceira ou já na fila?"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-21_F2</bpmn:incoming><bpmn:outgoing>P-21_F3</bpmn:outgoing><bpmn:outgoing>P-21_F5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P-21_t2" name="Mostrar o motivo ao candidato"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-21_F3</bpmn:incoming><bpmn:outgoing>P-21_F4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P-21_t3" name="Registrar o cadastro com a origem e as versões do termo e da política"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-21_F5</bpmn:incoming><bpmn:outgoing>P-21_F6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P-21_t4" name="Avisar os administradores"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-21_F6</bpmn:incoming><bpmn:outgoing>P-21_F7</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P-21_t5" name="Mostrar ao candidato que a equipe fala em até 24 horas úteis"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-21_F7</bpmn:incoming><bpmn:outgoing>P-21_F8</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="P-21_f1" name="Cadastro recusado pela página"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-21_F4</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-21_f2" name="Cadastro na fila"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-21_F8</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-21_F1" name="" sourceRef="P-21_i1" targetRef="P-21_t1" />
    <bpmn:sequenceFlow id="P-21_F2" name="" sourceRef="P-21_t1" targetRef="P-21_g1" />
    <bpmn:sequenceFlow id="P-21_F3" name="Sim" sourceRef="P-21_g1" targetRef="P-21_t2" />
    <bpmn:sequenceFlow id="P-21_F4" name="" sourceRef="P-21_t2" targetRef="P-21_f1" />
    <bpmn:sequenceFlow id="P-21_F5" name="Não" sourceRef="P-21_g1" targetRef="P-21_t3" />
    <bpmn:sequenceFlow id="P-21_F6" name="" sourceRef="P-21_t3" targetRef="P-21_t4" />
    <bpmn:sequenceFlow id="P-21_F7" name="" sourceRef="P-21_t4" targetRef="P-21_t5" />
    <bpmn:sequenceFlow id="P-21_F8" name="" sourceRef="P-21_t5" targetRef="P-21_f2" />
  </bpmn:process>

        <bpmn:flowNodeRef>P-37_f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-37_f2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-37_PA-02" name="Diretor">
        <bpmn:flowNodeRef>P-37_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-37_g2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-37_i1" name="Plano conjunto acordado no workshop"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:outgoing>P-37_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P-37_t1" name="Registrar interesses, alternativas e pacote gatilho"><bpmn:documentation>sistema: Portal Wise Partners; status: Declarado</bpmn:documentation><bpmn:incoming>P-37_F1</bpmn:incoming><bpmn:outgoing>P-37_F2</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P-37_t2" name="Preencher o termo-quadro"><bpmn:documentation>sistema: Portal Wise Partners; status: Declarado</bpmn:documentation><bpmn:incoming>P-37_F2</bpmn:incoming><bpmn:outgoing>P-37_F3</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P-37_t3" name="Enviar o rascunho pedindo críticas"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Declarado</bpmn:documentation><bpmn:incoming>P-37_F3</bpmn:incoming><bpmn:incoming>P-37_F7</bpmn:incoming><bpmn:outgoing>P-37_F4</bpmn:outgoing></bpmn:userTask>
    <bpmn:intermediateCatchEvent id="P-37_e1" name="Críticas do candidato"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-37_F4</bpmn:incoming><bpmn:outgoing>P-37_F5</bpmn:outgoing><bpmn:messageEventDefinition id="P-37_e1_def" /></bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="P-37_g1" name="Rascunho ainda melhora?"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-37_F5</bpmn:incoming><bpmn:outgoing>P-37_F6</bpmn:outgoing><bpmn:outgoing>P-37_F8</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="P-37_t4" name="Revisar o rascunho"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-37_F6</bpmn:incoming><bpmn:incoming>P-37_F13</bpmn:incoming><bpmn:outgoing>P-37_F7</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="P-37_g0" name="Termos dentro do pacote gatilho?"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-37_F8</bpmn:incoming><bpmn:outgoing>P-37_F9</bpmn:outgoing><bpmn:outgoing>P-37_F10</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P-37_t5" name="Responder sim ou não à assinatura"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-37_F9</bpmn:incoming><bpmn:outgoing>P-37_F11</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P-37_g2" name="Assinatura aprovada?"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-37_F11</bpmn:incoming><bpmn:outgoing>P-37_F12</bpmn:outgoing><bpmn:outgoing>P-37_F13</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P-37_t6" name="Enviar o termo para assinatura digital"><bpmn:documentation>sistema: Autentique; status: Declarado</bpmn:documentation><bpmn:incoming>P-37_F12</bpmn:incoming><bpmn:outgoing>P-37_F14</bpmn:outgoing></bpmn:userTask>
    <bpmn:intermediateCatchEvent id="P-37_e2" name="Termo assinado"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-37_F14</bpmn:incoming><bpmn:outgoing>P-37_F15</bpmn:outgoing><bpmn:messageEventDefinition id="P-37_e2_def" /></bpmn:intermediateCatchEvent>
    <bpmn:userTask id="P-37_t7" name="Anexar o termo assinado"><bpmn:documentation>sistema: Portal Wise Partners; status: Declarado</bpmn:documentation><bpmn:incoming>P-37_F15</bpmn:incoming><bpmn:outgoing>P-37_F16</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P-37_f1" name="Termo assinado"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-37_F16</bpmn:incoming></bpmn:endEvent>

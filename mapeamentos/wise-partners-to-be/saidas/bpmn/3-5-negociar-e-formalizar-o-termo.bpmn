  <bpmn:process id="Process_P-37" name="3.5 Negociar e formalizar o termo" isExecutable="false">
    <bpmn:documentation>Texto único: o termo-quadro preenchido circula como rascunho pedindo críticas, com interesses, alternativas e pacote gatilho registrados; o Diretor responde sim ou não; assinatura digital. [status do fluxo: Declarado; evidências: EV-0124, EV-0131, EV-0085, EV-0086, EV-0111, EV-0011]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-37">
      <bpmn:lane id="Lane_P-37_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-37_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-37_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-37_t2</bpmn:flowNodeRef>

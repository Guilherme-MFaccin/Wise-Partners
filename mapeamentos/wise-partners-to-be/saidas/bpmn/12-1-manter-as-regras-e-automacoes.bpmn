<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-91" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-91">
    <bpmn:participant id="Participant_P-91" name="12.1 Manter as regras e automações" processRef="Process_P-91" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-91" name="12.1 Manter as regras e automações" isExecutable="false">
    <bpmn:documentation>Cada regra (marcos, contato vencido, cubo, nível, risco, retorno ao parceiro, fila sem contato, lembrete de etapa e ativação) roda sozinha; primeiro se faz à mão e se entende, depois se automatiza e se confere em casos reais. No portal: é onde as regras rodam. [status do fluxo: Hipótese; evidências: nenhuma]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-91">
      <bpmn:lane id="Lane_P-91_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-91_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-91_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-91_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-91_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-91_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-91_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-91_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-91_f1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-91_i1" name="Regra nova ou ajuste de regra"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-91_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="P-91_t1" name="Aplicar a regra à mão em alguns casos"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-91_F1</bpmn:incoming><bpmn:outgoing>P-91_F2</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-91_t2" name="Escrever a regra: quando dispara e o que faz"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-91_F2</bpmn:incoming><bpmn:incoming>P-91_F6</bpmn:incoming><bpmn:outgoing>P-91_F3</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="P-91_t3" name="Configurar a regra no portal"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-91_F3</bpmn:incoming><bpmn:outgoing>P-91_F4</bpmn:outgoing></bpmn:userTask>
    <bpmn:task id="P-91_t4" name="Conferir o resultado em casos reais"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-91_F4</bpmn:incoming><bpmn:outgoing>P-91_F5</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="P-91_g1" name="A regra fez o esperado?"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-91_F5</bpmn:incoming><bpmn:outgoing>P-91_F6</bpmn:outgoing><bpmn:outgoing>P-91_F7</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P-91_t5" name="Ligar a regra para todos"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-91_F7</bpmn:incoming><bpmn:outgoing>P-91_F8</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="P-91_f1" name="Regra rodando"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-91_F8</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-91_F1" name="" sourceRef="P-91_i1" targetRef="P-91_t1" />
    <bpmn:sequenceFlow id="P-91_F2" name="" sourceRef="P-91_t1" targetRef="P-91_t2" />
    <bpmn:sequenceFlow id="P-91_F3" name="" sourceRef="P-91_t2" targetRef="P-91_t3" />
    <bpmn:sequenceFlow id="P-91_F4" name="" sourceRef="P-91_t3" targetRef="P-91_t4" />
    <bpmn:sequenceFlow id="P-91_F5" name="" sourceRef="P-91_t4" targetRef="P-91_g1" />
    <bpmn:sequenceFlow id="P-91_F6" name="Não" sourceRef="P-91_g1" targetRef="P-91_t2" />
    <bpmn:sequenceFlow id="P-91_F7" name="Sim" sourceRef="P-91_g1" targetRef="P-91_t5" />
    <bpmn:sequenceFlow id="P-91_F8" name="" sourceRef="P-91_t5" targetRef="P-91_f1" />
  </bpmn:process>

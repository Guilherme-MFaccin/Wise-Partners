<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-43" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-43">
    <bpmn:participant id="Participant_P-43" name="7.3 Cumprir as ações conjuntas combinadas" processRef="Process_P-43" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-43" name="7.3 Cumprir as ações conjuntas combinadas" isExecutable="false">
    <bpmn:documentation>Plano de ações dos dois lados, com data, responsável, comprovação e resultado. No portal: mostra o plano em calendário e conta cada ação como ação de valor no Ritmo. [status do fluxo: Hipótese; evidências: nenhuma]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-43">
      <bpmn:lane id="Lane_P-43_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-43_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-43_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-43_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-43_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-43_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-43_f1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-43_PA-05" name="Responsável nomeado no parceiro">
        <bpmn:flowNodeRef>P-43_t3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-43_i1" name="Ação combinada na revisão conjunta"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-43_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P-43_t1" name="Registrar a ação com data, responsáveis e forma de comprovar"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-43_F1</bpmn:incoming><bpmn:outgoing>P-43_F2</bpmn:outgoing></bpmn:userTask>
    <bpmn:intermediateCatchEvent id="P-43_e1" name="Data da ação"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-43_F2</bpmn:incoming><bpmn:outgoing>P-43_F3</bpmn:outgoing><bpmn:timerEventDefinition id="P-43_e1_def" /></bpmn:intermediateCatchEvent>
    <bpmn:task id="P-43_t2" name="Cumprir a ação combinada com o parceiro"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-43_F3</bpmn:incoming><bpmn:outgoing>P-43_F4</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-43_t3" name="Enviar a comprovação"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-43_F4</bpmn:incoming><bpmn:outgoing>P-43_F5</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="P-43_t4" name="Registrar a comprovação e o resultado"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-43_F5</bpmn:incoming><bpmn:outgoing>P-43_F6</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P-43_f1" name="Ação comprovada"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-43_F6</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-43_F1" name="" sourceRef="P-43_i1" targetRef="P-43_t1" />
    <bpmn:sequenceFlow id="P-43_F2" name="" sourceRef="P-43_t1" targetRef="P-43_e1" />
    <bpmn:sequenceFlow id="P-43_F3" name="" sourceRef="P-43_e1" targetRef="P-43_t2" />
    <bpmn:sequenceFlow id="P-43_F4" name="" sourceRef="P-43_t2" targetRef="P-43_t3" />
    <bpmn:sequenceFlow id="P-43_F5" name="" sourceRef="P-43_t3" targetRef="P-43_t4" />
    <bpmn:sequenceFlow id="P-43_F6" name="" sourceRef="P-43_t4" targetRef="P-43_f1" />
  </bpmn:process>

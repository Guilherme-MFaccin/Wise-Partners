      <bpmndi:BPMNShape id="P-43_t4_di" bpmnElement="P-43_t4" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="994" y="38" width="128" height="72" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-43_f1_di" bpmnElement="P-43_f1" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="1216" y="56" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1179" y="98" width="110" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>

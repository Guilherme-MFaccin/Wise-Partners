      <bpmndi:BPMNShape id="P-22_t1_di" bpmnElement="P-22_t1" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="290" y="38" width="128" height="72" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-22_t2_di" bpmnElement="P-22_t2" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="466" y="38" width="128" height="72" /></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="P-22_g1_di" bpmnElement="P-22_g1" isMarkerVisible="true" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="857" y="49" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="827" y="15" width="110" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-22_f1_di" bpmnElement="P-22_f1" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="1040" y="56" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1003" y="98" width="110" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-22_f2_di" bpmnElement="P-22_f2" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="1040" y="160" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1003" y="202" width="110" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P-22_F1_di" bpmnElement="P-22_F1"><di:waypoint x="196" y="74" /><di:waypoint x="290" y="74" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-22_F2_di" bpmnElement="P-22_F2"><di:waypoint x="418" y="74" /><di:waypoint x="466" y="74" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-22_F3_di" bpmnElement="P-22_F3"><di:waypoint x="594" y="74" /><di:waypoint x="642" y="74" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-22_F4_di" bpmnElement="P-22_F4"><di:waypoint x="770" y="74" /><di:waypoint x="857" y="74" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-22_F5_di" bpmnElement="P-22_F5"><di:waypoint x="907" y="74" /><di:waypoint x="1040" y="74" /><bpmndi:BPMNLabel><dc:Bounds x="913" y="54" width="30" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>

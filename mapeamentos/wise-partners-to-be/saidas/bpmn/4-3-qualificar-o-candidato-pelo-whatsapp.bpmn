<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-22" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-22">
    <bpmn:participant id="Participant_P-22" name="4.3 Qualificar o candidato pelo WhatsApp" processRef="Process_P-22" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-22" name="4.3 Qualificar o candidato pelo WhatsApp" isExecutable="false">
    <bpmn:documentation>Pela própria mensagem, o Gerente confirma as informações que o candidato deixou no cadastro e aplica os critérios: ter clientes empresariais que podem estar no ICP da Wise (vale para qualquer tipo de parceiro), não ser concorrente da Wise Makers, mostrar interesse real em oferecer a consultoria aos clientes e ter um responsável na empresa para cuidar da parceria. Não há mínimo de clientes ativos. O Gerente cuida da fila sempre. No portal: guarda a observação de cada contato e muda a situação do cadastro. [status do fluxo: Hipótese; evidências: nenhuma]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-22">
      <bpmn:lane id="Lane_P-22_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-22_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-22_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-22_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-22_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-22_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-22_f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-22_f2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-22_i1" name="Candidato respondeu ao primeiro contato"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-22_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="P-22_t1" name="Confirmar com o candidato os dados do cadastro"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Hipótese</bpmn:documentation><bpmn:incoming>P-22_F1</bpmn:incoming><bpmn:outgoing>P-22_F2</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-22_t2" name="Perguntar sobre os clientes, o responsável e o interesse"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Hipótese</bpmn:documentation><bpmn:incoming>P-22_F2</bpmn:incoming><bpmn:outgoing>P-22_F3</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="P-22_t3" name="Registrar a observação e marcar como contatado"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-22_F3</bpmn:incoming><bpmn:outgoing>P-22_F4</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P-22_g1" name="Cumpre os critérios da fila?"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-22_F4</bpmn:incoming><bpmn:outgoing>P-22_F5</bpmn:outgoing><bpmn:outgoing>P-22_F6</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="P-22_f1" name="Candidato não elegível"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-22_F5</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-22_f2" name="Candidato qualificado"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-22_F6</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-22_F1" name="" sourceRef="P-22_i1" targetRef="P-22_t1" />
    <bpmn:sequenceFlow id="P-22_F2" name="" sourceRef="P-22_t1" targetRef="P-22_t2" />
    <bpmn:sequenceFlow id="P-22_F3" name="" sourceRef="P-22_t2" targetRef="P-22_t3" />
    <bpmn:sequenceFlow id="P-22_F4" name="" sourceRef="P-22_t3" targetRef="P-22_g1" />
    <bpmn:sequenceFlow id="P-22_F5" name="Não" sourceRef="P-22_g1" targetRef="P-22_f1" />
    <bpmn:sequenceFlow id="P-22_F6" name="Sim" sourceRef="P-22_g1" targetRef="P-22_f2" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_P-22">
    <bpmndi:BPMNPlane id="BPMNPlane_P-22" bpmnElement="Collaboration_P-22">
      <bpmndi:BPMNShape id="Participant_P-22_di" bpmnElement="Participant_P-22" isHorizontal="true"><dc:Bounds x="0" y="0" width="1176" height="252" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_P-22_PA-01_di" bpmnElement="Lane_P-22_PA-01" isHorizontal="true"><dc:Bounds x="30" y="0" width="1146" height="252" /></bpmndi:BPMNShape>

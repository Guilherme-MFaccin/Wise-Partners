<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-52" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-52">
    <bpmn:participant id="Participant_P-52" name="8.5 Apresentar parceiros entre si" processRef="Process_P-52" />
    <bpmn:participant id="Ext_P-52_X1" name="Parceiros" />
    <bpmn:messageFlow id="P-52_M1" name="Problema ou oportunidade" sourceRef="Ext_P-52_X1" targetRef="P-52_i1" />
    <bpmn:messageFlow id="P-52_M2" name="Proposta de apresentação" sourceRef="P-52_t2" targetRef="Ext_P-52_X1" />
    <bpmn:messageFlow id="P-52_M3" name="Apresentação" sourceRef="P-52_t3" targetRef="Ext_P-52_X1" />
    <bpmn:messageFlow id="P-52_M4" name="Como foi a conversa" sourceRef="Ext_P-52_X1" targetRef="P-52_e1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-52" name="8.5 Apresentar parceiros entre si" isExecutable="false">
    <bpmn:documentation>Quando um parceiro menciona um problema, a Wise pensa em quem resolve e apresenta, sem esperar pedido; a troca acontece em torno de uma oportunidade específica, nunca com a lista inteira de contatos; quem apresentou recebe o retorno de como foi. No portal: sugere apresentações a partir do cruzamento de carteiras e das categorias de cada parceiro, e registra cada apresentação feita. [status do fluxo: Confirmado; evidências: EV-0242, EV-0098, EV-0099, EV-0102]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-52">
      <bpmn:lane id="Lane_P-52_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-52_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-52_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-52_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-52_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-52_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-52_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-52_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-52_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-52_f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-52_f2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-52_f3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-52_i1" name="Parceiro menciona um problema ou uma oportunidade"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:outgoing>P-52_F1</bpmn:outgoing><bpmn:messageEventDefinition id="P-52_i1_def" /></bpmn:startEvent>
    <bpmn:userTask id="P-52_t1" name="Procurar quem resolve entre os parceiros"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-52_F1</bpmn:incoming><bpmn:outgoing>P-52_F2</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P-52_g1" name="Algum parceiro resolve?"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-52_F2</bpmn:incoming><bpmn:outgoing>P-52_F3</bpmn:outgoing><bpmn:outgoing>P-52_F4</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P-52_t2" name="Confirmar com os dois lados se querem a conversa"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Confirmado</bpmn:documentation><bpmn:incoming>P-52_F4</bpmn:incoming><bpmn:outgoing>P-52_F5</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P-52_g2" name="Os dois aceitam?"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-52_F5</bpmn:incoming><bpmn:outgoing>P-52_F6</bpmn:outgoing><bpmn:outgoing>P-52_F7</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P-52_t3" name="Apresentar os dois em torno dessa oportunidade"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Confirmado</bpmn:documentation><bpmn:incoming>P-52_F7</bpmn:incoming><bpmn:outgoing>P-52_F8</bpmn:outgoing></bpmn:userTask>
    <bpmn:intermediateCatchEvent id="P-52_e1" name="Conversa entre os parceiros"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-52_F8</bpmn:incoming><bpmn:outgoing>P-52_F9</bpmn:outgoing><bpmn:messageEventDefinition id="P-52_e1_def" /></bpmn:intermediateCatchEvent>
    <bpmn:userTask id="P-52_t4" name="Perguntar aos dois como foi e registrar a apresentação"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-52_F9</bpmn:incoming><bpmn:outgoing>P-52_F10</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P-52_f1" name="Sem parceiro para apresentar"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-52_F3</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-52_f2" name="Apresentação recusada"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-52_F6</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-52_f3" name="Apresentação feita e registrada"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-52_F10</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-52_F1" name="" sourceRef="P-52_i1" targetRef="P-52_t1" />
    <bpmn:sequenceFlow id="P-52_F2" name="" sourceRef="P-52_t1" targetRef="P-52_g1" />
    <bpmn:sequenceFlow id="P-52_F3" name="Não" sourceRef="P-52_g1" targetRef="P-52_f1" />
    <bpmn:sequenceFlow id="P-52_F4" name="Sim" sourceRef="P-52_g1" targetRef="P-52_t2" />
    <bpmn:sequenceFlow id="P-52_F5" name="" sourceRef="P-52_t2" targetRef="P-52_g2" />
    <bpmn:sequenceFlow id="P-52_F6" name="Não" sourceRef="P-52_g2" targetRef="P-52_f2" />
    <bpmn:sequenceFlow id="P-52_F7" name="Sim" sourceRef="P-52_g2" targetRef="P-52_t3" />
    <bpmn:sequenceFlow id="P-52_F8" name="" sourceRef="P-52_t3" targetRef="P-52_e1" />
    <bpmn:sequenceFlow id="P-52_F9" name="" sourceRef="P-52_e1" targetRef="P-52_t4" />
    <bpmn:sequenceFlow id="P-52_F10" name="" sourceRef="P-52_t4" targetRef="P-52_f3" />
  </bpmn:process>

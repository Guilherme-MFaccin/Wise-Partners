<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-101" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-101">
    <bpmn:participant id="Participant_P-101" name="4.2 Trazer candidatos por outras origens" processRef="Process_P-101" />
    <bpmn:participant id="Ext_P-101_X1" name="Possível parceiro" />
    <bpmn:messageFlow id="P-101_M1" name="Link da página" sourceRef="P-101_t1" targetRef="Ext_P-101_X1" />
    <bpmn:messageFlow id="P-101_M2" name="Cadastro" sourceRef="Ext_P-101_X1" targetRef="P-101_e1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-101" name="4.2 Trazer candidatos por outras origens" isExecutable="false">
    <bpmn:documentation>Parceiros também chegam sem anúncio: de forma orgânica, em eventos e feiras, por contatos pessoais dos consultores e dos sócios, por instituições e órgãos de governo e por indicação de clientes. Quem fez o contato envia o link da página dos parceiros e registra a origem; o candidato segue pelo mesmo caminho da fila. No portal: registra a origem de cada candidato, para comparar o custo e o resultado de cada canal. [status do fluxo: Confirmado; evidências: EV-0413]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-101">
      <bpmn:lane id="Lane_P-101_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-101_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-101_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-101_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-101_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-101_f1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-101_i1" name="Contato com um possível parceiro fora da campanha"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:outgoing>P-101_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="P-101_t1" name="Enviar o link da página dos parceiros"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Confirmado</bpmn:documentation><bpmn:incoming>P-101_F1</bpmn:incoming><bpmn:outgoing>P-101_F2</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="P-101_t2" name="Registrar a origem do candidato"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-101_F2</bpmn:incoming><bpmn:outgoing>P-101_F3</bpmn:outgoing></bpmn:userTask>
    <bpmn:intermediateCatchEvent id="P-101_e1" name="Cadastro pela página"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-101_F3</bpmn:incoming><bpmn:outgoing>P-101_F4</bpmn:outgoing><bpmn:messageEventDefinition id="P-101_e1_def" /></bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="P-101_f1" name="Candidato na fila"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-101_F4</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-101_F1" name="" sourceRef="P-101_i1" targetRef="P-101_t1" />
    <bpmn:sequenceFlow id="P-101_F2" name="" sourceRef="P-101_t1" targetRef="P-101_t2" />
    <bpmn:sequenceFlow id="P-101_F3" name="" sourceRef="P-101_t2" targetRef="P-101_e1" />
    <bpmn:sequenceFlow id="P-101_F4" name="" sourceRef="P-101_e1" targetRef="P-101_f1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_P-101">
    <bpmndi:BPMNPlane id="BPMNPlane_P-101" bpmnElement="Collaboration_P-101">
      <bpmndi:BPMNShape id="Participant_P-101_di" bpmnElement="Participant_P-101" isHorizontal="true"><dc:Bounds x="0" y="100" width="1000" height="148" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_P-101_PA-01_di" bpmnElement="Lane_P-101_PA-01" isHorizontal="true"><dc:Bounds x="30" y="100" width="970" height="148" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ext_P-101_X1_di" bpmnElement="Ext_P-101_X1" isHorizontal="true"><dc:Bounds x="0" y="0" width="1000" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-101_i1_di" bpmnElement="P-101_i1" color:background-color="#D9F2E1" color:border-color="#2F8F4E"><dc:Bounds x="160" y="156" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="123" y="198" width="110" height="42" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-101_t1_di" bpmnElement="P-101_t1" color:background-color="#D9F2E1" color:border-color="#2F8F4E"><dc:Bounds x="290" y="138" width="128" height="72" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-101_t2_di" bpmnElement="P-101_t2" color:background-color="#D9F2E1" color:border-color="#2F8F4E"><dc:Bounds x="466" y="138" width="128" height="72" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-101_e1_di" bpmnElement="P-101_e1" color:background-color="#D9F2E1" color:border-color="#2F8F4E"><dc:Bounds x="688" y="156" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="651" y="198" width="110" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-101_f1_di" bpmnElement="P-101_f1" color:background-color="#D9F2E1" color:border-color="#2F8F4E"><dc:Bounds x="864" y="156" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="827" y="198" width="110" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P-101_F1_di" bpmnElement="P-101_F1"><di:waypoint x="196" y="174" /><di:waypoint x="290" y="174" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-101_F2_di" bpmnElement="P-101_F2"><di:waypoint x="418" y="174" /><di:waypoint x="466" y="174" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-101_F3_di" bpmnElement="P-101_F3"><di:waypoint x="594" y="174" /><di:waypoint x="688" y="174" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-101_F4_di" bpmnElement="P-101_F4"><di:waypoint x="724" y="174" /><di:waypoint x="864" y="174" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-101_M1_di" bpmnElement="P-101_M1"><di:waypoint x="354" y="138" /><di:waypoint x="354" y="60" /><bpmndi:BPMNLabel><dc:Bounds x="360" y="73" width="98" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-101_M2_di" bpmnElement="P-101_M2"><di:waypoint x="706" y="60" /><di:waypoint x="706" y="156" /><bpmndi:BPMNLabel><dc:Bounds x="712" y="73" width="56" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-15" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-15">
    <bpmn:participant id="Participant_P-15" name="3.1 Apurar o CAC e o valor devolvido" processRef="Process_P-15" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-15" name="3.1 Apurar o CAC e o valor devolvido" isExecutable="false">
    <bpmn:documentation>As duas medidas-mãe, com o mesmo peso. CAC: comissões, horas e custos diretos (inclusive anúncios) divididos pelos clientes fechados vindos de parceiros. Valor devolvido: diagnósticos feitos na base do parceiro, formações do Base Ativa, desfechos devolvidos, oportunidades enviadas de volta, apresentações feitas e acessos dados. No portal: calcula as duas a cada mês e a tendência do trimestre, sem nenhum número informado de fora do programa. [status do fluxo: Hipótese; evidências: nenhuma]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-15">
      <bpmn:lane id="Lane_P-15_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-15_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-15_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-15_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-15_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-15_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-15_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-15_f1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-15_i1" name="Fechamento do mês"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-15_F1</bpmn:outgoing><bpmn:timerEventDefinition id="P-15_i1_def" /></bpmn:startEvent>
    <bpmn:userTask id="P-15_t1" name="Conferir as horas dedicadas e registrar o gasto com anúncios do mês"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-15_F1</bpmn:incoming><bpmn:outgoing>P-15_F2</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P-15_t2" name="Somar comissões, horas, anúncios e custos diretos"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-15_F2</bpmn:incoming><bpmn:outgoing>P-15_F3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P-15_t3" name="Dividir pelos clientes fechados vindos de parceiros"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-15_F3</bpmn:incoming><bpmn:outgoing>P-15_F4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P-15_t4" name="Contar o valor devolvido aos parceiros no mês"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-15_F4</bpmn:incoming><bpmn:outgoing>P-15_F5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P-15_t5" name="Mostrar as duas medidas e a tendência do trimestre no painel"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-15_F5</bpmn:incoming><bpmn:outgoing>P-15_F6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="P-15_f1" name="CAC e valor devolvido apurados"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-15_F6</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-15_F1" name="" sourceRef="P-15_i1" targetRef="P-15_t1" />
    <bpmn:sequenceFlow id="P-15_F2" name="" sourceRef="P-15_t1" targetRef="P-15_t2" />
    <bpmn:sequenceFlow id="P-15_F3" name="" sourceRef="P-15_t2" targetRef="P-15_t3" />
    <bpmn:sequenceFlow id="P-15_F4" name="" sourceRef="P-15_t3" targetRef="P-15_t4" />
    <bpmn:sequenceFlow id="P-15_F5" name="" sourceRef="P-15_t4" targetRef="P-15_t5" />
    <bpmn:sequenceFlow id="P-15_F6" name="" sourceRef="P-15_t5" targetRef="P-15_f1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_P-15">
    <bpmndi:BPMNPlane id="BPMNPlane_P-15" bpmnElement="Collaboration_P-15">
      <bpmndi:BPMNShape id="Participant_P-15_di" bpmnElement="Participant_P-15" isHorizontal="true"><dc:Bounds x="0" y="0" width="1352" height="148" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_P-15_PA-01_di" bpmnElement="Lane_P-15_PA-01" isHorizontal="true"><dc:Bounds x="30" y="0" width="1322" height="148" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-15_i1_di" bpmnElement="P-15_i1" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="160" y="56" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="123" y="98" width="110" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-15_t1_di" bpmnElement="P-15_t1" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="290" y="38" width="128" height="72" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-15_t2_di" bpmnElement="P-15_t2" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="466" y="38" width="128" height="72" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-15_t3_di" bpmnElement="P-15_t3" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="642" y="38" width="128" height="72" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-15_t4_di" bpmnElement="P-15_t4" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="818" y="38" width="128" height="72" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-15_t5_di" bpmnElement="P-15_t5" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="994" y="38" width="128" height="72" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-15_f1_di" bpmnElement="P-15_f1" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="1216" y="56" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1179" y="98" width="110" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P-15_F1_di" bpmnElement="P-15_F1"><di:waypoint x="196" y="74" /><di:waypoint x="290" y="74" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-15_F2_di" bpmnElement="P-15_F2"><di:waypoint x="418" y="74" /><di:waypoint x="466" y="74" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-15_F3_di" bpmnElement="P-15_F3"><di:waypoint x="594" y="74" /><di:waypoint x="642" y="74" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-15_F4_di" bpmnElement="P-15_F4"><di:waypoint x="770" y="74" /><di:waypoint x="818" y="74" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-15_F5_di" bpmnElement="P-15_F5"><di:waypoint x="946" y="74" /><di:waypoint x="994" y="74" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-15_F6_di" bpmnElement="P-15_F6"><di:waypoint x="1122" y="74" /><di:waypoint x="1216" y="74" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

      <bpmndi:BPMNShape id="P-33_f1_di" bpmnElement="P-33_f1" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="1040" y="56" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1003" y="98" width="110" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P-33_F1_di" bpmnElement="P-33_F1"><di:waypoint x="196" y="74" /><di:waypoint x="290" y="74" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-33_F2_di" bpmnElement="P-33_F2"><di:waypoint x="418" y="74" /><di:waypoint x="466" y="74" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-33_F3_di" bpmnElement="P-33_F3"><di:waypoint x="594" y="74" /><di:waypoint x="618" y="74" /><di:waypoint x="618" y="222" /><di:waypoint x="642" y="222" /></bpmndi:BPMNEdge>

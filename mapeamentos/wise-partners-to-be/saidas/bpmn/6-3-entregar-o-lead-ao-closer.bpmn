      <bpmndi:BPMNShape id="P-33_t3_di" bpmnElement="P-33_t3" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="642" y="186" width="128" height="72" /></bpmndi:BPMNShape>

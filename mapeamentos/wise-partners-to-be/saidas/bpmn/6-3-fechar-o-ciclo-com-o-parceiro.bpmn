<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-35" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-35">
    <bpmn:participant id="Participant_P-35" name="6.3 Fechar o ciclo com o parceiro" processRef="Process_P-35" />
    <bpmn:participant id="Ext_P-35_X1" name="Parceiro" />
    <bpmn:messageFlow id="P-35_M1" name="Retorno da etapa" sourceRef="P-35_t2" targetRef="Ext_P-35_X1" />
    <bpmn:messageFlow id="P-35_M2" name="Desfecho e impacto" sourceRef="P-35_t3" targetRef="Ext_P-35_X1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-35" name="6.3 Fechar o ciclo com o parceiro" isExecutable="false">
    <bpmn:documentation>Devolver ao parceiro cada mudança de etapa (primeiro contato, proposta, fechamento ou perda) e, no fim, o impacto gerado. No portal: detecta a mudança de etapa e prepara a mensagem para o Gerente mandar no grupo do parceiro. [status do fluxo: Hipótese; evidências: EV-0051, EV-0052, EV-0053]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-35">
      <bpmn:lane id="Lane_P-35_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-35_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-35_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-35_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-35_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-35_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-35_f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-35_f2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-35_i1" name="Oportunidade muda de etapa"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-35_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="P-35_t1" name="Preparar a mensagem de retorno"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-35_F1</bpmn:incoming><bpmn:outgoing>P-35_F2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P-35_t2" name="Enviar o retorno no grupo do parceiro"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Hipótese</bpmn:documentation><bpmn:incoming>P-35_F2</bpmn:incoming><bpmn:outgoing>P-35_F3</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P-35_g1" name="A oportunidade terminou?"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-35_F3</bpmn:incoming><bpmn:outgoing>P-35_F4</bpmn:outgoing><bpmn:outgoing>P-35_F5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P-35_t3" name="Mostrar ao parceiro o impacto gerado"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Hipótese</bpmn:documentation><bpmn:incoming>P-35_F5</bpmn:incoming><bpmn:outgoing>P-35_F6</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P-35_f1" name="Parceiro informado da etapa"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-35_F4</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-35_f2" name="Parceiro informado do desfecho e do impacto"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-35_F6</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-35_F1" name="" sourceRef="P-35_i1" targetRef="P-35_t1" />
    <bpmn:sequenceFlow id="P-35_F2" name="" sourceRef="P-35_t1" targetRef="P-35_t2" />
    <bpmn:sequenceFlow id="P-35_F3" name="" sourceRef="P-35_t2" targetRef="P-35_g1" />
    <bpmn:sequenceFlow id="P-35_F4" name="Não" sourceRef="P-35_g1" targetRef="P-35_f1" />
    <bpmn:sequenceFlow id="P-35_F5" name="Sim" sourceRef="P-35_g1" targetRef="P-35_t3" />
    <bpmn:sequenceFlow id="P-35_F6" name="" sourceRef="P-35_t3" targetRef="P-35_f2" />
  </bpmn:process>

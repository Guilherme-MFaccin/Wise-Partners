<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-34" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-34">
    <bpmn:participant id="Participant_P-34" name="6.3 Fechar o ciclo com o parceiro" processRef="Process_P-34" />
    <bpmn:participant id="Ext_P-34_X1" name="Parceiro" />
    <bpmn:messageFlow id="P-34_M1" name="Retorno da etapa" sourceRef="P-34_t3" targetRef="Ext_P-34_X1" />
    <bpmn:messageFlow id="P-34_M2" name="Desfecho e impacto" sourceRef="P-34_t4" targetRef="Ext_P-34_X1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-34" name="6.3 Fechar o ciclo com o parceiro" isExecutable="false">
    <bpmn:documentation>O closer avisa o Gerente por WhatsApp a cada mudança de etapa; o Gerente registra a etapa e devolve ao parceiro (primeiro contato, proposta, fechamento ou perda) e, no fim, o impacto gerado. O grupo de WhatsApp vale para todos os parceiros até que o tamanho torne isso inviável; o portal mostra ao parceiro a lista de quem entrou pelo link e o andamento. No portal: registra a etapa informada pelo Gerente, prepara a mensagem para ele personalizar e mandar no grupo do parceiro, e mostra no painel da semana as oportunidades paradas há mais de 15 dias. [status do fluxo: Confirmado; evidências: EV-0026, EV-0237, EV-0074, EV-0077]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-34">
      <bpmn:lane id="Lane_P-34_PA-03" name="Closer da empresa do grupo">
        <bpmn:flowNodeRef>P-34_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-34_t0</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-34_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-34_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-34_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-34_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-34_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-34_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-34_f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-34_f2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-34_i1" name="Oportunidade muda de etapa"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:outgoing>P-34_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P-34_t0" name="Avisar o Gerente por WhatsApp"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Confirmado</bpmn:documentation><bpmn:incoming>P-34_F1</bpmn:incoming><bpmn:outgoing>P-34_F2</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P-34_t1" name="Registrar a etapa no portal"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-34_F2</bpmn:incoming><bpmn:outgoing>P-34_F3</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P-34_t2" name="Preparar a mensagem de retorno"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-34_F3</bpmn:incoming><bpmn:outgoing>P-34_F4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P-34_t3" name="Personalizar e enviar o retorno no grupo do parceiro"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Confirmado</bpmn:documentation><bpmn:incoming>P-34_F4</bpmn:incoming><bpmn:outgoing>P-34_F5</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P-34_g1" name="A oportunidade terminou?"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-34_F5</bpmn:incoming><bpmn:outgoing>P-34_F6</bpmn:outgoing><bpmn:outgoing>P-34_F7</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P-34_t4" name="Mostrar ao parceiro o impacto gerado"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Confirmado</bpmn:documentation><bpmn:incoming>P-34_F7</bpmn:incoming><bpmn:outgoing>P-34_F8</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P-34_f1" name="Parceiro informado da etapa"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-34_F6</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-34_f2" name="Parceiro informado do desfecho e do impacto"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-34_F8</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-34_F1" name="" sourceRef="P-34_i1" targetRef="P-34_t0" />
    <bpmn:sequenceFlow id="P-34_F2" name="" sourceRef="P-34_t0" targetRef="P-34_t1" />
    <bpmn:sequenceFlow id="P-34_F3" name="" sourceRef="P-34_t1" targetRef="P-34_t2" />
    <bpmn:sequenceFlow id="P-34_F4" name="" sourceRef="P-34_t2" targetRef="P-34_t3" />
    <bpmn:sequenceFlow id="P-34_F5" name="" sourceRef="P-34_t3" targetRef="P-34_g1" />
    <bpmn:sequenceFlow id="P-34_F6" name="Não" sourceRef="P-34_g1" targetRef="P-34_f1" />
    <bpmn:sequenceFlow id="P-34_F7" name="Sim" sourceRef="P-34_g1" targetRef="P-34_t4" />
    <bpmn:sequenceFlow id="P-34_F8" name="" sourceRef="P-34_t4" targetRef="P-34_f2" />
  </bpmn:process>

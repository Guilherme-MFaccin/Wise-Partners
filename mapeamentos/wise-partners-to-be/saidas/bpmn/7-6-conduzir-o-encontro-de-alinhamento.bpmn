<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-28" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-28">
    <bpmn:participant id="Participant_P-28" name="7.6 Conduzir o encontro de alinhamento" processRef="Process_P-28" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-28" name="7.6 Conduzir o encontro de alinhamento" isExecutable="false">
    <bpmn:documentation>O encontro é a porta do Premium: só com quem a Wise vai passar a recomendar. Registrar o que é sucesso para o parceiro, preencher a ficha de jogo, cruzar as carteiras com consentimento, revelando só as coincidências, e escolher a primeira oportunidade concreta. No portal: processa o cruzamento e sugere as primeiras jogadas. [status do fluxo: Hipótese; evidências: nenhuma]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-28">
      <bpmn:lane id="Lane_P-28_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-28_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-28_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-28_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-28_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-28_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-28_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-28_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-28_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-28_f1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-28_i1" name="Convite para o Premium aceito"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-28_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="P-28_t1" name="Marcar o encontro com o parceiro"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Hipótese</bpmn:documentation><bpmn:incoming>P-28_F1</bpmn:incoming><bpmn:outgoing>P-28_F2</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-28_t2" name="Registrar o que é sucesso para o parceiro"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-28_F2</bpmn:incoming><bpmn:outgoing>P-28_F3</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="P-28_t3" name="Preencher a ficha de jogo: os papéis dele na rede de valor"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-28_F3</bpmn:incoming><bpmn:outgoing>P-28_F4</bpmn:outgoing></bpmn:userTask>
    <bpmn:task id="P-28_t4" name="Pedir o consentimento para cruzar as carteiras"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-28_F4</bpmn:incoming><bpmn:outgoing>P-28_F5</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="P-28_g1" name="O parceiro consente o cruzamento?"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-28_F5</bpmn:incoming><bpmn:outgoing>P-28_F6</bpmn:outgoing><bpmn:outgoing>P-28_F8</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P-28_t5" name="Cruzar as carteiras e mostrar só as coincidências"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-28_F6</bpmn:incoming><bpmn:outgoing>P-28_F7</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:task id="P-28_t6" name="Escolher com o parceiro a primeira oportunidade concreta"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-28_F7</bpmn:incoming><bpmn:incoming>P-28_F8</bpmn:incoming><bpmn:outgoing>P-28_F9</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="P-28_f1" name="Parceiro alinhado, com a primeira oportunidade escolhida"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-28_F9</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-28_F1" name="" sourceRef="P-28_i1" targetRef="P-28_t1" />
    <bpmn:sequenceFlow id="P-28_F2" name="" sourceRef="P-28_t1" targetRef="P-28_t2" />
    <bpmn:sequenceFlow id="P-28_F3" name="" sourceRef="P-28_t2" targetRef="P-28_t3" />
    <bpmn:sequenceFlow id="P-28_F4" name="" sourceRef="P-28_t3" targetRef="P-28_t4" />
    <bpmn:sequenceFlow id="P-28_F5" name="" sourceRef="P-28_t4" targetRef="P-28_g1" />
    <bpmn:sequenceFlow id="P-28_F6" name="Sim" sourceRef="P-28_g1" targetRef="P-28_t5" />
    <bpmn:sequenceFlow id="P-28_F7" name="" sourceRef="P-28_t5" targetRef="P-28_t6" />
    <bpmn:sequenceFlow id="P-28_F8" name="Não" sourceRef="P-28_g1" targetRef="P-28_t6" />
    <bpmn:sequenceFlow id="P-28_F9" name="" sourceRef="P-28_t6" targetRef="P-28_f1" />
  </bpmn:process>

    <bpmn:exclusiveGateway id="P-95_g4" name="O cliente quer contratar a consultoria?"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-95_F18</bpmn:incoming><bpmn:incoming>P-95_F19</bpmn:incoming><bpmn:outgoing>P-95_F20</bpmn:outgoing><bpmn:outgoing>P-95_F22</bpmn:outgoing></bpmn:exclusiveGateway>

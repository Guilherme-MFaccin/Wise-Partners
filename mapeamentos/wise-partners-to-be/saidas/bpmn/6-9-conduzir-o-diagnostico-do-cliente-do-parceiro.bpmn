  <bpmn:collaboration id="Collaboration_P-95">
    <bpmn:participant id="Participant_P-95" name="6.9 Conduzir o diagnóstico do cliente do parceiro" processRef="Process_P-95" />
    <bpmn:participant id="Ext_P-95_X1" name="Parceiro" />
    <bpmn:participant id="Ext_P-95_X2" name="Cliente do parceiro" />
    <bpmn:messageFlow id="P-95_M1" name="Agendamento e consentimentos" sourceRef="Ext_P-95_X2" targetRef="P-95_i1" />
    <bpmn:messageFlow id="P-95_M2" name="Aviso" sourceRef="P-95_t2" targetRef="Ext_P-95_X2" />
    <bpmn:messageFlow id="P-95_M3" name="Mapa de planejamento" sourceRef="P-95_t4" targetRef="Ext_P-95_X2" />
    <bpmn:messageFlow id="P-95_M4" name="Acesso ao Hub" sourceRef="P-95_t5" targetRef="Ext_P-95_X2" />
    <bpmn:messageFlow id="P-95_M5" name="Resumo autorizado" sourceRef="P-95_t6" targetRef="Ext_P-95_X1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-95" name="6.9 Conduzir o diagnóstico do cliente do parceiro" isExecutable="false">
    <bpmn:documentation>O cliente do parceiro marca pela agenda online, no link do parceiro, e dá ali os consentimentos; o Gerente confere se a empresa está no ICP, conduz a reunião pelo roteiro, entrega o mapa de planejamento e libera o Wise Hub; se o cliente autorizou, o parceiro recebe o resumo; se o cliente pedir para seguir, vira oportunidade com a origem no parceiro. No portal: recebe o agendamento pelo link do parceiro, registra o diagnóstico, libera o Hub e cria a oportunidade quando há interesse. [status do fluxo: Confirmado; evidências: EV-0037, EV-0038, EV-0039, EV-0040, EV-0324, EV-0325]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-95">
      <bpmn:lane id="Lane_P-95_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-95_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-95_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-95_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-95_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-95_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-95_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-95_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-95_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-95_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-95_g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-95_t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-95_f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-95_f2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-95_f3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-95_i1" name="Cliente do parceiro marca o diagnóstico"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:outgoing>P-95_F1</bpmn:outgoing><bpmn:messageEventDefinition id="P-95_i1_def" /></bpmn:startEvent>
    <bpmn:userTask id="P-95_t1" name="Conferir se a empresa está no ICP da Wise"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-95_F1</bpmn:incoming><bpmn:outgoing>P-95_F2</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P-95_g1" name="A empresa está no ICP?"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-95_F2</bpmn:incoming><bpmn:outgoing>P-95_F3</bpmn:outgoing><bpmn:outgoing>P-95_F5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P-95_t2" name="Avisar o cliente e o parceiro de que o diagnóstico não se aplica"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Confirmado</bpmn:documentation><bpmn:incoming>P-95_F3</bpmn:incoming><bpmn:outgoing>P-95_F4</bpmn:outgoing></bpmn:userTask>
    <bpmn:task id="P-95_t3" name="Conduzir a reunião de diagnóstico pelo roteiro"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-95_F5</bpmn:incoming><bpmn:outgoing>P-95_F6</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="P-95_t4" name="Entregar o mapa de planejamento"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-95_F6</bpmn:incoming><bpmn:outgoing>P-95_F7</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P-95_t5" name="Liberar o acesso ao Wise Hub"><bpmn:documentation>sistema: Wise Hub; status: Confirmado</bpmn:documentation><bpmn:incoming>P-95_F7</bpmn:incoming><bpmn:outgoing>P-95_F8</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P-95_g2" name="O cliente autorizou o resumo ao parceiro?"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-95_F8</bpmn:incoming><bpmn:outgoing>P-95_F9</bpmn:outgoing><bpmn:outgoing>P-95_F10</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P-95_t6" name="Enviar o resumo ao parceiro"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Confirmado</bpmn:documentation><bpmn:incoming>P-95_F9</bpmn:incoming><bpmn:outgoing>P-95_F11</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P-95_g3" name="O cliente pediu para seguir com a Wise?"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-95_F10</bpmn:incoming><bpmn:incoming>P-95_F11</bpmn:incoming><bpmn:outgoing>P-95_F12</bpmn:outgoing><bpmn:outgoing>P-95_F13</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P-95_t7" name="Registrar a oportunidade com a origem no parceiro"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-95_F12</bpmn:incoming><bpmn:outgoing>P-95_F14</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P-95_f1" name="Diagnóstico não aplicável"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-95_F4</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-95_f2" name="Diagnóstico entregue"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-95_F13</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-95_f3" name="Oportunidade aberta"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-95_F14</bpmn:incoming></bpmn:endEvent>

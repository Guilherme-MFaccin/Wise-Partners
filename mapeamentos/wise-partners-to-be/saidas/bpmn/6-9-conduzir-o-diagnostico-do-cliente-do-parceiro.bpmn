        <bpmn:flowNodeRef>P-95_f3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-95_i1" name="Cliente se cadastra pelo link do parceiro"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:outgoing>P-95_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="P-95_t1" name="Registrar o cadastro com a origem no parceiro"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-95_F1</bpmn:incoming><bpmn:outgoing>P-95_F2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P-95_g1" name="A empresa está no ICP da Wise?"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-95_F2</bpmn:incoming><bpmn:outgoing>P-95_F3</bpmn:outgoing><bpmn:outgoing>P-95_F7</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P-95_t2" name="Liberar o autodiagnóstico na hora"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-95_F3</bpmn:incoming><bpmn:outgoing>P-95_F4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P-95_t3" name="Mostrar o resultado e o link do Wise Hub"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-95_F4</bpmn:incoming><bpmn:outgoing>P-95_F5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P-95_t4" name="Enviar o resultado e um próximo passo por e-mail"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-95_F5</bpmn:incoming><bpmn:outgoing>P-95_F6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P-95_t5" name="Liberar a agenda para a reunião"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-95_F7</bpmn:incoming><bpmn:outgoing>P-95_F8</bpmn:outgoing></bpmn:serviceTask>

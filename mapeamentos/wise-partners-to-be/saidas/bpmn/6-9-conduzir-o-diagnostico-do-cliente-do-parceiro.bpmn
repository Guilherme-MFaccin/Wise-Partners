    <bpmn:exclusiveGateway id="P-95_g3" name="O cliente autorizou mostrar o resultado ao parceiro?"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-95_F16</bpmn:incoming><bpmn:outgoing>P-95_F17</bpmn:outgoing><bpmn:outgoing>P-95_F19</bpmn:outgoing></bpmn:exclusiveGateway>

  <bpmn:collaboration id="Collaboration_P-95">
    <bpmn:participant id="Participant_P-95" name="6.9 Conduzir o diagnóstico do cliente do parceiro" processRef="Process_P-95" />
    <bpmn:participant id="Ext_P-95_X1" name="Parceiro" />
    <bpmn:participant id="Ext_P-95_X2" name="Cliente do parceiro" />

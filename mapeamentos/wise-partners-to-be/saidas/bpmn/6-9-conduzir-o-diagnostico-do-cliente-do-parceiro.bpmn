    <bpmn:exclusiveGateway id="P-95_g2" name="Mais de 10 reuniões na semana?"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-95_F9</bpmn:incoming><bpmn:outgoing>P-95_F10</bpmn:outgoing><bpmn:outgoing>P-95_F12</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="P-95_t6" name="Passar a reunião a outra pessoa da Wise"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-95_F10</bpmn:incoming><bpmn:outgoing>P-95_F11</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-95_t7" name="Conduzir a reunião de diagnóstico pela Matriz 5x5"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-95_F11</bpmn:incoming><bpmn:incoming>P-95_F12</bpmn:incoming><bpmn:outgoing>P-95_F13</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-95_t8" name="Aplicar a pesquisa, se aprovada pelo CEP e consentida"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-95_F13</bpmn:incoming><bpmn:outgoing>P-95_F14</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-95_t9" name="Enviar o mapa da reunião em até 2 dias úteis"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-95_F14</bpmn:incoming><bpmn:outgoing>P-95_F15</bpmn:outgoing></bpmn:task>

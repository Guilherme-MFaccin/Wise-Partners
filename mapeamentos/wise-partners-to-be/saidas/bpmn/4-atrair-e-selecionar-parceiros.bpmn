<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-20" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-20">
    <bpmn:participant id="Participant_P-20" name="4 Atrair e selecionar parceiros" processRef="Process_P-20" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-20" name="4 Atrair e selecionar parceiros" isExecutable="false">
    <bpmn:documentation>Da campanha de aquisição ao parceiro com acesso. Todo parceiro entra pelo mesmo caminho, sem exceção: anúncio da campanha, landing page, cadastro com aceite do termo e da política, fila no portal, contato do Gerente pelo WhatsApp, link da agenda, confirmação do horário na véspera e no dia, e a conversa de entrada, em que a conta é criada. A fila existe para que concorrentes e pessoas sem interesse não tenham acesso ao que a Wise oferece. O processo serve a qualquer tipo de parceiro; só a campanha muda (hoje, software de gestão, com CRM e ERP à frente). No portal: recebe o cadastro na fila, avisa os administradores, guarda a origem da campanha e registra cada mudança de situação até a aprovação. [status do fluxo: Confirmado; evidências: EV-0331, EV-0332]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-20">
      <bpmn:lane id="Lane_P-20_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-20_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-20_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-20_g0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-20_s0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-20_s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-20_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-20_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-20_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-20_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-20_s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-20_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-20_f0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-20_f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-20_f2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-20_f3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-20_PA-05" name="Responsável nomeado no parceiro">
        <bpmn:flowNodeRef>P-20_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-20_t5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-20_i1" name="Cadastro com aceite enviado pela landing page"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:outgoing>P-20_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="P-20_t1" name="Colocar o cadastro na fila e avisar os administradores"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-20_F1</bpmn:incoming><bpmn:outgoing>P-20_F2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:task id="P-20_t2" name="Chamar o candidato pelo WhatsApp em até 24 horas úteis"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Confirmado</bpmn:documentation><bpmn:incoming>P-20_F2</bpmn:incoming><bpmn:outgoing>P-20_F3</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="P-20_g0" name="O candidato respondeu?"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-20_F3</bpmn:incoming><bpmn:outgoing>P-20_F4</bpmn:outgoing><bpmn:outgoing>P-20_F6</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:subProcess id="P-20_s0" name="Nutrir candidato"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-20_F4</bpmn:incoming><bpmn:outgoing>P-20_F5</bpmn:outgoing></bpmn:subProcess>
    <bpmn:subProcess id="P-20_s1" name="Qualificar o candidato pelo WhatsApp"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-20_F6</bpmn:incoming><bpmn:outgoing>P-20_F7</bpmn:outgoing></bpmn:subProcess>
    <bpmn:exclusiveGateway id="P-20_g1" name="Cumpre os critérios da fila?"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-20_F7</bpmn:incoming><bpmn:outgoing>P-20_F8</bpmn:outgoing><bpmn:outgoing>P-20_F10</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P-20_t3" name="Descartar o cadastro com o motivo"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-20_F8</bpmn:incoming><bpmn:outgoing>P-20_F9</bpmn:outgoing></bpmn:userTask>
    <bpmn:task id="P-20_t4" name="Enviar o link da agenda"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Confirmado</bpmn:documentation><bpmn:incoming>P-20_F10</bpmn:incoming><bpmn:outgoing>P-20_F11</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-20_t5" name="Marcar o horário na agenda"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-20_F11</bpmn:incoming><bpmn:outgoing>P-20_F12</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-20_t6" name="Confirmar o horário na véspera e no dia"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Confirmado</bpmn:documentation><bpmn:incoming>P-20_F12</bpmn:incoming><bpmn:outgoing>P-20_F13</bpmn:outgoing></bpmn:task>
    <bpmn:subProcess id="P-20_s2" name="Conduzir a conversa de entrada"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-20_F13</bpmn:incoming><bpmn:outgoing>P-20_F14</bpmn:outgoing></bpmn:subProcess>
    <bpmn:exclusiveGateway id="P-20_g2" name="O candidato quer seguir?"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-20_F14</bpmn:incoming><bpmn:outgoing>P-20_F15</bpmn:outgoing><bpmn:outgoing>P-20_F16</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="P-20_f0" name="Candidato em nutrição"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-20_F5</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-20_f1" name="Cadastro descartado"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-20_F9</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-20_f2" name="Candidato sem interesse"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-20_F15</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-20_f3" name="Parceiro Select com acesso ao portal"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-20_F16</bpmn:incoming></bpmn:endEvent>

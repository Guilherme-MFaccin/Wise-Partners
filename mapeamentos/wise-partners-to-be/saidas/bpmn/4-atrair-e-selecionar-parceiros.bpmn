        <bpmn:flowNodeRef>P-20_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-20_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-20_s4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-20_g5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-20_f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-20_f2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-20_f3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-20_f4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-20_PA-06" name="Candidato a parceiro">
        <bpmn:flowNodeRef>P-20_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-20_t5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-20_i1" name="Cadastro com aceite enviado pela landing page"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-20_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:subProcess id="P-20_s1" name="Receber o cadastro com o aceite"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-20_F1</bpmn:incoming><bpmn:outgoing>P-20_F2</bpmn:outgoing></bpmn:subProcess>
    <bpmn:userTask id="P-20_t1" name="Conferir o cadastro e o site do candidato"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-20_F2</bpmn:incoming><bpmn:outgoing>P-20_F3</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P-20_g1" name="É concorrente evidente ou cadastro inválido?"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-20_F3</bpmn:incoming><bpmn:outgoing>P-20_F4</bpmn:outgoing><bpmn:outgoing>P-20_F6</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P-20_t2" name="Descartar o cadastro com o motivo"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-20_F4</bpmn:incoming><bpmn:incoming>P-20_F14</bpmn:incoming><bpmn:outgoing>P-20_F5</bpmn:outgoing></bpmn:userTask>
    <bpmn:task id="P-20_t3" name="Chamar o candidato pelo WhatsApp em até 24 horas úteis"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Hipótese</bpmn:documentation><bpmn:incoming>P-20_F6</bpmn:incoming><bpmn:outgoing>P-20_F7</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="P-20_g2" name="O candidato respondeu?"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-20_F7</bpmn:incoming><bpmn:outgoing>P-20_F8</bpmn:outgoing><bpmn:outgoing>P-20_F12</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:subProcess id="P-20_s2" name="Retomar candidato sem resposta"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-20_F8</bpmn:incoming><bpmn:outgoing>P-20_F9</bpmn:outgoing></bpmn:subProcess>
    <bpmn:exclusiveGateway id="P-20_g3" name="O candidato voltou a responder?"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-20_F9</bpmn:incoming><bpmn:outgoing>P-20_F10</bpmn:outgoing><bpmn:outgoing>P-20_F11</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:subProcess id="P-20_s3" name="Qualificar o candidato pelo WhatsApp"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-20_F11</bpmn:incoming><bpmn:incoming>P-20_F12</bpmn:incoming><bpmn:outgoing>P-20_F13</bpmn:outgoing></bpmn:subProcess>
    <bpmn:exclusiveGateway id="P-20_g4" name="Cumpre os critérios da fila?"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-20_F13</bpmn:incoming><bpmn:outgoing>P-20_F14</bpmn:outgoing><bpmn:outgoing>P-20_F15</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="P-20_t4" name="Enviar o link da agenda"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Hipótese</bpmn:documentation><bpmn:incoming>P-20_F15</bpmn:incoming><bpmn:incoming>P-20_F22</bpmn:incoming><bpmn:outgoing>P-20_F16</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-20_t5" name="Marcar o horário na agenda"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-20_F16</bpmn:incoming><bpmn:outgoing>P-20_F17</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-20_t6" name="Confirmar o horário na véspera e no dia"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Hipótese</bpmn:documentation><bpmn:incoming>P-20_F17</bpmn:incoming><bpmn:outgoing>P-20_F18</bpmn:outgoing></bpmn:task>
    <bpmn:subProcess id="P-20_s4" name="Conduzir a conversa de entrada"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-20_F18</bpmn:incoming><bpmn:outgoing>P-20_F19</bpmn:outgoing></bpmn:subProcess>
    <bpmn:exclusiveGateway id="P-20_g5" name="Como terminou a conversa?"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-20_F19</bpmn:incoming><bpmn:outgoing>P-20_F20</bpmn:outgoing><bpmn:outgoing>P-20_F21</bpmn:outgoing><bpmn:outgoing>P-20_F22</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="P-20_f1" name="Cadastro descartado"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-20_F5</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-20_f2" name="Candidato sem resposta"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-20_F10</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-20_f3" name="Candidato sem interesse ou não aprovado"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-20_F21</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-20_f4" name="Parceiro Select com acesso ao portal"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-20_F20</bpmn:incoming></bpmn:endEvent>

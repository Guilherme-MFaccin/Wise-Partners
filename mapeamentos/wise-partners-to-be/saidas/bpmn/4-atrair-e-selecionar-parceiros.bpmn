<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-20" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-20">
    <bpmn:participant id="Participant_P-20" name="4 Atrair e selecionar parceiros" processRef="Process_P-20" />
    <bpmn:participant id="Ext_P-20_X1" name="Empresa candidata" />
    <bpmn:messageFlow id="P-20_M1" name="Convite" sourceRef="P-20_t1" targetRef="Ext_P-20_X1" />
    <bpmn:messageFlow id="P-20_M2" name="Resposta" sourceRef="Ext_P-20_X1" targetRef="P-20_e1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-20" name="4 Atrair e selecionar parceiros" isExecutable="false">
    <bpmn:documentation>Do candidato na lista ao termo assinado. No portal: mantém a lista, transforma o candidato em card na primeira reunião e guarda a ficha, o scorecard e o texto único. [status do fluxo: Confirmado; evidências: EV-0167, EV-0168, EV-0169]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-20">
      <bpmn:lane id="Lane_P-20_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-20_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-20_s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-20_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-20_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-20_s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-20_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-20_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-20_s3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-20_s4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-20_s5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-20_f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-20_f2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-20_f3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-20_PA-02" name="Diretor">
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-20_i1" name="Candidato identificado"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:outgoing>P-20_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:subProcess id="P-20_s1" name="Manter a lista de candidatos"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-20_F1</bpmn:incoming><bpmn:outgoing>P-20_F2</bpmn:outgoing></bpmn:subProcess>
    <bpmn:userTask id="P-20_t1" name="Agendar a primeira reunião"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Confirmado</bpmn:documentation><bpmn:incoming>P-20_F2</bpmn:incoming><bpmn:outgoing>P-20_F3</bpmn:outgoing></bpmn:userTask>
    <bpmn:intermediateCatchEvent id="P-20_e1" name="Resposta do candidato"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-20_F3</bpmn:incoming><bpmn:outgoing>P-20_F4</bpmn:outgoing><bpmn:messageEventDefinition id="P-20_e1_def" /></bpmn:intermediateCatchEvent>
    <bpmn:subProcess id="P-20_s2" name="Qualificar candidato"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-20_F4</bpmn:incoming><bpmn:outgoing>P-20_F5</bpmn:outgoing></bpmn:subProcess>
    <bpmn:exclusiveGateway id="P-20_g1" name="Candidato elegível?"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-20_F5</bpmn:incoming><bpmn:outgoing>P-20_F6</bpmn:outgoing><bpmn:outgoing>P-20_F7</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="P-20_g2" name="Candidato quer seguir agora?"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-20_F6</bpmn:incoming><bpmn:outgoing>P-20_F8</bpmn:outgoing><bpmn:outgoing>P-20_F9</bpmn:outgoing><bpmn:outgoing>P-20_F10</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:subProcess id="P-20_s3" name="Nutrir candidato"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-20_F9</bpmn:incoming><bpmn:outgoing>P-20_F11</bpmn:outgoing></bpmn:subProcess>
    <bpmn:subProcess id="P-20_s4" name="Conduzir o workshop de alinhamento"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-20_F8</bpmn:incoming><bpmn:incoming>P-20_F11</bpmn:incoming><bpmn:outgoing>P-20_F12</bpmn:outgoing></bpmn:subProcess>
    <bpmn:subProcess id="P-20_s5" name="Negociar e formalizar o termo"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-20_F12</bpmn:incoming><bpmn:outgoing>P-20_F13</bpmn:outgoing></bpmn:subProcess>
    <bpmn:endEvent id="P-20_f1" name="Candidato não elegível"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-20_F7</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-20_f2" name="Candidato sem interesse"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-20_F10</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-20_f3" name="Termo assinado"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-20_F13</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-20_F1" name="" sourceRef="P-20_i1" targetRef="P-20_s1" />
    <bpmn:sequenceFlow id="P-20_F2" name="" sourceRef="P-20_s1" targetRef="P-20_t1" />
    <bpmn:sequenceFlow id="P-20_F3" name="" sourceRef="P-20_t1" targetRef="P-20_e1" />
    <bpmn:sequenceFlow id="P-20_F4" name="" sourceRef="P-20_e1" targetRef="P-20_s2" />
    <bpmn:sequenceFlow id="P-20_F5" name="" sourceRef="P-20_s2" targetRef="P-20_g1" />
    <bpmn:sequenceFlow id="P-20_F6" name="Sim" sourceRef="P-20_g1" targetRef="P-20_g2" />
    <bpmn:sequenceFlow id="P-20_F7" name="Não" sourceRef="P-20_g1" targetRef="P-20_f1" />
    <bpmn:sequenceFlow id="P-20_F8" name="Sim" sourceRef="P-20_g2" targetRef="P-20_s4" />
    <bpmn:sequenceFlow id="P-20_F9" name="Agora não" sourceRef="P-20_g2" targetRef="P-20_s3" />
    <bpmn:sequenceFlow id="P-20_F10" name="Não" sourceRef="P-20_g2" targetRef="P-20_f2" />
    <bpmn:sequenceFlow id="P-20_F11" name="" sourceRef="P-20_s3" targetRef="P-20_s4" />
    <bpmn:sequenceFlow id="P-20_F12" name="" sourceRef="P-20_s4" targetRef="P-20_s5" />
    <bpmn:sequenceFlow id="P-20_F13" name="" sourceRef="P-20_s5" targetRef="P-20_f3" />
  </bpmn:process>

  <bpmn:collaboration id="Collaboration_P-84">
    <bpmn:participant id="Participant_P-84" name="8.2.3 Abrir a mentoria mensal à carteira dos parceiros" processRef="Process_P-84" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-84" name="8.2.3 Abrir a mentoria mensal à carteira dos parceiros" isExecutable="false">
    <bpmn:documentation>Calendário da mentoria mensal da Wise aberto às carteiras dos parceiros Premium e Elite. No portal: envia os convites. [status do fluxo: Hipótese; evidências: nenhuma]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-84">
      <bpmn:lane id="Lane_P-84_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-84_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-84_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-84_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-84_f1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-84_PA-05" name="Responsável nomeado no parceiro">
        <bpmn:flowNodeRef>P-84_t2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-84_i1" name="Calendário mensal da mentoria"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-84_F1</bpmn:outgoing><bpmn:timerEventDefinition id="P-84_i1_def" /></bpmn:startEvent>
    <bpmn:serviceTask id="P-84_t1" name="Enviar o convite aos parceiros Premium e Elite, com o link de cada um"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-84_F1</bpmn:incoming><bpmn:outgoing>P-84_F2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:task id="P-84_t2" name="Repassar o convite à própria base"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-84_F2</bpmn:incoming><bpmn:outgoing>P-84_F3</bpmn:outgoing></bpmn:task>
    <bpmn:serviceTask id="P-84_t3" name="Registrar os clientes de cada parceiro que participaram"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-84_F3</bpmn:incoming><bpmn:outgoing>P-84_F4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="P-84_f1" name="Mentoria do mês aberta à carteira dos parceiros"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-84_F4</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-84_F1" name="" sourceRef="P-84_i1" targetRef="P-84_t1" />
    <bpmn:sequenceFlow id="P-84_F2" name="" sourceRef="P-84_t1" targetRef="P-84_t2" />
    <bpmn:sequenceFlow id="P-84_F3" name="" sourceRef="P-84_t2" targetRef="P-84_t3" />
    <bpmn:sequenceFlow id="P-84_F4" name="" sourceRef="P-84_t3" targetRef="P-84_f1" />
  </bpmn:process>

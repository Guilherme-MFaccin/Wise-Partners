<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-13" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-13">
    <bpmn:participant id="Participant_P-13" name="2.5 Publicar mudança de regra" processRef="Process_P-13" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-13" name="2.5 Publicar mudança de regra" isExecutable="false">
    <bpmn:documentation>Publicar cada mudança de regra com vigência mínima de 30 dias, depois da aprovação do Diretor, e avisar os parceiros. No portal: versiona a regra, registra a publicação e aplica a regra nova na data. [status do fluxo: Hipótese; evidências: nenhuma]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-13">
      <bpmn:lane id="Lane_P-13_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-13_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-13_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-13_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-13_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-13_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-13_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-13_f1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-13_i1" name="Texto novo de regra, regulamento ou termo aprovado"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-13_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P-13_t1" name="Registrar a nova versão com vigência em 30 dias"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-13_F1</bpmn:incoming><bpmn:outgoing>P-13_F2</bpmn:outgoing></bpmn:userTask>
    <bpmn:task id="P-13_t2" name="Avisar os parceiros no grupo de cada um"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Hipótese</bpmn:documentation><bpmn:incoming>P-13_F2</bpmn:incoming><bpmn:outgoing>P-13_F3</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-13_t3" name="Enviar a mudança para o comunicado do mês"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-13_F3</bpmn:incoming><bpmn:outgoing>P-13_F4</bpmn:outgoing></bpmn:task>
    <bpmn:intermediateCatchEvent id="P-13_e1" name="30 dias"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-13_F4</bpmn:incoming><bpmn:outgoing>P-13_F5</bpmn:outgoing><bpmn:timerEventDefinition id="P-13_e1_def" /></bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="P-13_t4" name="Aplicar a regra nova"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-13_F5</bpmn:incoming><bpmn:outgoing>P-13_F6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="P-13_f1" name="Regra nova em vigor"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-13_F6</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-13_F1" name="" sourceRef="P-13_i1" targetRef="P-13_t1" />
    <bpmn:sequenceFlow id="P-13_F2" name="" sourceRef="P-13_t1" targetRef="P-13_t2" />
    <bpmn:sequenceFlow id="P-13_F3" name="" sourceRef="P-13_t2" targetRef="P-13_t3" />
    <bpmn:sequenceFlow id="P-13_F4" name="" sourceRef="P-13_t3" targetRef="P-13_e1" />
    <bpmn:sequenceFlow id="P-13_F5" name="" sourceRef="P-13_e1" targetRef="P-13_t4" />
    <bpmn:sequenceFlow id="P-13_F6" name="" sourceRef="P-13_t4" targetRef="P-13_f1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_P-13">
    <bpmndi:BPMNPlane id="BPMNPlane_P-13" bpmnElement="Collaboration_P-13">
      <bpmndi:BPMNShape id="Participant_P-13_di" bpmnElement="Participant_P-13" isHorizontal="true"><dc:Bounds x="0" y="0" width="1352" height="148" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_P-13_PA-01_di" bpmnElement="Lane_P-13_PA-01" isHorizontal="true"><dc:Bounds x="30" y="0" width="1322" height="148" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-13_i1_di" bpmnElement="P-13_i1" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="160" y="56" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="123" y="98" width="110" height="42" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-17" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-17">
    <bpmn:participant id="Participant_P-17" name="2.1 Tratar a fila diária de exceções" processRef="Process_P-17" />
    <bpmn:participant id="Ext_P-17_X1" name="Executor (consultor, comercial, financeiro ou parceiro)" />
    <bpmn:messageFlow id="P-17_M1" name="Pedido com prazo" sourceRef="P-17_t3" targetRef="Ext_P-17_X1" />
    <bpmn:messageFlow id="P-17_M2" name="Retorno" sourceRef="Ext_P-17_X1" targetRef="P-17_e1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-17" name="2.1 Tratar a fila diária de exceções" isExecutable="false">
    <bpmn:documentation>Abrir a fila única, ordenada por prazo, com o que fugiu da regra: SLA vencendo, marco atrasado, régua atrasada, parceiro em risco, pedido parado. O Gerente é dono de tudo e cobra quem executa pelo WhatsApp. [status do fluxo: Hipótese; evidências: EV-0095, EV-0025, EV-0005, EV-0154]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-17">
      <bpmn:lane id="Lane_P-17_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-17_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-17_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-17_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-17_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-17_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-17_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-17_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-17_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-17_f1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-17_i1" name="Início do dia de trabalho no programa"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-17_F1</bpmn:outgoing><bpmn:timerEventDefinition id="P-17_i1_def" /></bpmn:startEvent>
    <bpmn:userTask id="P-17_t1" name="Abrir a fila ordenada por prazo"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-17_F1</bpmn:incoming><bpmn:incoming>P-17_F9</bpmn:incoming><bpmn:outgoing>P-17_F2</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P-17_g1" name="Quem executa a tarefa?"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-17_F2</bpmn:incoming><bpmn:outgoing>P-17_F3</bpmn:outgoing><bpmn:outgoing>P-17_F4</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P-17_t2" name="Concluir a tarefa e registrar o resultado"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-17_F3</bpmn:incoming><bpmn:outgoing>P-17_F7</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P-17_t3" name="Cobrar o executor com a mensagem pronta"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Hipótese</bpmn:documentation><bpmn:incoming>P-17_F4</bpmn:incoming><bpmn:outgoing>P-17_F5</bpmn:outgoing></bpmn:userTask>
    <bpmn:intermediateCatchEvent id="P-17_e1" name="Retorno do executor"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-17_F5</bpmn:incoming><bpmn:outgoing>P-17_F6</bpmn:outgoing><bpmn:messageEventDefinition id="P-17_e1_def" /></bpmn:intermediateCatchEvent>
    <bpmn:userTask id="P-17_t4" name="Registrar o retorno na tarefa"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-17_F6</bpmn:incoming><bpmn:outgoing>P-17_F8</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P-17_g2" name="Ainda há tarefa vencendo hoje?"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-17_F7</bpmn:incoming><bpmn:incoming>P-17_F8</bpmn:incoming><bpmn:outgoing>P-17_F9</bpmn:outgoing><bpmn:outgoing>P-17_F10</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="P-17_f1" name="Fila do dia tratada"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-17_F10</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-17_F1" name="" sourceRef="P-17_i1" targetRef="P-17_t1" />
    <bpmn:sequenceFlow id="P-17_F2" name="" sourceRef="P-17_t1" targetRef="P-17_g1" />
    <bpmn:sequenceFlow id="P-17_F3" name="O Gerente" sourceRef="P-17_g1" targetRef="P-17_t2" />
    <bpmn:sequenceFlow id="P-17_F4" name="Consultor, comercial, financeiro ou parceiro" sourceRef="P-17_g1" targetRef="P-17_t3" />
    <bpmn:sequenceFlow id="P-17_F5" name="" sourceRef="P-17_t3" targetRef="P-17_e1" />
    <bpmn:sequenceFlow id="P-17_F6" name="" sourceRef="P-17_e1" targetRef="P-17_t4" />
    <bpmn:sequenceFlow id="P-17_F7" name="" sourceRef="P-17_t2" targetRef="P-17_g2" />
    <bpmn:sequenceFlow id="P-17_F8" name="" sourceRef="P-17_t4" targetRef="P-17_g2" />
    <bpmn:sequenceFlow id="P-17_F9" name="Sim" sourceRef="P-17_g2" targetRef="P-17_t1" />
    <bpmn:sequenceFlow id="P-17_F10" name="Não" sourceRef="P-17_g2" targetRef="P-17_f1" />
  </bpmn:process>

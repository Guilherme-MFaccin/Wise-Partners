<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-94" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-94">
    <bpmn:participant id="Participant_P-94" name="5.2 Conduzir o onboarding por etapas" processRef="Process_P-94" />
    <bpmn:participant id="Ext_P-94_X2" name="Cliente do parceiro" />
    <bpmn:messageFlow id="P-94_M1" name="Cadastro pelo link" sourceRef="Ext_P-94_X2" targetRef="P-94_e1" />
    <bpmn:messageFlow id="P-94_M2" name="Diagnóstico feito" sourceRef="Ext_P-94_X2" targetRef="P-94_e2" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-94" name="5.2 Conduzir o onboarding por etapas" isExecutable="false">
    <bpmn:documentation>Etapas e metas do Select, sem contar dias: primeiro login, feito na conversa; minicurso assistido; anúncio conjunto da parceria publicado; link e mensagem pronta enviados para a base; primeiro cliente cadastrado pelo link (ativação); primeiro diagnóstico feito na base do parceiro. A ordem é sugerida, não obrigatória. O Premium e o Elite têm entrada própria. No portal: cria as etapas, marca sozinho as que consegue ver (login, minicurso, cliente, diagnóstico), deixa o parceiro marcar as outras e mostra a ele o que falta. [status do fluxo: Hipótese; evidências: nenhuma]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-94">
      <bpmn:lane id="Lane_P-94_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-94_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-94_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-94_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-94_s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-94_e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-94_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-94_f1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-94_PA-05" name="Responsável nomeado no parceiro">
        <bpmn:flowNodeRef>P-94_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-94_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-94_t4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-94_i1" name="Parceiro com grupo, link, minicurso e Hub"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-94_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="P-94_t1" name="Criar as etapas do onboarding do Select"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-94_F1</bpmn:incoming><bpmn:outgoing>P-94_F2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:task id="P-94_t2" name="Assistir ao minicurso de como vender a Wise"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-94_F2</bpmn:incoming><bpmn:outgoing>P-94_F3</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-94_t3" name="Publicar o anúncio conjunto da parceria e marcar no portal"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-94_F3</bpmn:incoming><bpmn:outgoing>P-94_F4</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-94_t4" name="Enviar o link e a mensagem pronta para a base e marcar no portal"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-94_F4</bpmn:incoming><bpmn:outgoing>P-94_F5</bpmn:outgoing></bpmn:task>
    <bpmn:intermediateCatchEvent id="P-94_e1" name="Primeiro cliente cadastrado pelo link"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-94_F5</bpmn:incoming><bpmn:outgoing>P-94_F6</bpmn:outgoing><bpmn:messageEventDefinition id="P-94_e1_def" /></bpmn:intermediateCatchEvent>
    <bpmn:subProcess id="P-94_s1" name="Declarar a ativação"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-94_F6</bpmn:incoming><bpmn:outgoing>P-94_F7</bpmn:outgoing></bpmn:subProcess>
    <bpmn:intermediateCatchEvent id="P-94_e2" name="Primeiro diagnóstico feito na base do parceiro"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-94_F7</bpmn:incoming><bpmn:outgoing>P-94_F8</bpmn:outgoing><bpmn:messageEventDefinition id="P-94_e2_def" /></bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="P-94_t5" name="Marcar o onboarding como concluído"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-94_F8</bpmn:incoming><bpmn:outgoing>P-94_F9</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="P-94_f1" name="Onboarding do Select concluído"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-94_F9</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-94_F1" name="" sourceRef="P-94_i1" targetRef="P-94_t1" />
    <bpmn:sequenceFlow id="P-94_F2" name="" sourceRef="P-94_t1" targetRef="P-94_t2" />
    <bpmn:sequenceFlow id="P-94_F3" name="" sourceRef="P-94_t2" targetRef="P-94_t3" />
    <bpmn:sequenceFlow id="P-94_F4" name="" sourceRef="P-94_t3" targetRef="P-94_t4" />
    <bpmn:sequenceFlow id="P-94_F5" name="" sourceRef="P-94_t4" targetRef="P-94_e1" />
    <bpmn:sequenceFlow id="P-94_F6" name="" sourceRef="P-94_e1" targetRef="P-94_s1" />
    <bpmn:sequenceFlow id="P-94_F7" name="" sourceRef="P-94_s1" targetRef="P-94_e2" />
    <bpmn:sequenceFlow id="P-94_F8" name="" sourceRef="P-94_e2" targetRef="P-94_t5" />
    <bpmn:sequenceFlow id="P-94_F9" name="" sourceRef="P-94_t5" targetRef="P-94_f1" />
  </bpmn:process>

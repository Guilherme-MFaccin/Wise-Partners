    <bpmn:sequenceFlow id="P-98_F6" name="" sourceRef="P-98_e1" targetRef="P-98_t5" />
    <bpmn:sequenceFlow id="P-98_F7" name="" sourceRef="P-98_t5" targetRef="P-98_g1" />
    <bpmn:sequenceFlow id="P-98_F8" name="Sim, como está" sourceRef="P-98_g1" targetRef="P-98_e1" />
    <bpmn:sequenceFlow id="P-98_F9" name="Sim, com ajustes" sourceRef="P-98_g1" targetRef="P-98_t6" />
    <bpmn:sequenceFlow id="P-98_F10" name="" sourceRef="P-98_t6" targetRef="P-98_e1" />
    <bpmn:sequenceFlow id="P-98_F11" name="Não" sourceRef="P-98_g1" targetRef="P-98_t7" />
    <bpmn:sequenceFlow id="P-98_F12" name="" sourceRef="P-98_t7" targetRef="P-98_f1" />
  </bpmn:process>

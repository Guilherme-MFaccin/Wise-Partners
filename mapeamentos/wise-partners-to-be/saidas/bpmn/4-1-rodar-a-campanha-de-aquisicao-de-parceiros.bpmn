<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-98" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-98">
    <bpmn:participant id="Participant_P-98" name="4.1 Rodar a campanha de aquisição de parceiros" processRef="Process_P-98" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-98" name="4.1 Rodar a campanha de aquisição de parceiros" isExecutable="false">
    <bpmn:documentation>Escolher o tipo de parceiro e o público, gravar os vídeos, montar os anúncios, configurar a página dos parceiros (vídeo, agenda, pixel e código de cada anúncio), pôr no ar e acompanhar toda semana o gasto e o custo por parceiro aprovado e ativado, até encerrar a campanha com o resultado registrado. No portal: guarda a configuração da página, registra a origem de cada cadastro e mostra o funil por anúncio. [status do fluxo: Hipótese; evidências: nenhuma]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-98">
      <bpmn:lane id="Lane_P-98_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-98_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-98_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-98_t5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-98_PA-02" name="Diretor">
        <bpmn:flowNodeRef>P-98_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-98_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-98_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-98_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-98_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-98_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-98_t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-98_f1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-98_i1" name="Decisão de abrir ou renovar uma campanha"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-98_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="P-98_t1" name="Escolher o tipo de parceiro e o público da campanha"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-98_F1</bpmn:incoming><bpmn:outgoing>P-98_F2</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-98_t2" name="Gravar os vídeos e montar os anúncios"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-98_F2</bpmn:incoming><bpmn:outgoing>P-98_F3</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="P-98_t3" name="Configurar a página: vídeo, agenda, pixel e código de cada anúncio"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-98_F3</bpmn:incoming><bpmn:outgoing>P-98_F4</bpmn:outgoing></bpmn:userTask>
    <bpmn:task id="P-98_t4" name="Pôr os anúncios no ar"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-98_F4</bpmn:incoming><bpmn:outgoing>P-98_F5</bpmn:outgoing></bpmn:task>
    <bpmn:intermediateCatchEvent id="P-98_e1" name="Fim de cada semana"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-98_F5</bpmn:incoming><bpmn:incoming>P-98_F8</bpmn:incoming><bpmn:incoming>P-98_F10</bpmn:incoming><bpmn:outgoing>P-98_F6</bpmn:outgoing><bpmn:timerEventDefinition id="P-98_e1_def" /></bpmn:intermediateCatchEvent>
    <bpmn:userTask id="P-98_t5" name="Informar o gasto e ler o custo por parceiro aprovado e ativado"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-98_F6</bpmn:incoming><bpmn:outgoing>P-98_F7</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P-98_g1" name="A campanha continua?"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-98_F7</bpmn:incoming><bpmn:outgoing>P-98_F8</bpmn:outgoing><bpmn:outgoing>P-98_F9</bpmn:outgoing><bpmn:outgoing>P-98_F11</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="P-98_t6" name="Ajustar ou trocar os anúncios"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-98_F9</bpmn:incoming><bpmn:outgoing>P-98_F10</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-98_t7" name="Encerrar a campanha e registrar o resultado"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-98_F11</bpmn:incoming><bpmn:outgoing>P-98_F12</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="P-98_f1" name="Campanha encerrada com resultado apurado"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-98_F12</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-98_F1" name="" sourceRef="P-98_i1" targetRef="P-98_t1" />
    <bpmn:sequenceFlow id="P-98_F2" name="" sourceRef="P-98_t1" targetRef="P-98_t2" />

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-10" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-10">
    <bpmn:participant id="Participant_P-10" name="2.2 Revisar o programa com o Igor" processRef="Process_P-10" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-10" name="2.2 Revisar o programa com o Igor" isExecutable="false">
    <bpmn:documentation>Toda semana, o Gerente e o Igor passam pelo painel da semana (poucos números estratégicos) e pela lista de casos, parceiro a parceiro, e decidem o próximo passo de cada caso. No portal: monta o painel da semana e a lista de casos (parceiros que mudaram de tipo, oportunidades paradas, decisões pendentes), cada caso com o histórico e a jogada sugerida; registra a decisão de cada caso. [status do fluxo: Confirmado; evidências: EV-0025, EV-0031, EV-0091]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-10">
      <bpmn:lane id="Lane_P-10_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-10_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-10_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-10_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-10_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-10_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-10_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-10_f1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-10_PA-02" name="Diretor">
        <bpmn:flowNodeRef>P-10_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-10_t5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-10_i1" name="Dia da conversa semanal"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:outgoing>P-10_F1</bpmn:outgoing><bpmn:timerEventDefinition id="P-10_i1_def" /></bpmn:startEvent>
    <bpmn:serviceTask id="P-10_t1" name="Montar o painel da semana e a lista de casos"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-10_F1</bpmn:incoming><bpmn:outgoing>P-10_F2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P-10_t2" name="Anotar uma proposta para cada caso"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-10_F2</bpmn:incoming><bpmn:outgoing>P-10_F3</bpmn:outgoing></bpmn:userTask>
    <bpmn:task id="P-10_t3" name="Passar pelos números do painel com o Igor"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-10_F3</bpmn:incoming><bpmn:outgoing>P-10_F4</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-10_t4" name="Discutir cada caso e decidir o próximo passo"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-10_F4</bpmn:incoming><bpmn:outgoing>P-10_F5</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="P-10_g1" name="Algum caso pede a assinatura do Igor?"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-10_F5</bpmn:incoming><bpmn:outgoing>P-10_F6</bpmn:outgoing><bpmn:outgoing>P-10_F7</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P-10_t5" name="Assinar o termo ou o aviso formal"><bpmn:documentation>sistema: Autentique; status: Confirmado</bpmn:documentation><bpmn:incoming>P-10_F6</bpmn:incoming><bpmn:outgoing>P-10_F8</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P-10_t6" name="Registrar a decisão de cada caso e criar as tarefas"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-10_F7</bpmn:incoming><bpmn:incoming>P-10_F8</bpmn:incoming><bpmn:outgoing>P-10_F9</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P-10_f1" name="Semana revisada, com decisão por caso"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-10_F9</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-10_F1" name="" sourceRef="P-10_i1" targetRef="P-10_t1" />
    <bpmn:sequenceFlow id="P-10_F2" name="" sourceRef="P-10_t1" targetRef="P-10_t2" />
    <bpmn:sequenceFlow id="P-10_F3" name="" sourceRef="P-10_t2" targetRef="P-10_t3" />
    <bpmn:sequenceFlow id="P-10_F4" name="" sourceRef="P-10_t3" targetRef="P-10_t4" />
    <bpmn:sequenceFlow id="P-10_F5" name="" sourceRef="P-10_t4" targetRef="P-10_g1" />
    <bpmn:sequenceFlow id="P-10_F6" name="Sim" sourceRef="P-10_g1" targetRef="P-10_t5" />
    <bpmn:sequenceFlow id="P-10_F7" name="Não" sourceRef="P-10_g1" targetRef="P-10_t6" />
    <bpmn:sequenceFlow id="P-10_F8" name="" sourceRef="P-10_t5" targetRef="P-10_t6" />
    <bpmn:sequenceFlow id="P-10_F9" name="" sourceRef="P-10_t6" targetRef="P-10_f1" />
  </bpmn:process>

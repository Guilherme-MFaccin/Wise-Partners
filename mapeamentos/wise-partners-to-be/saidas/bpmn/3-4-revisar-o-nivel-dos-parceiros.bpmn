<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-18" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-18">
    <bpmn:participant id="Participant_P-18" name="3.4 Revisar o nível dos parceiros" processRef="Process_P-18" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-18" name="3.4 Revisar o nível dos parceiros" isExecutable="false">
    <bpmn:documentation>No fechamento trimestral, o portal lista quem cumpre os critérios do nível acima; o Gerente avalia com o Igor os casos sem número fixo. Quem sobe para Premium passa antes pelo encontro de alinhamento; quem sobe para Elite entra no Base Ativa. Não há descida de nível: se um cliente da Wise tem problema sério com o parceiro, a Wise deixa de recomendá-lo, sem rebaixar (P-87). No portal: apura os critérios, lista os candidatos à subida e registra a decisão com o motivo. [status do fluxo: Confirmado; evidências: EV-0357, EV-0355]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-18">
      <bpmn:lane id="Lane_P-18_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-18_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-18_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-18_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-18_s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-18_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-18_s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-18_f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-18_f2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-18_f3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-18_PA-02" name="Diretor">
        <bpmn:flowNodeRef>P-18_t2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-18_i1" name="Primeiro dia útil do trimestre"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:outgoing>P-18_F1</bpmn:outgoing><bpmn:timerEventDefinition id="P-18_i1_def" /></bpmn:startEvent>
    <bpmn:serviceTask id="P-18_t1" name="Listar quem cumpre os critérios do nível acima"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-18_F1</bpmn:incoming><bpmn:outgoing>P-18_F2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:task id="P-18_t2" name="Avaliar com o Igor os casos sem critério numérico"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-18_F2</bpmn:incoming><bpmn:outgoing>P-18_F3</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="P-18_g1" name="O parceiro sobe de nível?"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-18_F3</bpmn:incoming><bpmn:outgoing>P-18_F4</bpmn:outgoing><bpmn:outgoing>P-18_F5</bpmn:outgoing><bpmn:outgoing>P-18_F7</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:subProcess id="P-18_s1" name="Conduzir a entrada no Premium"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-18_F5</bpmn:incoming><bpmn:outgoing>P-18_F6</bpmn:outgoing></bpmn:subProcess>
    <bpmn:userTask id="P-18_t3" name="Registrar a subida para Elite"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-18_F7</bpmn:incoming><bpmn:outgoing>P-18_F8</bpmn:outgoing></bpmn:userTask>
    <bpmn:subProcess id="P-18_s2" name="Conduzir o ciclo do Base Ativa"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-18_F8</bpmn:incoming><bpmn:outgoing>P-18_F9</bpmn:outgoing></bpmn:subProcess>
    <bpmn:endEvent id="P-18_f1" name="Nível mantido"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-18_F4</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-18_f2" name="Parceiro Premium"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-18_F6</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-18_f3" name="Parceiro Elite"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-18_F9</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-18_F1" name="" sourceRef="P-18_i1" targetRef="P-18_t1" />
    <bpmn:sequenceFlow id="P-18_F2" name="" sourceRef="P-18_t1" targetRef="P-18_t2" />
    <bpmn:sequenceFlow id="P-18_F3" name="" sourceRef="P-18_t2" targetRef="P-18_g1" />
    <bpmn:sequenceFlow id="P-18_F4" name="Não" sourceRef="P-18_g1" targetRef="P-18_f1" />
    <bpmn:sequenceFlow id="P-18_F5" name="Para Premium" sourceRef="P-18_g1" targetRef="P-18_s1" />
    <bpmn:sequenceFlow id="P-18_F6" name="" sourceRef="P-18_s1" targetRef="P-18_f2" />
    <bpmn:sequenceFlow id="P-18_F7" name="Para Elite" sourceRef="P-18_g1" targetRef="P-18_t3" />
    <bpmn:sequenceFlow id="P-18_F8" name="" sourceRef="P-18_t3" targetRef="P-18_s2" />
    <bpmn:sequenceFlow id="P-18_F9" name="" sourceRef="P-18_s2" targetRef="P-18_f3" />
  </bpmn:process>

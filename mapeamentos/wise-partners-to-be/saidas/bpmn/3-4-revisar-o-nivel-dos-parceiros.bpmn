  <bpmn:collaboration id="Collaboration_P-18">
    <bpmn:participant id="Participant_P-18" name="3.4 Revisar o nível dos parceiros" processRef="Process_P-18" />
    <bpmn:participant id="Ext_P-18_X1" name="Parceiro" />
    <bpmn:messageFlow id="P-18_M1" name="Aviso do que falta" sourceRef="P-18_t2" targetRef="Ext_P-18_X1" />
    <bpmn:messageFlow id="P-18_M2" name="Aviso de nível" sourceRef="P-18_t4" targetRef="Ext_P-18_X1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-18" name="3.4 Revisar o nível dos parceiros" isExecutable="false">
    <bpmn:documentation>Apurar requisitos, colocar em observação ou propor descida; a subida acontece na hora. No portal: apura os requisitos, avisa o parceiro do que falta e registra a decisão do Gerente com motivo. [status do fluxo: Confirmado; evidências: EV-0223, EV-0015]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-18">
      <bpmn:lane id="Lane_P-18_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-18_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-18_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-18_g0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-18_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-18_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-18_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-18_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-18_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-18_g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-18_f0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-18_f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-18_f2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-18_f3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-18_i1" name="Primeiro dia útil do trimestre"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:outgoing>P-18_F1</bpmn:outgoing><bpmn:timerEventDefinition id="P-18_i1_def" /></bpmn:startEvent>
    <bpmn:serviceTask id="P-18_t1" name="Apurar os requisitos de cada parceiro"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-18_F1</bpmn:incoming><bpmn:outgoing>P-18_F2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P-18_g0" name="Parceiro isento?"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-18_F2</bpmn:incoming><bpmn:outgoing>P-18_F3</bpmn:outgoing><bpmn:outgoing>P-18_F4</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="P-18_g1" name="Cumpre o nível atual?"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-18_F4</bpmn:incoming><bpmn:outgoing>P-18_F5</bpmn:outgoing><bpmn:outgoing>P-18_F6</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="P-18_g2" name="Já estava em observação?"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-18_F6</bpmn:incoming><bpmn:outgoing>P-18_F7</bpmn:outgoing><bpmn:outgoing>P-18_F9</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P-18_t2" name="Colocar em observação e avisar o que falta"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-18_F7</bpmn:incoming><bpmn:outgoing>P-18_F8</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P-18_t3" name="Propor a descida de nível"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-18_F9</bpmn:incoming><bpmn:outgoing>P-18_F10</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P-18_t4" name="Decidir a descida com motivo"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-18_F10</bpmn:incoming><bpmn:outgoing>P-18_F11</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P-18_g3" name="Descer de nível?"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-18_F11</bpmn:incoming><bpmn:outgoing>P-18_F12</bpmn:outgoing><bpmn:outgoing>P-18_F13</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="P-18_f0" name="Parceiro isento"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-18_F3</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-18_f1" name="Nível mantido"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-18_F5</bpmn:incoming><bpmn:incoming>P-18_F13</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-18_f2" name="Parceiro em observação"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-18_F8</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-18_f3" name="Nível rebaixado"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-18_F12</bpmn:incoming></bpmn:endEvent>

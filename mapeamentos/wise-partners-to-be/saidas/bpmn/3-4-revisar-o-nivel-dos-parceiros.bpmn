<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-18" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-18">
    <bpmn:participant id="Participant_P-18" name="3.4 Revisar o nível dos parceiros" processRef="Process_P-18" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-18" name="3.4 Revisar o nível dos parceiros" isExecutable="false">
    <bpmn:documentation>No fechamento trimestral, o portal lista quem cumpre os critérios do nível acima; o Gerente avalia com o Diretor os casos sem número fixo, com duas perguntas: o parceiro deu antes de pedir, e a Wise o indicaria a um cliente importante? Quem é convidado ao Premium segue para o encontro de alinhamento; quem sobe para Elite entra na fila do Base Ativa. Não há descida de nível. No portal: apura os critérios, lista os candidatos à subida e registra a decisão com o motivo. [status do fluxo: Hipótese; evidências: nenhuma]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-18">
      <bpmn:lane id="Lane_P-18_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-18_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-18_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-18_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-18_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-18_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-18_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-18_f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-18_f2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-18_PA-02" name="Diretor">
        <bpmn:flowNodeRef>P-18_t2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-18_i1" name="Primeiro dia útil do trimestre"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-18_F1</bpmn:outgoing><bpmn:timerEventDefinition id="P-18_i1_def" /></bpmn:startEvent>
    <bpmn:serviceTask id="P-18_t1" name="Listar quem cumpre os critérios do nível acima"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-18_F1</bpmn:incoming><bpmn:outgoing>P-18_F2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:task id="P-18_t2" name="Avaliar com o Gerente os casos sem critério numérico"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-18_F2</bpmn:incoming><bpmn:outgoing>P-18_F3</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="P-18_t3" name="Registrar a decisão de cada parceiro com o motivo"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-18_F3</bpmn:incoming><bpmn:outgoing>P-18_F4</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P-18_g1" name="Algum parceiro sobe?"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-18_F4</bpmn:incoming><bpmn:outgoing>P-18_F5</bpmn:outgoing><bpmn:outgoing>P-18_F6</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="P-18_t4" name="Convidar para o encontro de alinhamento quem sobe para Premium"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Hipótese</bpmn:documentation><bpmn:incoming>P-18_F6</bpmn:incoming><bpmn:outgoing>P-18_F7</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="P-18_t5" name="Pôr na fila do Base Ativa quem sobe para Elite"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-18_F7</bpmn:incoming><bpmn:outgoing>P-18_F8</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P-18_f1" name="Níveis mantidos"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-18_F5</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-18_f2" name="Convites enviados"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-18_F8</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-18_F1" name="" sourceRef="P-18_i1" targetRef="P-18_t1" />
    <bpmn:sequenceFlow id="P-18_F2" name="" sourceRef="P-18_t1" targetRef="P-18_t2" />
    <bpmn:sequenceFlow id="P-18_F3" name="" sourceRef="P-18_t2" targetRef="P-18_t3" />
    <bpmn:sequenceFlow id="P-18_F4" name="" sourceRef="P-18_t3" targetRef="P-18_g1" />
    <bpmn:sequenceFlow id="P-18_F5" name="Não" sourceRef="P-18_g1" targetRef="P-18_f1" />
    <bpmn:sequenceFlow id="P-18_F6" name="Sim" sourceRef="P-18_g1" targetRef="P-18_t4" />
    <bpmn:sequenceFlow id="P-18_F7" name="" sourceRef="P-18_t4" targetRef="P-18_t5" />
    <bpmn:sequenceFlow id="P-18_F8" name="" sourceRef="P-18_t5" targetRef="P-18_f2" />
  </bpmn:process>

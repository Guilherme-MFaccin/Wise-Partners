<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-96" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-96">
    <bpmn:participant id="Participant_P-96" name="11.4 Manter a página do cliente e o kit de convite" processRef="Process_P-96" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-96" name="11.4 Manter a página do cliente e o kit de convite" isExecutable="false">
    <bpmn:documentation>Página do cliente com as duas marcas (o parceiro sobe a logo), vídeo da Wise explicando a consultoria gratuita, cadastro de qualificação, agenda e autodiagnóstico, e a mensagem pronta para o parceiro enviar com o link dele. O Igor grava; o Gerente mantém atualizado. No portal: gera a página e a mensagem com o link exclusivo do parceiro. [status do fluxo: Hipótese; evidências: nenhuma]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-96">
      <bpmn:lane id="Lane_P-96_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-96_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-96_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-96_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-96_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-96_f1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-96_i1" name="Mudança na oferta, no vídeo, na agenda ou na regra do ICP"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-96_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P-96_t1" name="Atualizar a configuração da página do cliente"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-96_F1</bpmn:incoming><bpmn:outgoing>P-96_F2</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P-96_t2" name="Atualizar a mensagem pronta"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-96_F2</bpmn:incoming><bpmn:outgoing>P-96_F3</bpmn:outgoing></bpmn:userTask>
    <bpmn:task id="P-96_t3" name="Testar o caminho inteiro com um cadastro de teste"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-96_F3</bpmn:incoming><bpmn:outgoing>P-96_F4</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="P-96_f1" name="Página do cliente e kit de convite no ar"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-96_F4</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-96_F1" name="" sourceRef="P-96_i1" targetRef="P-96_t1" />
    <bpmn:sequenceFlow id="P-96_F2" name="" sourceRef="P-96_t1" targetRef="P-96_t2" />
    <bpmn:sequenceFlow id="P-96_F3" name="" sourceRef="P-96_t2" targetRef="P-96_t3" />
    <bpmn:sequenceFlow id="P-96_F4" name="" sourceRef="P-96_t3" targetRef="P-96_f1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_P-96">
    <bpmndi:BPMNPlane id="BPMNPlane_P-96" bpmnElement="Collaboration_P-96">

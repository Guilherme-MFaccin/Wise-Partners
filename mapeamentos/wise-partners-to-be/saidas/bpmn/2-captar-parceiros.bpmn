  </bpmn:collaboration>
  <bpmn:process id="Process_P-10" name="2 Captar parceiros" isExecutable="false">
    <bpmn:documentation>Do candidato mapeado ao termo assinado. [status do fluxo: Declarado; evidências: EV-0064, EV-0116, EV-0010]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-10">
      <bpmn:lane id="Lane_P-10_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-10_i1</bpmn:flowNodeRef>

    <bpmn:subProcess id="P-10_s0" name="Montar a lista de candidatos"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-10_F1</bpmn:incoming><bpmn:outgoing>P-10_F2</bpmn:outgoing></bpmn:subProcess>
    <bpmn:subProcess id="P-10_s1" name="Abordar candidato"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-10_F2</bpmn:incoming><bpmn:outgoing>P-10_F3</bpmn:outgoing></bpmn:subProcess>
    <bpmn:intermediateCatchEvent id="P-10_e1" name="Resposta do candidato"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-10_F3</bpmn:incoming><bpmn:outgoing>P-10_F4</bpmn:outgoing><bpmn:messageEventDefinition id="P-10_e1_def" /></bpmn:intermediateCatchEvent>

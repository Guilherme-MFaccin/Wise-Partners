    <bpmn:exclusiveGateway id="P-10_g1" name="Candidato elegível?"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-10_F6</bpmn:incoming><bpmn:outgoing>P-10_F7</bpmn:outgoing><bpmn:outgoing>P-10_F8</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="P-10_g2" name="Candidato quer seguir agora?"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-10_F7</bpmn:incoming><bpmn:outgoing>P-10_F9</bpmn:outgoing><bpmn:outgoing>P-10_F10</bpmn:outgoing><bpmn:outgoing>P-10_F11</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:subProcess id="P-10_s4" name="Nutrir candidato"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-10_F10</bpmn:incoming><bpmn:outgoing>P-10_F12</bpmn:outgoing></bpmn:subProcess>
    <bpmn:subProcess id="P-10_s5" name="Negociar e formalizar o termo"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-10_F9</bpmn:incoming><bpmn:outgoing>P-10_F13</bpmn:outgoing></bpmn:subProcess>
    <bpmn:endEvent id="P-10_f1" name="Candidato não elegível"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-10_F8</bpmn:incoming></bpmn:endEvent>

      <bpmndi:BPMNEdge id="P-27_F2_di" bpmnElement="P-27_F2"><di:waypoint x="418" y="74" /><di:waypoint x="466" y="74" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-27_F3_di" bpmnElement="P-27_F3"><di:waypoint x="594" y="74" /><di:waypoint x="642" y="74" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-27_F4_di" bpmnElement="P-27_F4"><di:waypoint x="770" y="74" /><di:waypoint x="818" y="74" /></bpmndi:BPMNEdge>

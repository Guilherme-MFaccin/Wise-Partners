      <bpmndi:BPMNShape id="P-27_t2_di" bpmnElement="P-27_t2" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="818" y="38" width="128" height="72" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-27_f1_di" bpmnElement="P-27_f1" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="1040" y="56" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1003" y="98" width="110" height="42" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>

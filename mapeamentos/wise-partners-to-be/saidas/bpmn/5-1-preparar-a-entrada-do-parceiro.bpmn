<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-27" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-27">
    <bpmn:participant id="Participant_P-27" name="5.1 Preparar a entrada do parceiro" processRef="Process_P-27" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-27" name="5.1 Preparar a entrada do parceiro" isExecutable="false">
    <bpmn:documentation>O que todo parceiro Select recebe na entrada, na própria conversa: grupo de WhatsApp na comunidade Wise Partners, certificado de parceiro Wise, Wise Hub com as duas marcas, link da página do cliente com a mensagem pronta e o minicurso de como vender a Wise. A Prateleira e a recomendação aos clientes da Wise ficam para o Premium. No portal: gera o link, a página do cliente com a logo do parceiro e os acessos. [status do fluxo: Hipótese; evidências: nenhuma]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-27">
      <bpmn:lane id="Lane_P-27_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-27_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-27_s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-27_s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-27_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-27_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-27_f1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-27_i1" name="Acesso criado na conversa de entrada"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-27_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:subProcess id="P-27_s1" name="Criar o grupo de WhatsApp do parceiro"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-27_F1</bpmn:incoming><bpmn:outgoing>P-27_F2</bpmn:outgoing></bpmn:subProcess>
    <bpmn:subProcess id="P-27_s2" name="Entregar o link da página do cliente e a mensagem pronta"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-27_F2</bpmn:incoming><bpmn:outgoing>P-27_F3</bpmn:outgoing></bpmn:subProcess>
    <bpmn:serviceTask id="P-27_t1" name="Liberar o minicurso e o kit na área do parceiro"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-27_F3</bpmn:incoming><bpmn:outgoing>P-27_F4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:task id="P-27_t2" name="Providenciar o Wise Hub com as duas marcas"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-27_F4</bpmn:incoming><bpmn:outgoing>P-27_F5</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="P-27_f1" name="Parceiro com grupo, link, minicurso e Hub"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-27_F5</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-27_F1" name="" sourceRef="P-27_i1" targetRef="P-27_s1" />
    <bpmn:sequenceFlow id="P-27_F2" name="" sourceRef="P-27_s1" targetRef="P-27_s2" />
    <bpmn:sequenceFlow id="P-27_F3" name="" sourceRef="P-27_s2" targetRef="P-27_t1" />
    <bpmn:sequenceFlow id="P-27_F4" name="" sourceRef="P-27_t1" targetRef="P-27_t2" />
    <bpmn:sequenceFlow id="P-27_F5" name="" sourceRef="P-27_t2" targetRef="P-27_f1" />
  </bpmn:process>

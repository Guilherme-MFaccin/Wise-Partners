<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-53" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-53">
    <bpmn:participant id="Participant_P-53" name="8.6 Receber parceiros em encontros pequenos" processRef="Process_P-53" />
    <bpmn:participant id="Ext_P-53_X1" name="Parceiros e convidados" />
    <bpmn:participant id="Ext_P-53_X2" name="Entidade da Parceria Institucional" />
    <bpmn:messageFlow id="P-53_M1" name="Convite ao âncora" sourceRef="P-53_t2" targetRef="Ext_P-53_X1" />
    <bpmn:messageFlow id="P-53_M2" name="Resposta" sourceRef="Ext_P-53_X1" targetRef="P-53_e0" />
    <bpmn:messageFlow id="P-53_M3" name="Convites" sourceRef="P-53_t4" targetRef="Ext_P-53_X1" />
    <bpmn:messageFlow id="P-53_M4" name="Pedido de convite" sourceRef="P-53_t4" targetRef="Ext_P-53_X2" />
    <bpmn:messageFlow id="P-53_M5" name="Confirmações" sourceRef="Ext_P-53_X1" targetRef="P-53_e1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-53" name="8.6 Receber parceiros em encontros pequenos" isExecutable="false">
    <bpmn:documentation>Encontros presenciais de seis a dez pessoas, com um convidado âncora que atrai os demais, misturando parceiros Premium e Elite (e Select com Potencial alto), clientes do grupo e gente que o parceiro quer conhecer, sem pauta de venda; também dentro de feiras e eventos do setor. As entidades da Parceria Institucional atuam como conectoras e convidam. No portal: sugere a lista de convidados pelo cubo e pelas categorias e registra presença. [status do fluxo: Confirmado; evidências: EV-0250, EV-0212, EV-0109, EV-0214]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-53">
      <bpmn:lane id="Lane_P-53_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-53_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-53_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-53_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-53_e0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-53_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-53_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-53_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-53_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-53_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-53_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-53_f1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-53_i1" name="Data do encontro do trimestre ou evento do setor"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:outgoing>P-53_F1</bpmn:outgoing><bpmn:timerEventDefinition id="P-53_i1_def" /></bpmn:startEvent>
    <bpmn:task id="P-53_t1" name="Escolher o convidado âncora"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-53_F1</bpmn:incoming><bpmn:incoming>P-53_F5</bpmn:incoming><bpmn:outgoing>P-53_F2</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="P-53_t2" name="Convidar o âncora pessoalmente"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Confirmado</bpmn:documentation><bpmn:incoming>P-53_F2</bpmn:incoming><bpmn:outgoing>P-53_F3</bpmn:outgoing></bpmn:userTask>
    <bpmn:intermediateCatchEvent id="P-53_e0" name="Resposta do âncora"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-53_F3</bpmn:incoming><bpmn:outgoing>P-53_F4</bpmn:outgoing><bpmn:messageEventDefinition id="P-53_e0_def" /></bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="P-53_g1" name="O âncora confirmou?"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-53_F4</bpmn:incoming><bpmn:outgoing>P-53_F5</bpmn:outgoing><bpmn:outgoing>P-53_F6</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P-53_t3" name="Montar a lista de seis a dez convidados"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-53_F6</bpmn:incoming><bpmn:outgoing>P-53_F7</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P-53_t4" name="Convidar pessoalmente, com a entidade conectora quando houver"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Confirmado</bpmn:documentation><bpmn:incoming>P-53_F7</bpmn:incoming><bpmn:outgoing>P-53_F8</bpmn:outgoing></bpmn:userTask>
    <bpmn:intermediateCatchEvent id="P-53_e1" name="Confirmações dos convidados"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-53_F8</bpmn:incoming><bpmn:outgoing>P-53_F9</bpmn:outgoing><bpmn:messageEventDefinition id="P-53_e1_def" /></bpmn:intermediateCatchEvent>
    <bpmn:task id="P-53_t5" name="Conduzir o encontro, sem pauta de venda"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-53_F9</bpmn:incoming><bpmn:outgoing>P-53_F10</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="P-53_t6" name="Registrar presença e as apresentações combinadas"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-53_F10</bpmn:incoming><bpmn:outgoing>P-53_F11</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P-53_f1" name="Encontro realizado"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-53_F11</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-53_F1" name="" sourceRef="P-53_i1" targetRef="P-53_t1" />
    <bpmn:sequenceFlow id="P-53_F2" name="" sourceRef="P-53_t1" targetRef="P-53_t2" />
    <bpmn:sequenceFlow id="P-53_F3" name="" sourceRef="P-53_t2" targetRef="P-53_e0" />
    <bpmn:sequenceFlow id="P-53_F4" name="" sourceRef="P-53_e0" targetRef="P-53_g1" />
    <bpmn:sequenceFlow id="P-53_F5" name="Não" sourceRef="P-53_g1" targetRef="P-53_t1" />
    <bpmn:sequenceFlow id="P-53_F6" name="Sim" sourceRef="P-53_g1" targetRef="P-53_t3" />
    <bpmn:sequenceFlow id="P-53_F7" name="" sourceRef="P-53_t3" targetRef="P-53_t4" />
    <bpmn:sequenceFlow id="P-53_F8" name="" sourceRef="P-53_t4" targetRef="P-53_e1" />
    <bpmn:sequenceFlow id="P-53_F9" name="" sourceRef="P-53_e1" targetRef="P-53_t5" />
    <bpmn:sequenceFlow id="P-53_F10" name="" sourceRef="P-53_t5" targetRef="P-53_t6" />
    <bpmn:sequenceFlow id="P-53_F11" name="" sourceRef="P-53_t6" targetRef="P-53_f1" />
  </bpmn:process>

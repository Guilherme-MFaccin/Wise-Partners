  <bpmn:collaboration id="Collaboration_P-65">
    <bpmn:participant id="Participant_P-65" name="3.2.1 Calcular o Valor" processRef="Process_P-65" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-65" name="3.2.1 Calcular o Valor" isExecutable="false">
    <bpmn:documentation>Receita ganha em 12 meses com origem no parceiro mais o pipeline aberto ponderado pela etapa. No portal: calcula todo dia. [status do fluxo: Hipótese; evidências: nenhuma]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-65">
      <bpmn:lane id="Lane_P-65_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-65_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-65_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-65_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-65_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-65_f1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-65_i1" name="Leitura diária do portal"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-65_F1</bpmn:outgoing><bpmn:timerEventDefinition id="P-65_i1_def" /></bpmn:startEvent>
    <bpmn:serviceTask id="P-65_t1" name="Somar a receita ganha em 12 meses com origem no parceiro"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-65_F1</bpmn:incoming><bpmn:outgoing>P-65_F2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P-65_t2" name="Somar o pipeline aberto ponderado pela etapa"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-65_F2</bpmn:incoming><bpmn:outgoing>P-65_F3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P-65_t3" name="Comparar o total com o corte de Valor"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-65_F3</bpmn:incoming><bpmn:outgoing>P-65_F4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="P-65_f1" name="Valor alto ou baixo"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-65_F4</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-65_F1" name="" sourceRef="P-65_i1" targetRef="P-65_t1" />
    <bpmn:sequenceFlow id="P-65_F2" name="" sourceRef="P-65_t1" targetRef="P-65_t2" />
    <bpmn:sequenceFlow id="P-65_F3" name="" sourceRef="P-65_t2" targetRef="P-65_t3" />
    <bpmn:sequenceFlow id="P-65_F4" name="" sourceRef="P-65_t3" targetRef="P-65_f1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_P-65">
    <bpmndi:BPMNPlane id="BPMNPlane_P-65" bpmnElement="Collaboration_P-65">

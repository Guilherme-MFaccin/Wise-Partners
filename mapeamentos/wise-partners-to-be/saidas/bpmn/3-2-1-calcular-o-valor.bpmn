      <bpmndi:BPMNEdge id="P-65_F2_di" bpmnElement="P-65_F2"><di:waypoint x="418" y="74" /><di:waypoint x="466" y="74" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-65_F3_di" bpmnElement="P-65_F3"><di:waypoint x="594" y="74" /><di:waypoint x="642" y="74" /></bpmndi:BPMNEdge>

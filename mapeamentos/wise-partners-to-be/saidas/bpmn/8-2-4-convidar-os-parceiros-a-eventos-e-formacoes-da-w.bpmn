<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-85" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-85">
    <bpmn:participant id="Participant_P-85" name="8.2.4 Convidar os parceiros a eventos e formações da Wise" processRef="Process_P-85" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-85" name="8.2.4 Convidar os parceiros a eventos e formações da Wise" isExecutable="false">
    <bpmn:documentation>Eventos e formações da Wise abertos como acesso de reconhecimento aos parceiros Premium e Elite. No portal: envia os convites a partir do calendário e registra presença. [status do fluxo: Hipótese; evidências: nenhuma]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-85">
      <bpmn:lane id="Lane_P-85_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-85_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-85_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-85_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-85_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-85_f1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-85_i1" name="Evento ou formação da Wise agendado"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-85_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P-85_t1" name="Escolher quem convidar entre Premium, Elite e destaques"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-85_F1</bpmn:incoming><bpmn:outgoing>P-85_F2</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P-85_t2" name="Enviar os convites"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-85_F2</bpmn:incoming><bpmn:outgoing>P-85_F3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P-85_t3" name="Registrar a presença"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-85_F3</bpmn:incoming><bpmn:outgoing>P-85_F4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="P-85_f1" name="Parceiros convidados e presença registrada"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-85_F4</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-85_F1" name="" sourceRef="P-85_i1" targetRef="P-85_t1" />
    <bpmn:sequenceFlow id="P-85_F2" name="" sourceRef="P-85_t1" targetRef="P-85_t2" />
    <bpmn:sequenceFlow id="P-85_F3" name="" sourceRef="P-85_t2" targetRef="P-85_t3" />
    <bpmn:sequenceFlow id="P-85_F4" name="" sourceRef="P-85_t3" targetRef="P-85_f1" />
  </bpmn:process>

        <bpmn:flowNodeRef>P-73_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-73_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-73_f1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-73_i1" name="Acesso criado na conversa de entrada"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-73_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="P-73_t1" name="Criar o grupo com as pessoas do parceiro"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Hipótese</bpmn:documentation><bpmn:incoming>P-73_F1</bpmn:incoming><bpmn:outgoing>P-73_F2</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-73_t2" name="Enviar a mensagem de boas-vindas com o endereço do portal"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Hipótese</bpmn:documentation><bpmn:incoming>P-73_F2</bpmn:incoming><bpmn:outgoing>P-73_F3</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="P-73_t3" name="Registrar o grupo no card do parceiro"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-73_F3</bpmn:incoming><bpmn:outgoing>P-73_F4</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P-73_f1" name="Grupo do parceiro ativo"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-73_F4</bpmn:incoming></bpmn:endEvent>

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-12" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-12">
    <bpmn:participant id="Participant_P-12" name="2.4 Conduzir o fechamento trimestral" processRef="Process_P-12" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-12" name="2.4 Conduzir o fechamento trimestral" isExecutable="false">
    <bpmn:documentation>Revisar níveis, pulso da relação, saúde do ecossistema, portões e permanência na Prateleira, e agendar as revisões conjuntas do trimestre com Premium e Elite. No portal: roda as apurações, mostra o resultado e agenda as revisões. [status do fluxo: Hipótese; evidências: nenhuma]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-12">
      <bpmn:lane id="Lane_P-12_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-12_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-12_s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-12_s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-12_s3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-12_s4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-12_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-12_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-12_f1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-12_i1" name="Primeiro dia útil do trimestre"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-12_F1</bpmn:outgoing><bpmn:timerEventDefinition id="P-12_i1_def" /></bpmn:startEvent>
    <bpmn:subProcess id="P-12_s1" name="Revisar o nível dos parceiros"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-12_F1</bpmn:incoming><bpmn:outgoing>P-12_F2</bpmn:outgoing></bpmn:subProcess>
    <bpmn:subProcess id="P-12_s2" name="Ouvir o pulso da relação"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-12_F2</bpmn:incoming><bpmn:outgoing>P-12_F3</bpmn:outgoing></bpmn:subProcess>
    <bpmn:subProcess id="P-12_s3" name="Medir a saúde do ecossistema e os portões"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-12_F3</bpmn:incoming><bpmn:outgoing>P-12_F4</bpmn:outgoing></bpmn:subProcess>
    <bpmn:subProcess id="P-12_s4" name="Revisar a permanência na Prateleira"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-12_F4</bpmn:incoming><bpmn:outgoing>P-12_F5</bpmn:outgoing></bpmn:subProcess>
    <bpmn:userTask id="P-12_t1" name="Agendar as revisões conjuntas com Premium e Elite"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-12_F5</bpmn:incoming><bpmn:outgoing>P-12_F6</bpmn:outgoing></bpmn:userTask>
    <bpmn:task id="P-12_t2" name="Enviar ao Diretor o resumo do trimestre"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-12_F6</bpmn:incoming><bpmn:outgoing>P-12_F7</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="P-12_f1" name="Trimestre fechado"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-12_F7</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-12_F1" name="" sourceRef="P-12_i1" targetRef="P-12_s1" />
    <bpmn:sequenceFlow id="P-12_F2" name="" sourceRef="P-12_s1" targetRef="P-12_s2" />
    <bpmn:sequenceFlow id="P-12_F3" name="" sourceRef="P-12_s2" targetRef="P-12_s3" />
    <bpmn:sequenceFlow id="P-12_F4" name="" sourceRef="P-12_s3" targetRef="P-12_s4" />
    <bpmn:sequenceFlow id="P-12_F5" name="" sourceRef="P-12_s4" targetRef="P-12_t1" />
    <bpmn:sequenceFlow id="P-12_F6" name="" sourceRef="P-12_t1" targetRef="P-12_t2" />
    <bpmn:sequenceFlow id="P-12_F7" name="" sourceRef="P-12_t2" targetRef="P-12_f1" />
  </bpmn:process>

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-20" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-20">
    <bpmn:participant id="Participant_P-20" name="2.4 Conduzir o fechamento trimestral" processRef="Process_P-20" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-20" name="2.4 Conduzir o fechamento trimestral" isExecutable="false">
    <bpmn:documentation>Revisar níveis, saúde das parcerias, satisfação e ranking, e preparar as revisões conjuntas e as decisões do Diretor. [status do fluxo: Declarado; evidências: EV-0099, EV-0101, EV-0200]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-20">
      <bpmn:lane id="Lane_P-20_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-20_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-20_s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-20_s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-20_s3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-20_s4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-20_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-20_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-20_f1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-20_PA-02" name="Diretor">
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-20_i1" name="Primeiro dia útil do trimestre"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:outgoing>P-20_F1</bpmn:outgoing><bpmn:timerEventDefinition id="P-20_i1_def" /></bpmn:startEvent>
    <bpmn:subProcess id="P-20_s1" name="Revisar o nível dos parceiros"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-20_F1</bpmn:incoming><bpmn:outgoing>P-20_F2</bpmn:outgoing></bpmn:subProcess>
    <bpmn:subProcess id="P-20_s2" name="Ouvir a satisfação dos parceiros"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-20_F2</bpmn:incoming><bpmn:outgoing>P-20_F3</bpmn:outgoing></bpmn:subProcess>
    <bpmn:subProcess id="P-20_s3" name="Avaliar a saúde das parcerias"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-20_F3</bpmn:incoming><bpmn:outgoing>P-20_F4</bpmn:outgoing></bpmn:subProcess>
    <bpmn:subProcess id="P-20_s4" name="Apurar o ranking e o reconhecimento"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-20_F4</bpmn:incoming><bpmn:outgoing>P-20_F5</bpmn:outgoing></bpmn:subProcess>
    <bpmn:userTask id="P-20_t1" name="Agendar as revisões conjuntas do trimestre"><bpmn:documentation>sistema: Portal Wise Partners; status: Declarado</bpmn:documentation><bpmn:incoming>P-20_F5</bpmn:incoming><bpmn:outgoing>P-20_F6</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P-20_t2" name="Enviar ao Diretor as decisões do trimestre"><bpmn:documentation>sistema: Portal Wise Partners; status: Declarado</bpmn:documentation><bpmn:incoming>P-20_F6</bpmn:incoming><bpmn:outgoing>P-20_F7</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P-20_f1" name="Trimestre fechado"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-20_F7</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-20_F1" name="" sourceRef="P-20_i1" targetRef="P-20_s1" />
    <bpmn:sequenceFlow id="P-20_F2" name="" sourceRef="P-20_s1" targetRef="P-20_s2" />
    <bpmn:sequenceFlow id="P-20_F3" name="" sourceRef="P-20_s2" targetRef="P-20_s3" />
    <bpmn:sequenceFlow id="P-20_F4" name="" sourceRef="P-20_s3" targetRef="P-20_s4" />
    <bpmn:sequenceFlow id="P-20_F5" name="" sourceRef="P-20_s4" targetRef="P-20_t1" />
    <bpmn:sequenceFlow id="P-20_F6" name="" sourceRef="P-20_t1" targetRef="P-20_t2" />
    <bpmn:sequenceFlow id="P-20_F7" name="" sourceRef="P-20_t2" targetRef="P-20_f1" />
  </bpmn:process>

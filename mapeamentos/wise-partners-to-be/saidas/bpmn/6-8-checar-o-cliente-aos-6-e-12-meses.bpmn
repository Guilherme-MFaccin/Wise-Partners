<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-39" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-39">
    <bpmn:participant id="Participant_P-39" name="6.8 Checar o cliente aos 6 e 12 meses" processRef="Process_P-39" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-39" name="6.8 Checar o cliente aos 6 e 12 meses" isExecutable="false">
    <bpmn:documentation>Tarefa do Gerente, executada pelo consultor que atende o cliente. No portal: cria a tarefa e registra o retorno. [status do fluxo: Hipótese; evidências: nenhuma]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-39">
      <bpmn:lane id="Lane_P-39_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-39_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-39_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-39_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-39_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-39_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-39_f1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-39_PA-07" name="Consultor da Wise Makers">
        <bpmn:flowNodeRef>P-39_t3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-39_i1" name="6 ou 12 meses do fechamento"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-39_F1</bpmn:outgoing><bpmn:timerEventDefinition id="P-39_i1_def" /></bpmn:startEvent>
    <bpmn:serviceTask id="P-39_t1" name="Criar a tarefa de checagem"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-39_F1</bpmn:incoming><bpmn:outgoing>P-39_F2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:task id="P-39_t2" name="Perguntar ao consultor como está o cliente"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Hipótese</bpmn:documentation><bpmn:incoming>P-39_F2</bpmn:incoming><bpmn:outgoing>P-39_F3</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-39_t3" name="Informar se o cliente continua e o resultado obtido"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-39_F3</bpmn:incoming><bpmn:outgoing>P-39_F4</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="P-39_t4" name="Registrar a checagem"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-39_F4</bpmn:incoming><bpmn:outgoing>P-39_F5</bpmn:outgoing></bpmn:userTask>
    <bpmn:task id="P-39_t5" name="Contar ao parceiro como está o cliente que ele indicou"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Hipótese</bpmn:documentation><bpmn:incoming>P-39_F5</bpmn:incoming><bpmn:outgoing>P-39_F6</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="P-39_f1" name="Checagem registrada e parceiro informado"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-39_F6</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-39_F1" name="" sourceRef="P-39_i1" targetRef="P-39_t1" />
    <bpmn:sequenceFlow id="P-39_F2" name="" sourceRef="P-39_t1" targetRef="P-39_t2" />
    <bpmn:sequenceFlow id="P-39_F3" name="" sourceRef="P-39_t2" targetRef="P-39_t3" />
    <bpmn:sequenceFlow id="P-39_F4" name="" sourceRef="P-39_t3" targetRef="P-39_t4" />
    <bpmn:sequenceFlow id="P-39_F5" name="" sourceRef="P-39_t4" targetRef="P-39_t5" />
    <bpmn:sequenceFlow id="P-39_F6" name="" sourceRef="P-39_t5" targetRef="P-39_f1" />
  </bpmn:process>

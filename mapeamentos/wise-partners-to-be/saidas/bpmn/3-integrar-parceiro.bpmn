<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-17" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-17">
    <bpmn:participant id="Participant_P-17" name="3 Integrar parceiro" processRef="Process_P-17" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-17" name="3 Integrar parceiro" isExecutable="false">
    <bpmn:documentation>Do termo assinado à ativação: primeira indicação com ICP confirmado que virou reunião. [status do fluxo: Declarado; evidências: EV-0080, EV-0119, EV-0013]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-17">
      <bpmn:lane id="Lane_P-17_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-17_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-17_s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-17_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-17_s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-17_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-17_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-17_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-17_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-17_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-17_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-17_f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-17_f2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-17_PA-05" name="Responsável nomeado no parceiro">
        <bpmn:flowNodeRef>P-17_s3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-17_i1" name="Termo assinado"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:outgoing>P-17_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:subProcess id="P-17_s1" name="Entregar os itens de entrada do pacote"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-17_F1</bpmn:incoming><bpmn:outgoing>P-17_F2</bpmn:outgoing></bpmn:subProcess>
    <bpmn:task id="P-17_t1" name="Conduzir o encontro de alinhamento"><bpmn:documentation>Até 7 dias: objetivos, proposta de valor, régua, metas dos 90 dias, link de indicação e convite para a trilha.; status: Declarado</bpmn:documentation><bpmn:incoming>P-17_F2</bpmn:incoming><bpmn:outgoing>P-17_F3</bpmn:outgoing></bpmn:task>
    <bpmn:subProcess id="P-17_s2" name="Cruzar carteiras com o parceiro"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-17_F3</bpmn:incoming><bpmn:outgoing>P-17_F4</bpmn:outgoing></bpmn:subProcess>
    <bpmn:task id="P-17_t2" name="Conduzir o encontro de vendas"><bpmn:documentation>Até 30 dias.; status: Declarado</bpmn:documentation><bpmn:incoming>P-17_F4</bpmn:incoming><bpmn:outgoing>P-17_F5</bpmn:outgoing></bpmn:task>
    <bpmn:subProcess id="P-17_s3" name="Capacitar e certificar pessoas do parceiro"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-17_F5</bpmn:incoming><bpmn:outgoing>P-17_F6</bpmn:outgoing></bpmn:subProcess>
    <bpmn:task id="P-17_t3" name="Conduzir o encontro de produto"><bpmn:documentation>Até 60 dias.; status: Declarado</bpmn:documentation><bpmn:incoming>P-17_F6</bpmn:incoming><bpmn:outgoing>P-17_F7</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-17_t4" name="Conduzir o encontro de pós-venda"><bpmn:documentation>Até 90 dias.; status: Declarado</bpmn:documentation><bpmn:incoming>P-17_F7</bpmn:incoming><bpmn:outgoing>P-17_F8</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="P-17_g1" name="Parceiro ativado em 90 dias?"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-17_F8</bpmn:incoming><bpmn:outgoing>P-17_F9</bpmn:outgoing><bpmn:outgoing>P-17_F10</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P-17_t5" name="Estender o plano até 120 dias"><bpmn:documentation>sistema: Portal Wise Partners; status: Declarado</bpmn:documentation><bpmn:incoming>P-17_F10</bpmn:incoming><bpmn:outgoing>P-17_F11</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P-17_g2" name="Parceiro ativado em 120 dias?"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-17_F11</bpmn:incoming><bpmn:outgoing>P-17_F12</bpmn:outgoing><bpmn:outgoing>P-17_F13</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="P-17_f1" name="Parceiro ativado"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-17_F9</bpmn:incoming><bpmn:incoming>P-17_F12</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-17_f2" name="Parceiro não ativado"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-17_F13</bpmn:incoming></bpmn:endEvent>

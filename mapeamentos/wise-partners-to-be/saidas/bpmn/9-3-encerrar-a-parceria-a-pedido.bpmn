<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-57" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-57">
    <bpmn:participant id="Participant_P-57" name="9.3 Encerrar a parceria a pedido" processRef="Process_P-57" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-57" name="9.3 Encerrar a parceria a pedido" isExecutable="false">
    <bpmn:documentation>Saída por decisão de qualquer das partes, com aviso de 30 dias, registrada como encerramento amigável e com o motivo para aprender. No portal: registra o motivo da saída. [status do fluxo: Hipótese; evidências: nenhuma]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-57">
      <bpmn:lane id="Lane_P-57_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-57_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-57_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-57_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-57_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-57_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-57_f1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-57_PA-05" name="Responsável nomeado no parceiro">
        <bpmn:flowNodeRef>P-57_i1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-57_i1" name="Parceiro pede para sair"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-57_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="P-57_t1" name="Conversar para entender o motivo"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Hipótese</bpmn:documentation><bpmn:incoming>P-57_F1</bpmn:incoming><bpmn:outgoing>P-57_F2</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="P-57_t2" name="Registrar o pedido e o motivo"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-57_F2</bpmn:incoming><bpmn:outgoing>P-57_F3</bpmn:outgoing></bpmn:userTask>
    <bpmn:intermediateCatchEvent id="P-57_e1" name="30 dias de aviso"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-57_F3</bpmn:incoming><bpmn:outgoing>P-57_F4</bpmn:outgoing><bpmn:timerEventDefinition id="P-57_e1_def" /></bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="P-57_t3" name="Encerrar a parceria, revogar os acessos e fechar o link"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-57_F4</bpmn:incoming><bpmn:outgoing>P-57_F5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P-57_t4" name="Pôr o ex-parceiro na lista de contato anual"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-57_F5</bpmn:incoming><bpmn:outgoing>P-57_F6</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P-57_f1" name="Parceria encerrada de forma amigável"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-57_F6</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-57_F1" name="" sourceRef="P-57_i1" targetRef="P-57_t1" />
    <bpmn:sequenceFlow id="P-57_F2" name="" sourceRef="P-57_t1" targetRef="P-57_t2" />
    <bpmn:sequenceFlow id="P-57_F3" name="" sourceRef="P-57_t2" targetRef="P-57_e1" />
    <bpmn:sequenceFlow id="P-57_F4" name="" sourceRef="P-57_e1" targetRef="P-57_t3" />
    <bpmn:sequenceFlow id="P-57_F5" name="" sourceRef="P-57_t3" targetRef="P-57_t4" />
    <bpmn:sequenceFlow id="P-57_F6" name="" sourceRef="P-57_t4" targetRef="P-57_f1" />
  </bpmn:process>

  <bpmn:collaboration id="Collaboration_P-93">
    <bpmn:participant id="Participant_P-93" name="12.3 Conceder e revogar acessos ao portal" processRef="Process_P-93" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-93" name="12.3 Conceder e revogar acessos ao portal" isExecutable="false">
    <bpmn:documentation>Usuários e permissões do portal: criar o acesso com o perfil certo, ajustar quando a função muda e revogar na saída. No portal: controla os acessos e registra quem acessou o quê. [status do fluxo: Hipótese; evidências: nenhuma]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-93">
      <bpmn:lane id="Lane_P-93_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-93_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-93_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-93_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-93_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-93_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-93_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-93_f1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-93_i1" name="Pessoa nova, mudança de função ou encerramento de parceria"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-93_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P-93_t1" name="Conferir o pedido e o perfil necessário"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-93_F1</bpmn:incoming><bpmn:outgoing>P-93_F2</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P-93_g1" name="O que é preciso?"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-93_F2</bpmn:incoming><bpmn:outgoing>P-93_F3</bpmn:outgoing><bpmn:outgoing>P-93_F5</bpmn:outgoing><bpmn:outgoing>P-93_F7</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P-93_t2" name="Criar o acesso com o perfil certo"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-93_F3</bpmn:incoming><bpmn:outgoing>P-93_F4</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P-93_t3" name="Ajustar o perfil"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-93_F5</bpmn:incoming><bpmn:outgoing>P-93_F6</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P-93_t4" name="Revogar o acesso"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-93_F7</bpmn:incoming><bpmn:outgoing>P-93_F8</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P-93_f1" name="Acessos em ordem"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-93_F4</bpmn:incoming><bpmn:incoming>P-93_F6</bpmn:incoming><bpmn:incoming>P-93_F8</bpmn:incoming></bpmn:endEvent>

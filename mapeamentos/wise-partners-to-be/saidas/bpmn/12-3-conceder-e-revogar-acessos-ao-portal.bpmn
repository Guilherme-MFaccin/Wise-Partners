    <bpmn:sequenceFlow id="P-93_F6" name="" sourceRef="P-93_t3" targetRef="P-93_f1" />
    <bpmn:sequenceFlow id="P-93_F7" name="Saída" sourceRef="P-93_g1" targetRef="P-93_t4" />
    <bpmn:sequenceFlow id="P-93_F8" name="" sourceRef="P-93_t4" targetRef="P-93_f1" />
  </bpmn:process>

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-86" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-86">
    <bpmn:participant id="Participant_P-86" name="10.1 Verificar a ficha do fornecedor" processRef="Process_P-86" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-86" name="10.1 Verificar a ficha do fornecedor" isExecutable="false">
    <bpmn:documentation>Conferir os dados, os casos e a apresentação de vendas antes de publicar na Prateleira. No portal: mostra a ficha para conferência e publica. [status do fluxo: Hipótese; evidências: nenhuma]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-86">
      <bpmn:lane id="Lane_P-86_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-86_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-86_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-86_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-86_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-86_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-86_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-86_f1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-86_i1" name="Ficha para conferência ou ficha alterada"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-86_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P-86_t1" name="Conferir os dados, as categorias e os casos"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-86_F1</bpmn:incoming><bpmn:incoming>P-86_F5</bpmn:incoming><bpmn:outgoing>P-86_F2</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P-86_t2" name="Conferir a apresentação de vendas"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-86_F2</bpmn:incoming><bpmn:outgoing>P-86_F3</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P-86_g1" name="A ficha está completa e correta?"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-86_F3</bpmn:incoming><bpmn:outgoing>P-86_F4</bpmn:outgoing><bpmn:outgoing>P-86_F6</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="P-86_t3" name="Pedir a correção ao parceiro"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Hipótese</bpmn:documentation><bpmn:incoming>P-86_F4</bpmn:incoming><bpmn:outgoing>P-86_F5</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="P-86_t4" name="Publicar a ficha na Prateleira"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-86_F6</bpmn:incoming><bpmn:outgoing>P-86_F7</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P-86_f1" name="Ficha publicada"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-86_F7</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-86_F1" name="" sourceRef="P-86_i1" targetRef="P-86_t1" />
    <bpmn:sequenceFlow id="P-86_F2" name="" sourceRef="P-86_t1" targetRef="P-86_t2" />
    <bpmn:sequenceFlow id="P-86_F3" name="" sourceRef="P-86_t2" targetRef="P-86_g1" />
    <bpmn:sequenceFlow id="P-86_F4" name="Não" sourceRef="P-86_g1" targetRef="P-86_t3" />
    <bpmn:sequenceFlow id="P-86_F5" name="" sourceRef="P-86_t3" targetRef="P-86_t1" />
    <bpmn:sequenceFlow id="P-86_F6" name="Sim" sourceRef="P-86_g1" targetRef="P-86_t4" />
    <bpmn:sequenceFlow id="P-86_F7" name="" sourceRef="P-86_t4" targetRef="P-86_f1" />
  </bpmn:process>

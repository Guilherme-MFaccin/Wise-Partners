<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-87" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-87">
    <bpmn:participant id="Participant_P-87" name="10.2 Revisar a permanência na Prateleira" processRef="Process_P-87" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-87" name="10.2 Revisar a permanência na Prateleira" isExecutable="false">
    <bpmn:documentation>A cada trimestre, quem fica e quem sai da Prateleira, pela nota de qualidade e pelo retorno dos clientes; as recomendações suspensas são revistas. Quem sai não é avisado nem rebaixado. No portal: calcula a nota, sinaliza quem está abaixo e registra a decisão. [status do fluxo: Hipótese; evidências: nenhuma]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-87">
      <bpmn:lane id="Lane_P-87_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-87_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-87_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-87_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-87_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-87_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-87_f1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-87_i1" name="Fechamento trimestral"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-87_F1</bpmn:outgoing><bpmn:timerEventDefinition id="P-87_i1_def" /></bpmn:startEvent>
    <bpmn:serviceTask id="P-87_t1" name="Calcular a nota de qualidade de cada parceiro recomendado"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-87_F1</bpmn:incoming><bpmn:outgoing>P-87_F2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P-87_t2" name="Sinalizar quem está abaixo"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-87_F2</bpmn:incoming><bpmn:outgoing>P-87_F3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:task id="P-87_t3" name="Decidir quem continua, quem sai e quais suspensões são revistas"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-87_F3</bpmn:incoming><bpmn:outgoing>P-87_F4</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="P-87_t4" name="Registrar a decisão"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-87_F4</bpmn:incoming><bpmn:outgoing>P-87_F5</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P-87_f1" name="Prateleira revista"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-87_F5</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-87_F1" name="" sourceRef="P-87_i1" targetRef="P-87_t1" />
    <bpmn:sequenceFlow id="P-87_F2" name="" sourceRef="P-87_t1" targetRef="P-87_t2" />
    <bpmn:sequenceFlow id="P-87_F3" name="" sourceRef="P-87_t2" targetRef="P-87_t3" />
    <bpmn:sequenceFlow id="P-87_F4" name="" sourceRef="P-87_t3" targetRef="P-87_t4" />
    <bpmn:sequenceFlow id="P-87_F5" name="" sourceRef="P-87_t4" targetRef="P-87_f1" />
  </bpmn:process>

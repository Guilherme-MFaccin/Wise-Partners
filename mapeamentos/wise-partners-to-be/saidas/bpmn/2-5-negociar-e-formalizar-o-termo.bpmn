    <bpmn:sequenceFlow id="P-15_F8" name="Não" sourceRef="P-15_g0" targetRef="P-15_f2" />
    <bpmn:sequenceFlow id="P-15_F9" name="" sourceRef="P-15_t6" targetRef="P-15_g1" />
    <bpmn:sequenceFlow id="P-15_F10" name="Sim" sourceRef="P-15_g1" targetRef="P-15_t8" />
    <bpmn:sequenceFlow id="P-15_F11" name="Não" sourceRef="P-15_g1" targetRef="P-15_t7" />
    <bpmn:sequenceFlow id="P-15_F12" name="" sourceRef="P-15_t7" targetRef="P-15_t6" />

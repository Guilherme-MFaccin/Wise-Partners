<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-15" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-15">
    <bpmn:participant id="Participant_P-15" name="2.5 Negociar e formalizar o termo" processRef="Process_P-15" />
    <bpmn:participant id="Ext_P-15_X1" name="Empresa candidata" />
    <bpmn:messageFlow id="P-15_M1" name="Convite para o grupo" sourceRef="P-15_t1" targetRef="Ext_P-15_X1" />
    <bpmn:messageFlow id="P-15_M2" name="Minuta para críticas" sourceRef="P-15_t5" targetRef="Ext_P-15_X1" />
    <bpmn:messageFlow id="P-15_M3" name="Termo para assinatura" sourceRef="P-15_t8" targetRef="Ext_P-15_X1" />
    <bpmn:messageFlow id="P-15_M4" name="Termo assinado" sourceRef="Ext_P-15_X1" targetRef="P-15_e1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-15" name="2.5 Negociar e formalizar o termo" isExecutable="false">
    <bpmn:documentation>Gerar a minuta pelo portal a partir do quadro de identificação, colher críticas, obter a aprovação do Diretor e a assinatura digital. [status do fluxo: Declarado; evidências: EV-0073, EV-0009, EV-0010, EV-0074, EV-0117, EV-0118]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-15">
      <bpmn:lane id="Lane_P-15_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-15_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-15_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-15_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-15_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-15_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-15_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-15_g0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-15_t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-15_t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-15_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-15_t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-15_f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-15_f2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-15_PA-02" name="Diretor">
        <bpmn:flowNodeRef>P-15_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-15_g1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-15_i1" name="Candidato qualificado quer seguir"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:outgoing>P-15_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P-15_t1" name="Criar o grupo de WhatsApp da parceria"><bpmn:documentation>sistema: WhatsApp; status: Declarado</bpmn:documentation><bpmn:incoming>P-15_F1</bpmn:incoming><bpmn:outgoing>P-15_F2</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P-15_t2" name="Registrar interesses, decisores e alternativas"><bpmn:documentation>sistema: Portal Wise Partners; Interesses dos dois lados, quem decide no candidato, a melhor alternativa de cada lado e o pacote gatilho que exige o Diretor.; status: Hipótese</bpmn:documentation><bpmn:incoming>P-15_F2</bpmn:incoming><bpmn:outgoing>P-15_F3</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P-15_t3" name="Preencher o quadro de identificação"><bpmn:documentation>sistema: Portal Wise Partners; status: Declarado</bpmn:documentation><bpmn:incoming>P-15_F3</bpmn:incoming><bpmn:outgoing>P-15_F4</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P-15_t4" name="Gerar a minuta do termo"><bpmn:documentation>sistema: Portal Wise Partners; status: Declarado</bpmn:documentation><bpmn:incoming>P-15_F4</bpmn:incoming><bpmn:outgoing>P-15_F5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:task id="P-15_t5" name="Colher as críticas do candidato à minuta"><bpmn:documentation>A minuta circula como texto único: pede-se crítica, não concessão.; status: Hipótese</bpmn:documentation><bpmn:incoming>P-15_F5</bpmn:incoming><bpmn:outgoing>P-15_F6</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="P-15_g0" name="Candidato aceita os termos?"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-15_F6</bpmn:incoming><bpmn:outgoing>P-15_F7</bpmn:outgoing><bpmn:outgoing>P-15_F8</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P-15_t6" name="Aprovar a assinatura"><bpmn:documentation>sistema: Portal Wise Partners; status: Declarado</bpmn:documentation><bpmn:incoming>P-15_F7</bpmn:incoming><bpmn:incoming>P-15_F12</bpmn:incoming><bpmn:outgoing>P-15_F9</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P-15_g1" name="Assinatura aprovada?"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-15_F9</bpmn:incoming><bpmn:outgoing>P-15_F10</bpmn:outgoing><bpmn:outgoing>P-15_F11</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="P-15_t7" name="Ajustar a minuta"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-15_F11</bpmn:incoming><bpmn:outgoing>P-15_F12</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="P-15_t8" name="Enviar o termo para assinatura"><bpmn:documentation>sistema: Autentique; status: Declarado</bpmn:documentation><bpmn:incoming>P-15_F10</bpmn:incoming><bpmn:outgoing>P-15_F13</bpmn:outgoing></bpmn:userTask>
    <bpmn:intermediateCatchEvent id="P-15_e1" name="Termo assinado pelo candidato"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-15_F13</bpmn:incoming><bpmn:outgoing>P-15_F14</bpmn:outgoing><bpmn:messageEventDefinition id="P-15_e1_def" /></bpmn:intermediateCatchEvent>
    <bpmn:userTask id="P-15_t9" name="Anexar o termo assinado"><bpmn:documentation>sistema: Portal Wise Partners; status: Declarado</bpmn:documentation><bpmn:incoming>P-15_F14</bpmn:incoming><bpmn:outgoing>P-15_F15</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P-15_f1" name="Termo assinado"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-15_F15</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-15_f2" name="Negociação perdida"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-15_F8</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-15_F1" name="" sourceRef="P-15_i1" targetRef="P-15_t1" />

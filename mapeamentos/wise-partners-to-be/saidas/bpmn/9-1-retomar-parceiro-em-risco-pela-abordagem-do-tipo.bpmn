    <bpmn:sequenceFlow id="P-55_F10" name="" sourceRef="P-55_e1" targetRef="P-55_g2" />
    <bpmn:sequenceFlow id="P-55_F11" name="Sim" sourceRef="P-55_g2" targetRef="P-55_f1" />
    <bpmn:sequenceFlow id="P-55_F12" name="Não" sourceRef="P-55_g2" targetRef="P-55_f2" />
  </bpmn:process>

  <bpmn:collaboration id="Collaboration_P-55">
    <bpmn:participant id="Participant_P-55" name="9.1 Retomar parceiro em risco pela abordagem do tipo" processRef="Process_P-55" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-55" name="9.1 Retomar parceiro em risco pela abordagem do tipo" isExecutable="false">
    <bpmn:documentation>Âncora esfriando: chegar com oportunidade pronta. Valioso em risco: ouvir primeiro e decidir em 15 dias se vale. Cordial seletivo: recrutar de novo com foco único. Desertor: decidir, sem insistir. No portal: mostra a abordagem e a mensagem sugerida do tipo. [status do fluxo: Hipótese; evidências: nenhuma]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-55">
      <bpmn:lane id="Lane_P-55_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-55_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-55_t0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-55_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-55_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-55_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-55_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-55_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-55_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-55_f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-55_f2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-55_i1" name="Parceiro entra num tipo de risco"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-55_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="P-55_t0" name="Mostrar o tipo, a abordagem e a mensagem sugerida"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-55_F1</bpmn:incoming><bpmn:outgoing>P-55_F2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P-55_g1" name="Qual é o tipo?"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-55_F2</bpmn:incoming><bpmn:outgoing>P-55_F3</bpmn:outgoing><bpmn:outgoing>P-55_F5</bpmn:outgoing><bpmn:outgoing>P-55_F7</bpmn:outgoing><bpmn:outgoing>P-55_F9</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="P-55_t1" name="Levar uma oportunidade pronta ao parceiro"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Hipótese</bpmn:documentation><bpmn:incoming>P-55_F3</bpmn:incoming><bpmn:outgoing>P-55_F4</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-55_t2" name="Ouvir o parceiro e decidir em 15 dias se vale"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Hipótese</bpmn:documentation><bpmn:incoming>P-55_F5</bpmn:incoming><bpmn:outgoing>P-55_F6</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-55_t3" name="Recrutar de novo com um foco único"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Hipótese</bpmn:documentation><bpmn:incoming>P-55_F7</bpmn:incoming><bpmn:outgoing>P-55_F8</bpmn:outgoing></bpmn:task>
    <bpmn:intermediateCatchEvent id="P-55_e1" name="30 dias"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-55_F4</bpmn:incoming><bpmn:incoming>P-55_F6</bpmn:incoming><bpmn:incoming>P-55_F8</bpmn:incoming><bpmn:outgoing>P-55_F10</bpmn:outgoing><bpmn:timerEventDefinition id="P-55_e1_def" /></bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="P-55_g2" name="O Ritmo voltou a ser alto?"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-55_F10</bpmn:incoming><bpmn:outgoing>P-55_F11</bpmn:outgoing><bpmn:outgoing>P-55_F12</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="P-55_f1" name="Parceiro retomado"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-55_F11</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-55_f2" name="Desligamento sugerido"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-55_F9</bpmn:incoming><bpmn:incoming>P-55_F12</bpmn:incoming></bpmn:endEvent>

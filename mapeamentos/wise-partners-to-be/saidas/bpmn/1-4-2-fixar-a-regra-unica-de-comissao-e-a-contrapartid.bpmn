<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-62" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-62">
    <bpmn:participant id="Participant_P-62" name="1.4.2 Fixar a regra única de comissão e a contrapartida da Prateleira" processRef="Process_P-62" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-62" name="1.4.2 Fixar a regra única de comissão e a contrapartida da Prateleira" isExecutable="false">
    <bpmn:documentation>40% e 10% na Wise Makers e na Tríade, 6% e 2% do projeto na Swallow, sem exceção; o não monetário varia por tipo de parceiro; para entrar num pedido da Prateleira, contrapartida não financeira; revisão depois de dois trimestres com dados de permanência. No portal: calcula a comissão sozinho e registra a contrapartida combinada. [status do fluxo: Hipótese; evidências: nenhuma]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-62">
      <bpmn:lane id="Lane_P-62_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-62_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-62_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-62_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-62_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-62_f1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-62_PA-02" name="Diretor">
        <bpmn:flowNodeRef>P-62_t3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-62_i1" name="Revisão anual das regras"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-62_F1</bpmn:outgoing><bpmn:timerEventDefinition id="P-62_i1_def" /></bpmn:startEvent>
    <bpmn:serviceTask id="P-62_t1" name="Reunir os dados de permanência dos clientes indicados"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-62_F1</bpmn:incoming><bpmn:outgoing>P-62_F2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:task id="P-62_t2" name="Comparar a comissão paga com a receita dos clientes vindos de parceiros"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-62_F2</bpmn:incoming><bpmn:outgoing>P-62_F3</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-62_t3" name="Decidir se a regra muda"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-62_F3</bpmn:incoming><bpmn:outgoing>P-62_F4</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="P-62_t4" name="Atualizar a regra e o simulador de ganho no portal"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-62_F4</bpmn:incoming><bpmn:outgoing>P-62_F5</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P-62_f1" name="Regra de comissão confirmada ou atualizada"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-62_F5</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-62_F1" name="" sourceRef="P-62_i1" targetRef="P-62_t1" />
    <bpmn:sequenceFlow id="P-62_F2" name="" sourceRef="P-62_t1" targetRef="P-62_t2" />
    <bpmn:sequenceFlow id="P-62_F3" name="" sourceRef="P-62_t2" targetRef="P-62_t3" />
    <bpmn:sequenceFlow id="P-62_F4" name="" sourceRef="P-62_t3" targetRef="P-62_t4" />
    <bpmn:sequenceFlow id="P-62_F5" name="" sourceRef="P-62_t4" targetRef="P-62_f1" />
  </bpmn:process>

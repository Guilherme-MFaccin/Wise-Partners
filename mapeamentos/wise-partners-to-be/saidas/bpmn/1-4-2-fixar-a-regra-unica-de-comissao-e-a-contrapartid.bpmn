      <bpmndi:BPMNShape id="Lane_P-62_PA-02_di" bpmnElement="Lane_P-62_PA-02" isHorizontal="true"><dc:Bounds x="30" y="148" width="1146" height="148" /></bpmndi:BPMNShape>

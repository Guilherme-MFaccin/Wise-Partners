<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-37" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-37">
    <bpmn:participant id="Participant_P-37" name="6.6 Transformar o cruzamento de carteiras em oportunidades" processRef="Process_P-37" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-37" name="6.6 Transformar o cruzamento de carteiras em oportunidades" isExecutable="false">
    <bpmn:documentation>Para parceiros Premium e Elite: cada coincidência do cruzamento de carteiras, feito no encontro de alinhamento, vira uma jogada (apresentar o parceiro a cliente da Wise, pedir indicação de cliente do parceiro ou combinar ação numa conta comum); a jogada aceita vira oportunidade. No portal: sugere as jogadas por célula da matriz de contas. [status do fluxo: Hipótese; evidências: nenhuma]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-37">
      <bpmn:lane id="Lane_P-37_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-37_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-37_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-37_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-37_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-37_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-37_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-37_f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-37_f2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-37_i1" name="Coincidências do cruzamento disponíveis"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-37_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="P-37_t1" name="Listar as contas em comum e as vizinhas"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-37_F1</bpmn:incoming><bpmn:outgoing>P-37_F2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:task id="P-37_t2" name="Escolher uma jogada para cada conta"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-37_F2</bpmn:incoming><bpmn:outgoing>P-37_F3</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-37_t3" name="Combinar a jogada com o parceiro"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Hipótese</bpmn:documentation><bpmn:incoming>P-37_F3</bpmn:incoming><bpmn:outgoing>P-37_F4</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="P-37_g1" name="O parceiro topa a jogada?"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-37_F4</bpmn:incoming><bpmn:outgoing>P-37_F5</bpmn:outgoing><bpmn:outgoing>P-37_F6</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P-37_t4" name="Registrar a oportunidade com a porta cruzamento"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-37_F6</bpmn:incoming><bpmn:outgoing>P-37_F7</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P-37_f1" name="Jogada descartada"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-37_F5</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-37_f2" name="Oportunidades criadas"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-37_F7</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-37_F1" name="" sourceRef="P-37_i1" targetRef="P-37_t1" />
    <bpmn:sequenceFlow id="P-37_F2" name="" sourceRef="P-37_t1" targetRef="P-37_t2" />
    <bpmn:sequenceFlow id="P-37_F3" name="" sourceRef="P-37_t2" targetRef="P-37_t3" />
    <bpmn:sequenceFlow id="P-37_F4" name="" sourceRef="P-37_t3" targetRef="P-37_g1" />
    <bpmn:sequenceFlow id="P-37_F5" name="Não" sourceRef="P-37_g1" targetRef="P-37_f1" />
    <bpmn:sequenceFlow id="P-37_F6" name="Sim" sourceRef="P-37_g1" targetRef="P-37_t4" />
    <bpmn:sequenceFlow id="P-37_F7" name="" sourceRef="P-37_t4" targetRef="P-37_f2" />
  </bpmn:process>

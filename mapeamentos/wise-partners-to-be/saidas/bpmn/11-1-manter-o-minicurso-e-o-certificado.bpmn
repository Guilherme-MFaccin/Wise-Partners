  <bpmn:collaboration id="Collaboration_P-88">
    <bpmn:participant id="Participant_P-88" name="11.1 Manter o minicurso e o certificado" processRef="Process_P-88" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-88" name="11.1 Manter o minicurso e o certificado" isExecutable="false">
    <bpmn:documentation>Minicurso de como vender a Wise e trilhas por empresa do grupo; o certificado de parceiro Wise vale desde o Select. O Igor grava e revisa; o Gerente atualiza. No portal: entrega o minicurso e as trilhas e emite o certificado. [status do fluxo: Hipótese; evidências: nenhuma]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-88">
      <bpmn:lane id="Lane_P-88_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-88_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-88_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-88_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-88_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-88_f1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-88_PA-02" name="Diretor">
        <bpmn:flowNodeRef>P-88_t2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-88_i1" name="Mudança na oferta, na regra de comissão ou na página"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-88_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="P-88_t1" name="Listar o que precisa mudar no minicurso"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-88_F1</bpmn:incoming><bpmn:outgoing>P-88_F2</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-88_t2" name="Gravar ou regravar o trecho"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-88_F2</bpmn:incoming><bpmn:outgoing>P-88_F3</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="P-88_t3" name="Publicar na área do parceiro"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-88_F3</bpmn:incoming><bpmn:outgoing>P-88_F4</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P-88_t4" name="Avisar os parceiros da atualização"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-88_F4</bpmn:incoming><bpmn:outgoing>P-88_F5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="P-88_f1" name="Minicurso atualizado"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-88_F5</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-88_F1" name="" sourceRef="P-88_i1" targetRef="P-88_t1" />
    <bpmn:sequenceFlow id="P-88_F2" name="" sourceRef="P-88_t1" targetRef="P-88_t2" />
    <bpmn:sequenceFlow id="P-88_F3" name="" sourceRef="P-88_t2" targetRef="P-88_t3" />
    <bpmn:sequenceFlow id="P-88_F4" name="" sourceRef="P-88_t3" targetRef="P-88_t4" />
    <bpmn:sequenceFlow id="P-88_F5" name="" sourceRef="P-88_t4" targetRef="P-88_f1" />
  </bpmn:process>

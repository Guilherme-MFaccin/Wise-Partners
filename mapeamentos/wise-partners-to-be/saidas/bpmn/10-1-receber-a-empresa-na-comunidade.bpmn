<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-106" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-106">
    <bpmn:participant id="Participant_P-106" name="10.1 Receber a empresa na Comunidade" processRef="Process_P-106" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-106" name="10.1 Receber a empresa na Comunidade" isExecutable="false">
    <bpmn:documentation>Qualquer empresa conhece a comunidade pela página geral, que não cita nenhum parceiro, e se cadastra em três etapas: a empresa (CNPJ, o que faz, local, faturamento e time de vendas), a relação com o Grupo Tríade (se é cliente e de qual empresa, e o que quer: usar condições, oferecer, indicar, conhecer a consultoria ou ser parceira) e o acesso (contato e senha). A conta nasce na hora e a pessoa entra direto no portal. O cadastro classifica a empresa: cliente do grupo a confirmar, lead de parceiro, lead da consultoria ou empresa cadastrada. [status do fluxo: Declarado; evidências: EV-0462]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-106">
      <bpmn:lane id="Lane_P-106_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-106_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-106_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-106_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-106_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-106_t5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-106_PA-08" name="Empresa cliente do Grupo Tríade">
        <bpmn:flowNodeRef>P-106_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-106_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-106_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-106_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-106_f1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-106_i1" name="Empresa clicou em Cadastrar na página da comunidade"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:outgoing>P-106_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="P-106_t1" name="Contar quem é a empresa e a relação com o grupo"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-106_F1</bpmn:incoming><bpmn:outgoing>P-106_F2</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-106_t2" name="Criar a senha e aceitar o termo de uso"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-106_F2</bpmn:incoming><bpmn:outgoing>P-106_F3</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="P-106_t3" name="Criar a empresa e a conta e classificar o cadastro"><bpmn:documentation>sistema: Portal Wise Partners; status: Declarado</bpmn:documentation><bpmn:incoming>P-106_F3</bpmn:incoming><bpmn:outgoing>P-106_F4</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P-106_g1" name="A empresa declarou ser cliente do grupo?"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-106_F4</bpmn:incoming><bpmn:outgoing>P-106_F5</bpmn:outgoing><bpmn:outgoing>P-106_F7</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P-106_t4" name="Abrir a tarefa de confirmar o cliente"><bpmn:documentation>sistema: Portal Wise Partners; status: Declarado</bpmn:documentation><bpmn:incoming>P-106_F5</bpmn:incoming><bpmn:outgoing>P-106_F6</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P-106_g2" name="A empresa quer ser parceira?"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-106_F6</bpmn:incoming><bpmn:incoming>P-106_F7</bpmn:incoming><bpmn:outgoing>P-106_F8</bpmn:outgoing><bpmn:outgoing>P-106_F10</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P-106_t5" name="Colocar o pedido na fila de candidatos"><bpmn:documentation>sistema: Portal Wise Partners; status: Declarado</bpmn:documentation><bpmn:incoming>P-106_F8</bpmn:incoming><bpmn:outgoing>P-106_F9</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P-106_t6" name="Entrar no portal pelo Catálogo"><bpmn:documentation>sistema: Portal Wise Partners; status: Declarado</bpmn:documentation><bpmn:incoming>P-106_F9</bpmn:incoming><bpmn:incoming>P-106_F10</bpmn:incoming><bpmn:outgoing>P-106_F11</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P-106_f1" name="Empresa na comunidade"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-106_F11</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-106_F1" name="" sourceRef="P-106_i1" targetRef="P-106_t1" />
    <bpmn:sequenceFlow id="P-106_F2" name="" sourceRef="P-106_t1" targetRef="P-106_t2" />
    <bpmn:sequenceFlow id="P-106_F3" name="" sourceRef="P-106_t2" targetRef="P-106_t3" />
    <bpmn:sequenceFlow id="P-106_F4" name="" sourceRef="P-106_t3" targetRef="P-106_g1" />
    <bpmn:sequenceFlow id="P-106_F5" name="Sim" sourceRef="P-106_g1" targetRef="P-106_t4" />
    <bpmn:sequenceFlow id="P-106_F6" name="" sourceRef="P-106_t4" targetRef="P-106_g2" />
    <bpmn:sequenceFlow id="P-106_F7" name="Não" sourceRef="P-106_g1" targetRef="P-106_g2" />
    <bpmn:sequenceFlow id="P-106_F8" name="Sim" sourceRef="P-106_g2" targetRef="P-106_t5" />
    <bpmn:sequenceFlow id="P-106_F9" name="" sourceRef="P-106_t5" targetRef="P-106_t6" />
    <bpmn:sequenceFlow id="P-106_F10" name="Não" sourceRef="P-106_g2" targetRef="P-106_t6" />
    <bpmn:sequenceFlow id="P-106_F11" name="" sourceRef="P-106_t6" targetRef="P-106_f1" />
  </bpmn:process>

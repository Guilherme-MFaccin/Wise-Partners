<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-05" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-05">
    <bpmn:participant id="Participant_P-05" name="1.4 Revisar o nível dos parceiros" processRef="Process_P-05" />
    <bpmn:participant id="Ext_P-05_X1" name="Parceiro" />
    <bpmn:messageFlow id="P-05_M1" name="Aviso do que falta" sourceRef="P-05_t2" targetRef="Ext_P-05_X1" />
    <bpmn:messageFlow id="P-05_M2" name="Aviso de nível" sourceRef="P-05_t4" targetRef="Ext_P-05_X1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-05" name="1.4 Revisar o nível dos parceiros" isExecutable="false">
    <bpmn:documentation>Apurar os requisitos de nível de cada parceiro no início do trimestre, colocar em observação ou propor descida, e classificar as faixas de desempenho. [status do fluxo: Declarado; evidências: EV-0057, EV-0133, EV-0134, EV-0012]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-05">
      <bpmn:lane id="Lane_P-05_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-05_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-05_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-05_g0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-05_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-05_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-05_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-05_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-05_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-05_g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-05_f0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-05_f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-05_f2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-05_f3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-05_i1" name="Primeiro dia útil do trimestre"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:outgoing>P-05_F1</bpmn:outgoing><bpmn:timerEventDefinition id="P-05_i1_def" /></bpmn:startEvent>
    <bpmn:serviceTask id="P-05_t1" name="Apurar os requisitos de cada parceiro"><bpmn:documentation>sistema: Portal Wise Partners; status: Declarado</bpmn:documentation><bpmn:incoming>P-05_F1</bpmn:incoming><bpmn:outgoing>P-05_F2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P-05_g0" name="Parceiro isento?"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-05_F2</bpmn:incoming><bpmn:outgoing>P-05_F3</bpmn:outgoing><bpmn:outgoing>P-05_F4</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="P-05_g1" name="Cumpre o nível atual?"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-05_F4</bpmn:incoming><bpmn:outgoing>P-05_F5</bpmn:outgoing><bpmn:outgoing>P-05_F6</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="P-05_g2" name="Já estava em observação?"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-05_F6</bpmn:incoming><bpmn:outgoing>P-05_F7</bpmn:outgoing><bpmn:outgoing>P-05_F9</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P-05_t2" name="Colocar em observação e avisar o que falta"><bpmn:documentation>sistema: Portal Wise Partners; status: Declarado</bpmn:documentation><bpmn:incoming>P-05_F7</bpmn:incoming><bpmn:outgoing>P-05_F8</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P-05_t3" name="Propor a descida de nível"><bpmn:documentation>sistema: Portal Wise Partners; status: Declarado</bpmn:documentation><bpmn:incoming>P-05_F9</bpmn:incoming><bpmn:outgoing>P-05_F10</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P-05_t4" name="Decidir a descida com motivo"><bpmn:documentation>sistema: Portal Wise Partners; status: Declarado</bpmn:documentation><bpmn:incoming>P-05_F10</bpmn:incoming><bpmn:outgoing>P-05_F11</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P-05_g3" name="Descer de nível?"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-05_F11</bpmn:incoming><bpmn:outgoing>P-05_F12</bpmn:outgoing><bpmn:outgoing>P-05_F13</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="P-05_f0" name="Parceiro isento"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-05_F3</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-05_f1" name="Nível mantido"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-05_F5</bpmn:incoming><bpmn:incoming>P-05_F13</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-05_f2" name="Parceiro em observação"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-05_F8</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-05_f3" name="Nível rebaixado"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-05_F12</bpmn:incoming></bpmn:endEvent>

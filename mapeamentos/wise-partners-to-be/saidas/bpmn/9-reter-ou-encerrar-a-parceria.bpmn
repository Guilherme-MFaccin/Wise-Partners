    <bpmn:sequenceFlow id="P-54_F4" name="Não" sourceRef="P-54_g1" targetRef="P-54_s2" />
    <bpmn:sequenceFlow id="P-54_F5" name="" sourceRef="P-54_i2" targetRef="P-54_s2" />

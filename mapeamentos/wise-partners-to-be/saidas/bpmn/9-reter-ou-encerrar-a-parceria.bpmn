    <bpmn:sequenceFlow id="P-54_F8" name="Não" sourceRef="P-54_g2" targetRef="P-54_f3" />
    <bpmn:sequenceFlow id="P-54_F9" name="" sourceRef="P-54_i3" targetRef="P-54_s3" />
    <bpmn:sequenceFlow id="P-54_F10" name="" sourceRef="P-54_s3" targetRef="P-54_f4" />
  </bpmn:process>

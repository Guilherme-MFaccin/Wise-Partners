        <bpmn:flowNodeRef>P-54_f2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-54_f3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-54_PA-02" name="Diretor">
        <bpmn:flowNodeRef>P-54_t6b</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-54_i1" name="Parceiro entra num tipo de risco"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:outgoing>P-54_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:exclusiveGateway id="P-54_g1" name="Qual é o tipo?"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-54_F1</bpmn:incoming><bpmn:outgoing>P-54_F2</bpmn:outgoing><bpmn:outgoing>P-54_F3</bpmn:outgoing><bpmn:outgoing>P-54_F4</bpmn:outgoing><bpmn:outgoing>P-54_F5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P-54_t1" name="Levar uma oportunidade pronta ao parceiro"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Confirmado</bpmn:documentation><bpmn:incoming>P-54_F2</bpmn:incoming><bpmn:outgoing>P-54_F6</bpmn:outgoing></bpmn:userTask>
    <bpmn:task id="P-54_t2" name="Ouvir o parceiro e decidir em 15 dias se vale"><bpmn:documentation>Ligação, não mensagem.; status: Confirmado</bpmn:documentation><bpmn:incoming>P-54_F3</bpmn:incoming><bpmn:outgoing>P-54_F7</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="P-54_t3" name="Recrutar de novo com um foco único"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Confirmado</bpmn:documentation><bpmn:incoming>P-54_F4</bpmn:incoming><bpmn:outgoing>P-54_F8</bpmn:outgoing></bpmn:userTask>
    <bpmn:task id="P-54_t4" name="Decidir sem insistir"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-54_F5</bpmn:incoming><bpmn:outgoing>P-54_F9</bpmn:outgoing></bpmn:task>
    <bpmn:intermediateCatchEvent id="P-54_e1" name="30 dias"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-54_F6</bpmn:incoming><bpmn:incoming>P-54_F7</bpmn:incoming><bpmn:incoming>P-54_F8</bpmn:incoming><bpmn:outgoing>P-54_F10</bpmn:outgoing><bpmn:timerEventDefinition id="P-54_e1_def" /></bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="P-54_g2" name="O Ritmo voltou a ser alto?"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-54_F10</bpmn:incoming><bpmn:outgoing>P-54_F11</bpmn:outgoing><bpmn:outgoing>P-54_F12</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P-54_t5" name="Sugerir o desligamento"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-54_F9</bpmn:incoming><bpmn:incoming>P-54_F12</bpmn:incoming><bpmn:outgoing>P-54_F13</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P-54_t6" name="Decidir o desligamento com motivo"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-54_F13</bpmn:incoming><bpmn:outgoing>P-54_F14</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P-54_g3" name="Desligar?"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-54_F14</bpmn:incoming><bpmn:outgoing>P-54_F15</bpmn:outgoing><bpmn:outgoing>P-54_F16</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P-54_t6b" name="Assinar o aviso formal"><bpmn:documentation>sistema: Autentique; status: Confirmado</bpmn:documentation><bpmn:incoming>P-54_F16</bpmn:incoming><bpmn:outgoing>P-54_F17</bpmn:outgoing></bpmn:userTask>
    <bpmn:task id="P-54_t7" name="Comunicar o encerramento em conversa e por escrito"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-54_F17</bpmn:incoming><bpmn:outgoing>P-54_F18</bpmn:outgoing></bpmn:task>
    <bpmn:intermediateCatchEvent id="P-54_e2" name="30 dias de aviso"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-54_F18</bpmn:incoming><bpmn:outgoing>P-54_F19</bpmn:outgoing><bpmn:timerEventDefinition id="P-54_e2_def" /></bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="P-54_t8" name="Encerrar a parceria e revogar acessos"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-54_F19</bpmn:incoming><bpmn:outgoing>P-54_F20</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P-54_t9" name="Manter o ex-parceiro na lista de contato anual"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-54_F20</bpmn:incoming><bpmn:outgoing>P-54_F21</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P-54_f1" name="Parceiro retomado"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-54_F11</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-54_f2" name="Parceiro mantido em observação"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-54_F15</bpmn:incoming></bpmn:endEvent>

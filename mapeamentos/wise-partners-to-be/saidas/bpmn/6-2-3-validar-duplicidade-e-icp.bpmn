<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-81" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-81">
    <bpmn:participant id="Participant_P-81" name="6.2.3 Validar duplicidade e ICP" processRef="Process_P-81" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-81" name="6.2.3 Validar duplicidade e ICP" isExecutable="false">
    <bpmn:documentation>Checar se a empresa já está com o grupo e se está no ICP; calcular a nota de qualidade. No portal: checa duplicidade e calcula a nota. [status do fluxo: Hipótese; evidências: nenhuma]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-81">
      <bpmn:lane id="Lane_P-81_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-81_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-81_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-81_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-81_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-81_f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-81_f2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-81_i1" name="Parceiro agradecido"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-81_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="P-81_t1" name="Checar se a empresa já é cliente ou está em negociação com o grupo"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-81_F1</bpmn:incoming><bpmn:outgoing>P-81_F2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P-81_t2" name="Checar o ICP e calcular a nota de qualidade"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-81_F2</bpmn:incoming><bpmn:outgoing>P-81_F3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P-81_g1" name="É duplicada ou está fora do ICP?"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-81_F3</bpmn:incoming><bpmn:outgoing>P-81_F4</bpmn:outgoing><bpmn:outgoing>P-81_F5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="P-81_f1" name="Oportunidade recusada"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-81_F4</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-81_f2" name="Oportunidade qualificada"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-81_F5</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-81_F1" name="" sourceRef="P-81_i1" targetRef="P-81_t1" />
    <bpmn:sequenceFlow id="P-81_F2" name="" sourceRef="P-81_t1" targetRef="P-81_t2" />
    <bpmn:sequenceFlow id="P-81_F3" name="" sourceRef="P-81_t2" targetRef="P-81_g1" />
    <bpmn:sequenceFlow id="P-81_F4" name="Sim" sourceRef="P-81_g1" targetRef="P-81_f1" />
    <bpmn:sequenceFlow id="P-81_F5" name="Não" sourceRef="P-81_g1" targetRef="P-81_f2" />
  </bpmn:process>

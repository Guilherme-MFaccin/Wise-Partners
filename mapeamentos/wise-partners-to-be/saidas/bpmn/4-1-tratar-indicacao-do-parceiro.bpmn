  <bpmn:collaboration id="Collaboration_P-23">
    <bpmn:participant id="Participant_P-23" name="4.1 Tratar indicação do parceiro" processRef="Process_P-23" />
    <bpmn:participant id="Ext_P-23_X1" name="Parceiro" />
    <bpmn:participant id="Ext_P-23_X2" name="Cliente indicado" />
    <bpmn:messageFlow id="P-23_M1" name="Indicação" sourceRef="Ext_P-23_X1" targetRef="P-23_i1" />
    <bpmn:messageFlow id="P-23_M2" name="Confirmação de recebimento" sourceRef="P-23_t1" targetRef="Ext_P-23_X1" />
    <bpmn:messageFlow id="P-23_M3" name="Motivo da recusa" sourceRef="P-23_t3" targetRef="Ext_P-23_X1" />
    <bpmn:messageFlow id="P-23_M4" name="Primeiro contato" sourceRef="P-23_t4" targetRef="Ext_P-23_X2" />
    <bpmn:messageFlow id="P-23_M5" name="Retorno sobre o primeiro contato" sourceRef="P-23_t5" targetRef="Ext_P-23_X1" />
    <bpmn:messageFlow id="P-23_M6" name="Motivo da perda" sourceRef="P-23_t7" targetRef="Ext_P-23_X1" />
    <bpmn:messageFlow id="P-23_M7" name="Comissão" sourceRef="P-23_s1" targetRef="Ext_P-23_X1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-23" name="4.1 Tratar indicação do parceiro" isExecutable="false">
    <bpmn:documentation>Registrar, confirmar, validar duplicidade e ICP, fazer o primeiro contato, dar retorno ao parceiro e acompanhar até o fechamento. [status do fluxo: Declarado; evidências: EV-0120, EV-0087, EV-0121, EV-0122]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-23">
      <bpmn:lane id="Lane_P-23_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-23_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-23_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-23_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-23_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-23_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-23_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-23_s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-23_t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-23_f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-23_f2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-23_f3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-23_PA-03" name="Consultor ou gerente de conta do grupo">
        <bpmn:flowNodeRef>P-23_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-23_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-23_g2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-23_i1" name="Indicação recebida"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:outgoing>P-23_F1</bpmn:outgoing><bpmn:messageEventDefinition id="P-23_i1_def" /></bpmn:startEvent>
    <bpmn:serviceTask id="P-23_t1" name="Confirmar o recebimento ao parceiro"><bpmn:documentation>sistema: Portal Wise Partners; status: Declarado</bpmn:documentation><bpmn:incoming>P-23_F1</bpmn:incoming><bpmn:outgoing>P-23_F2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P-23_t2" name="Validar duplicidade e ICP"><bpmn:documentation>sistema: Portal Wise Partners; Até 2 dias úteis.; status: Declarado</bpmn:documentation><bpmn:incoming>P-23_F2</bpmn:incoming><bpmn:outgoing>P-23_F3</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P-23_g1" name="Indicação válida?"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-23_F3</bpmn:incoming><bpmn:outgoing>P-23_F4</bpmn:outgoing><bpmn:outgoing>P-23_F5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="P-23_t3" name="Informar o motivo da recusa ao parceiro"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-23_F5</bpmn:incoming><bpmn:outgoing>P-23_F6</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-23_t4" name="Contatar o cliente indicado"><bpmn:documentation>Até 2 dias úteis do registro. Quem faz este contato ainda é decisão em aberto.; status: Hipótese</bpmn:documentation><bpmn:incoming>P-23_F4</bpmn:incoming><bpmn:outgoing>P-23_F7</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-23_t5" name="Retornar ao parceiro sobre o primeiro contato"><bpmn:documentation>Até 5 dias úteis do registro.; status: Declarado</bpmn:documentation><bpmn:incoming>P-23_F7</bpmn:incoming><bpmn:outgoing>P-23_F8</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="P-23_t6" name="Atualizar a indicação a cada etapa da venda"><bpmn:documentation>sistema: Portal Wise Partners; No mínimo a cada 15 dias corridos.; status: Declarado</bpmn:documentation><bpmn:incoming>P-23_F8</bpmn:incoming><bpmn:outgoing>P-23_F9</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P-23_g2" name="Cliente fechou?"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-23_F9</bpmn:incoming><bpmn:outgoing>P-23_F10</bpmn:outgoing><bpmn:outgoing>P-23_F11</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:subProcess id="P-23_s1" name="Pagar comissão ao parceiro"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-23_F10</bpmn:incoming><bpmn:outgoing>P-23_F12</bpmn:outgoing></bpmn:subProcess>
    <bpmn:task id="P-23_t7" name="Informar a perda ao parceiro"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-23_F11</bpmn:incoming><bpmn:outgoing>P-23_F13</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="P-23_f1" name="Indicação recusada"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-23_F6</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-23_f2" name="Cliente fechado e comissão paga"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-23_F12</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-23_f3" name="Indicação perdida"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-23_F13</bpmn:incoming></bpmn:endEvent>

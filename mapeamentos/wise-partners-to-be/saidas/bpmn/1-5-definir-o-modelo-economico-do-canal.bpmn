<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-06" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-06">
    <bpmn:participant id="Participant_P-06" name="1.5 Definir o modelo econômico do canal" processRef="Process_P-06" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-06" name="1.5 Definir o modelo econômico do canal" isExecutable="false">
    <bpmn:documentation>Fixar como se calcula o CAC do Wise Partners: comissões, horas e custos diretos (inclusive os anúncios da campanha de parceiros) divididos pelos clientes fechados vindos de parceiros, e os custos por parceiro aprovado e por parceiro ativado. Ninguém informa o CAC de outros canais. No portal: calcula o CAC do Wise Partners a cada mês a partir de comissões, horas, anúncios e custos diretos. [status do fluxo: Hipótese; evidências: nenhuma]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-06">
      <bpmn:lane id="Lane_P-06_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-06_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-06_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-06_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-06_f1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-06_PA-02" name="Diretor">
        <bpmn:flowNodeRef>P-06_t2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-06_i1" name="Planejamento anual"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-06_F1</bpmn:outgoing><bpmn:timerEventDefinition id="P-06_i1_def" /></bpmn:startEvent>
    <bpmn:task id="P-06_t1" name="Listar os custos do canal: comissões, horas, anúncios e outros custos diretos"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-06_F1</bpmn:incoming><bpmn:outgoing>P-06_F2</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-06_t2" name="Confirmar a fórmula do CAC e os custos intermediários"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-06_F2</bpmn:incoming><bpmn:outgoing>P-06_F3</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="P-06_t3" name="Registrar a fórmula no portal"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-06_F3</bpmn:incoming><bpmn:outgoing>P-06_F4</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P-06_f1" name="Fórmula do CAC definida"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-06_F4</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-06_F1" name="" sourceRef="P-06_i1" targetRef="P-06_t1" />
    <bpmn:sequenceFlow id="P-06_F2" name="" sourceRef="P-06_t1" targetRef="P-06_t2" />
    <bpmn:sequenceFlow id="P-06_F3" name="" sourceRef="P-06_t2" targetRef="P-06_t3" />
    <bpmn:sequenceFlow id="P-06_F4" name="" sourceRef="P-06_t3" targetRef="P-06_f1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_P-06">
    <bpmndi:BPMNPlane id="BPMNPlane_P-06" bpmnElement="Collaboration_P-06">
      <bpmndi:BPMNShape id="Participant_P-06_di" bpmnElement="Participant_P-06" isHorizontal="true"><dc:Bounds x="0" y="0" width="1000" height="296" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_P-06_PA-01_di" bpmnElement="Lane_P-06_PA-01" isHorizontal="true"><dc:Bounds x="30" y="0" width="970" height="148" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_P-06_PA-02_di" bpmnElement="Lane_P-06_PA-02" isHorizontal="true"><dc:Bounds x="30" y="148" width="970" height="148" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-06_i1_di" bpmnElement="P-06_i1" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="160" y="56" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="123" y="98" width="110" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-06_t1_di" bpmnElement="P-06_t1" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="290" y="38" width="128" height="72" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-06_t2_di" bpmnElement="P-06_t2" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="466" y="186" width="128" height="72" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-06_t3_di" bpmnElement="P-06_t3" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="642" y="38" width="128" height="72" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-06_f1_di" bpmnElement="P-06_f1" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="864" y="56" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="827" y="98" width="110" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P-06_F1_di" bpmnElement="P-06_F1"><di:waypoint x="196" y="74" /><di:waypoint x="290" y="74" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-06_F2_di" bpmnElement="P-06_F2"><di:waypoint x="418" y="74" /><di:waypoint x="442" y="74" /><di:waypoint x="442" y="222" /><di:waypoint x="466" y="222" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-06_F3_di" bpmnElement="P-06_F3"><di:waypoint x="594" y="222" /><di:waypoint x="618" y="222" /><di:waypoint x="618" y="74" /><di:waypoint x="642" y="74" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-06_F4_di" bpmnElement="P-06_F4"><di:waypoint x="770" y="74" /><di:waypoint x="864" y="74" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

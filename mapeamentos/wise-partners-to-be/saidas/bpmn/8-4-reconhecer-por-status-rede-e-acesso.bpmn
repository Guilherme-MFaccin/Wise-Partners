<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-51" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-51">
    <bpmn:participant id="Participant_P-51" name="8.4 Reconhecer por status, rede e acesso" processRef="Process_P-51" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-51" name="8.4 Reconhecer por status, rede e acesso" isExecutable="false">
    <bpmn:documentation>Reconhecimento que não é dinheiro: destaque público, acesso antecipado a pedidos da Prateleira, convite a palco e apresentação a pessoas. No portal: sugere quem reconhecer a partir do cubo e do ranking. [status do fluxo: Hipótese; evidências: nenhuma]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-51">
      <bpmn:lane id="Lane_P-51_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-51_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-51_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-51_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-51_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-51_f1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-51_i1" name="Fechamento do mês ou do trimestre"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-51_F1</bpmn:outgoing><bpmn:timerEventDefinition id="P-51_i1_def" /></bpmn:startEvent>
    <bpmn:serviceTask id="P-51_t1" name="Sugerir quem reconhecer pelo cubo e pelo ranking"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-51_F1</bpmn:incoming><bpmn:outgoing>P-51_F2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:task id="P-51_t2" name="Escolher os reconhecidos e a forma de reconhecer"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-51_F2</bpmn:incoming><bpmn:outgoing>P-51_F3</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="P-51_t3" name="Registrar o reconhecimento"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-51_F3</bpmn:incoming><bpmn:outgoing>P-51_F4</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P-51_f1" name="Reconhecimentos definidos para o comunicado e o encontro"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-51_F4</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-51_F1" name="" sourceRef="P-51_i1" targetRef="P-51_t1" />
    <bpmn:sequenceFlow id="P-51_F2" name="" sourceRef="P-51_t1" targetRef="P-51_t2" />
    <bpmn:sequenceFlow id="P-51_F3" name="" sourceRef="P-51_t2" targetRef="P-51_t3" />
    <bpmn:sequenceFlow id="P-51_F4" name="" sourceRef="P-51_t3" targetRef="P-51_f1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_P-51">
    <bpmndi:BPMNPlane id="BPMNPlane_P-51" bpmnElement="Collaboration_P-51">

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-100" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-100">
    <bpmn:participant id="Participant_P-100" name="12.5 Manter os cases de resultado atualizados" processRef="Process_P-100" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-100" name="12.5 Manter os cases de resultado atualizados" isExecutable="false">
    <bpmn:documentation>A cada trimestre, o Gerente lê a página de cases da Wise Makers e atualiza os números, os nomes e o destaque de média nas duas páginas, no kit e no minicurso. Os cases comparam os meses de trabalho com os mesmos meses do ano anterior à entrada da Wise, sem valores em reais. Hoje: Florart's Decor (decoração e ambientes de alto padrão), +89,4% de jan/25 a out/26; Maringá Portas (indústria de portas), +43,8% de jan/26 a out/26; Chamego Bandeiras (indústria de bandeiras), +39,7% de jan/25 a ago/26; Fusion Alumínios (portas de vidro e soluções para móveis planejados), +25,7% de fev/25 a nov/25; Totonho Locações (locação de móveis e peças para festas e eventos), +25,4% de jan/26 a out/26; Protectpool (soluções para piscinas e rede de revendedores), +20,8% de jan/25 a out/26; Powerfit (equipamentos esportivos para o mercado fitness), +19,9% de jan/25 a out/25; Nicopel (indústria de embalagens personalizadas), +16,5% de jan/26 a out/26; média de +35%. Todos os 8 clientes autorizaram o uso do nome. No portal: guarda os cases num lugar só, usado pelas páginas e pelo kit. [status do fluxo: Confirmado; evidências: EV-0406]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-100">
      <bpmn:lane id="Lane_P-100_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-100_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-100_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-100_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-100_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-100_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-100_f1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-100_i1" name="Primeiro dia útil do trimestre"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:outgoing>P-100_F1</bpmn:outgoing><bpmn:timerEventDefinition id="P-100_i1_def" /></bpmn:startEvent>
    <bpmn:task id="P-100_t1" name="Ler a página de cases da Wise Makers"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-100_F1</bpmn:incoming><bpmn:outgoing>P-100_F2</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-100_t2" name="Conferir se entrou case novo e se os clientes autorizam o nome"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-100_F2</bpmn:incoming><bpmn:outgoing>P-100_F3</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="P-100_t3" name="Atualizar os números, os nomes e a média no portal"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-100_F3</bpmn:incoming><bpmn:outgoing>P-100_F4</bpmn:outgoing></bpmn:userTask>
    <bpmn:task id="P-100_t4" name="Conferir as duas páginas, o kit e o minicurso"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-100_F4</bpmn:incoming><bpmn:outgoing>P-100_F5</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="P-100_f1" name="Cases atualizados"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-100_F5</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-100_F1" name="" sourceRef="P-100_i1" targetRef="P-100_t1" />
    <bpmn:sequenceFlow id="P-100_F2" name="" sourceRef="P-100_t1" targetRef="P-100_t2" />
    <bpmn:sequenceFlow id="P-100_F3" name="" sourceRef="P-100_t2" targetRef="P-100_t3" />
    <bpmn:sequenceFlow id="P-100_F4" name="" sourceRef="P-100_t3" targetRef="P-100_t4" />
    <bpmn:sequenceFlow id="P-100_F5" name="" sourceRef="P-100_t4" targetRef="P-100_f1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_P-100">
    <bpmndi:BPMNPlane id="BPMNPlane_P-100" bpmnElement="Collaboration_P-100">
      <bpmndi:BPMNShape id="Participant_P-100_di" bpmnElement="Participant_P-100" isHorizontal="true"><dc:Bounds x="0" y="0" width="1176" height="148" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_P-100_PA-01_di" bpmnElement="Lane_P-100_PA-01" isHorizontal="true"><dc:Bounds x="30" y="0" width="1146" height="148" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-100_i1_di" bpmnElement="P-100_i1" color:background-color="#D9F2E1" color:border-color="#2F8F4E"><dc:Bounds x="160" y="56" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="123" y="98" width="110" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-100_t1_di" bpmnElement="P-100_t1" color:background-color="#D9F2E1" color:border-color="#2F8F4E"><dc:Bounds x="290" y="38" width="128" height="72" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-100_t2_di" bpmnElement="P-100_t2" color:background-color="#D9F2E1" color:border-color="#2F8F4E"><dc:Bounds x="466" y="38" width="128" height="72" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-100_t3_di" bpmnElement="P-100_t3" color:background-color="#D9F2E1" color:border-color="#2F8F4E"><dc:Bounds x="642" y="38" width="128" height="72" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-100_t4_di" bpmnElement="P-100_t4" color:background-color="#D9F2E1" color:border-color="#2F8F4E"><dc:Bounds x="818" y="38" width="128" height="72" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-100_f1_di" bpmnElement="P-100_f1" color:background-color="#D9F2E1" color:border-color="#2F8F4E"><dc:Bounds x="1040" y="56" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1003" y="98" width="110" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P-100_F1_di" bpmnElement="P-100_F1"><di:waypoint x="196" y="74" /><di:waypoint x="290" y="74" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-100_F2_di" bpmnElement="P-100_F2"><di:waypoint x="418" y="74" /><di:waypoint x="466" y="74" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-100_F3_di" bpmnElement="P-100_F3"><di:waypoint x="594" y="74" /><di:waypoint x="642" y="74" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-100_F4_di" bpmnElement="P-100_F4"><di:waypoint x="770" y="74" /><di:waypoint x="818" y="74" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-100_F5_di" bpmnElement="P-100_F5"><di:waypoint x="946" y="74" /><di:waypoint x="1040" y="74" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-97" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-97">
    <bpmn:participant id="Participant_P-97" name="5.5 Lembrar o parceiro parado numa etapa" processRef="Process_P-97" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-97" name="5.5 Lembrar o parceiro parado numa etapa" isExecutable="false">
    <bpmn:documentation>Sem prazo em dias, o processo não estoura; o que existe é um lembrete. Quando o parceiro fica na mesma etapa além do limite, o portal manda um e-mail com o próximo passo; se ele continuar parado, o caso entra na fila de exceções com os dias na etapa, e o Gerente decide se vale uma mensagem pessoal. No portal: conta os dias em cada etapa, envia o lembrete e põe o caso na fila. [status do fluxo: Confirmado; evidências: EV-0349]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-97">
      <bpmn:lane id="Lane_P-97_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-97_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-97_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-97_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-97_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-97_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-97_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-97_f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-97_f2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-97_PA-05" name="Responsável nomeado no parceiro">
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-97_i1" name="Parceiro na mesma etapa além do limite"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:outgoing>P-97_F1</bpmn:outgoing><bpmn:timerEventDefinition id="P-97_i1_def" /></bpmn:startEvent>
    <bpmn:serviceTask id="P-97_t1" name="Enviar o lembrete por e-mail com o próximo passo"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-97_F1</bpmn:incoming><bpmn:outgoing>P-97_F2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="P-97_e1" name="Prazo depois do lembrete"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-97_F2</bpmn:incoming><bpmn:outgoing>P-97_F3</bpmn:outgoing><bpmn:timerEventDefinition id="P-97_e1_def" /></bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="P-97_g1" name="O parceiro avançou de etapa?"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-97_F3</bpmn:incoming><bpmn:outgoing>P-97_F4</bpmn:outgoing><bpmn:outgoing>P-97_F5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P-97_t2" name="Pôr o caso na fila de exceções com os dias na etapa"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-97_F5</bpmn:incoming><bpmn:outgoing>P-97_F6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:task id="P-97_t3" name="Decidir se vale uma mensagem pessoal"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-97_F6</bpmn:incoming><bpmn:outgoing>P-97_F7</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="P-97_f1" name="Parceiro de volta ao onboarding"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-97_F4</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-97_f2" name="Caso parado tratado"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-97_F7</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-97_F1" name="" sourceRef="P-97_i1" targetRef="P-97_t1" />
    <bpmn:sequenceFlow id="P-97_F2" name="" sourceRef="P-97_t1" targetRef="P-97_e1" />
    <bpmn:sequenceFlow id="P-97_F3" name="" sourceRef="P-97_e1" targetRef="P-97_g1" />
    <bpmn:sequenceFlow id="P-97_F4" name="Sim" sourceRef="P-97_g1" targetRef="P-97_f1" />
    <bpmn:sequenceFlow id="P-97_F5" name="Não" sourceRef="P-97_g1" targetRef="P-97_t2" />
    <bpmn:sequenceFlow id="P-97_F6" name="" sourceRef="P-97_t2" targetRef="P-97_t3" />
    <bpmn:sequenceFlow id="P-97_F7" name="" sourceRef="P-97_t3" targetRef="P-97_f2" />
  </bpmn:process>

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-55" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-55">
    <bpmn:participant id="Participant_P-55" name="5.4 Atender necessidade do cliente pela Prateleira" processRef="Process_P-55" />
    <bpmn:participant id="Ext_P-55_X1" name="Parceiro" />
    <bpmn:participant id="Ext_P-55_X2" name="Cliente industrial" />
    <bpmn:messageFlow id="P-55_M1" name="Clique em falar com o parceiro" sourceRef="Ext_P-55_X2" targetRef="P-55_e1" />
    <bpmn:messageFlow id="P-55_M2" name="Aviso de contato" sourceRef="P-55_t7" targetRef="Ext_P-55_X1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-55" name="5.4 Atender necessidade do cliente pela Prateleira" isExecutable="false">
    <bpmn:documentation>O consultor relata a necessidade, o Gerente registra o pedido, recebe a recomendação de parceiros, publica a página do cliente e acompanha o contato. [status do fluxo: Declarado; evidências: EV-0187, EV-0180, EV-0005]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-55">
      <bpmn:lane id="Lane_P-55_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-55_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-55_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-55_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-55_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-55_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-55_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-55_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-55_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-55_t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-55_f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-55_f2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-55_PA-03" name="Consultor ou comercial do grupo">
        <bpmn:flowNodeRef>P-55_i1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-55_i1" name="Consultor relata a necessidade do cliente"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:outgoing>P-55_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P-55_t1" name="Registrar o pedido do cliente"><bpmn:documentation>sistema: Portal Wise Partners; status: Declarado</bpmn:documentation><bpmn:incoming>P-55_F1</bpmn:incoming><bpmn:outgoing>P-55_F2</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P-55_t2" name="Recomendar parceiros por categoria"><bpmn:documentation>sistema: Portal Wise Partners; status: Declarado</bpmn:documentation><bpmn:incoming>P-55_F2</bpmn:incoming><bpmn:outgoing>P-55_F3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P-55_g1" name="Há parceiros assinados na categoria?"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-55_F3</bpmn:incoming><bpmn:outgoing>P-55_F4</bpmn:outgoing><bpmn:outgoing>P-55_F5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P-55_t3" name="Registrar a categoria a prospectar"><bpmn:documentation>sistema: Portal Wise Partners; status: Declarado</bpmn:documentation><bpmn:incoming>P-55_F5</bpmn:incoming><bpmn:outgoing>P-55_F6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P-55_t4" name="Ajustar a seleção e resgatar as apresentações dos parceiros"><bpmn:documentation>sistema: Portal Wise Partners; status: Declarado</bpmn:documentation><bpmn:incoming>P-55_F4</bpmn:incoming><bpmn:outgoing>P-55_F7</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P-55_t5" name="Publicar a página do cliente"><bpmn:documentation>sistema: Portal Wise Partners; status: Declarado</bpmn:documentation><bpmn:incoming>P-55_F7</bpmn:incoming><bpmn:outgoing>P-55_F8</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P-55_t6" name="Enviar o link ao consultor"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Declarado</bpmn:documentation><bpmn:incoming>P-55_F8</bpmn:incoming><bpmn:outgoing>P-55_F9</bpmn:outgoing></bpmn:userTask>
    <bpmn:intermediateCatchEvent id="P-55_e1" name="Cliente escolhe falar com um parceiro"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-55_F9</bpmn:incoming><bpmn:outgoing>P-55_F10</bpmn:outgoing><bpmn:messageEventDefinition id="P-55_e1_def" /></bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="P-55_t7" name="Avisar o consultor e o parceiro"><bpmn:documentation>sistema: Portal Wise Partners; status: Declarado</bpmn:documentation><bpmn:incoming>P-55_F10</bpmn:incoming><bpmn:outgoing>P-55_F11</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="P-55_f1" name="Categoria sem fornecedor"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-55_F6</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-55_f2" name="Cliente em contato com o parceiro"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-55_F11</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-55_F1" name="" sourceRef="P-55_i1" targetRef="P-55_t1" />
    <bpmn:sequenceFlow id="P-55_F2" name="" sourceRef="P-55_t1" targetRef="P-55_t2" />
    <bpmn:sequenceFlow id="P-55_F3" name="" sourceRef="P-55_t2" targetRef="P-55_g1" />
    <bpmn:sequenceFlow id="P-55_F4" name="Sim" sourceRef="P-55_g1" targetRef="P-55_t4" />
    <bpmn:sequenceFlow id="P-55_F5" name="Não" sourceRef="P-55_g1" targetRef="P-55_t3" />
    <bpmn:sequenceFlow id="P-55_F6" name="" sourceRef="P-55_t3" targetRef="P-55_f1" />
    <bpmn:sequenceFlow id="P-55_F7" name="" sourceRef="P-55_t4" targetRef="P-55_t5" />
    <bpmn:sequenceFlow id="P-55_F8" name="" sourceRef="P-55_t5" targetRef="P-55_t6" />
    <bpmn:sequenceFlow id="P-55_F9" name="" sourceRef="P-55_t6" targetRef="P-55_e1" />
    <bpmn:sequenceFlow id="P-55_F10" name="" sourceRef="P-55_e1" targetRef="P-55_t7" />
    <bpmn:sequenceFlow id="P-55_F11" name="" sourceRef="P-55_t7" targetRef="P-55_f2" />
  </bpmn:process>

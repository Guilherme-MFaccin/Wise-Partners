<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-04" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-04">
    <bpmn:participant id="Participant_P-04" name="1.3 Definir o perfil de parceiro ideal" processRef="Process_P-04" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-04" name="1.3 Definir o perfil de parceiro ideal" isExecutable="false">
    <bpmn:documentation>Escrever o perfil comercial e o institucional a partir do ICP, com os critérios da fila (clientes empresariais que podem estar no ICP da Wise, não ser concorrente, interesse real, responsável pela parceria) e a regra de só recomendar a um cliente quem a Wise indicaria ao seu melhor cliente. No portal: guarda o perfil e os critérios usados na fila. [status do fluxo: Hipótese; evidências: nenhuma]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-04">
      <bpmn:lane id="Lane_P-04_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-04_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-04_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-04_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-04_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-04_f1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-04_i1" name="Planejamento anual"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-04_F1</bpmn:outgoing><bpmn:timerEventDefinition id="P-04_i1_def" /></bpmn:startEvent>
    <bpmn:task id="P-04_t1" name="Rever o ICP da Wise e as categorias prioritárias"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-04_F1</bpmn:incoming><bpmn:outgoing>P-04_F2</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-04_t2" name="Escrever os critérios da fila e a definição de concorrente"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-04_F2</bpmn:incoming><bpmn:outgoing>P-04_F3</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="P-04_t3" name="Publicar o perfil e os critérios no portal"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-04_F3</bpmn:incoming><bpmn:outgoing>P-04_F4</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P-04_f1" name="Perfil e critérios publicados"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-04_F4</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-04_F1" name="" sourceRef="P-04_i1" targetRef="P-04_t1" />
    <bpmn:sequenceFlow id="P-04_F2" name="" sourceRef="P-04_t1" targetRef="P-04_t2" />
    <bpmn:sequenceFlow id="P-04_F3" name="" sourceRef="P-04_t2" targetRef="P-04_t3" />
    <bpmn:sequenceFlow id="P-04_F4" name="" sourceRef="P-04_t3" targetRef="P-04_f1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_P-04">
    <bpmndi:BPMNPlane id="BPMNPlane_P-04" bpmnElement="Collaboration_P-04">
      <bpmndi:BPMNShape id="Participant_P-04_di" bpmnElement="Participant_P-04" isHorizontal="true"><dc:Bounds x="0" y="0" width="1000" height="148" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_P-04_PA-01_di" bpmnElement="Lane_P-04_PA-01" isHorizontal="true"><dc:Bounds x="30" y="0" width="970" height="148" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-04_i1_di" bpmnElement="P-04_i1" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="160" y="56" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="123" y="98" width="110" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-04_t1_di" bpmnElement="P-04_t1" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="290" y="38" width="128" height="72" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-04_t2_di" bpmnElement="P-04_t2" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="466" y="38" width="128" height="72" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-04_t3_di" bpmnElement="P-04_t3" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="642" y="38" width="128" height="72" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-04_f1_di" bpmnElement="P-04_f1" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="864" y="56" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="827" y="98" width="110" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P-04_F1_di" bpmnElement="P-04_F1"><di:waypoint x="196" y="74" /><di:waypoint x="290" y="74" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-04_F2_di" bpmnElement="P-04_F2"><di:waypoint x="418" y="74" /><di:waypoint x="466" y="74" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-04_F3_di" bpmnElement="P-04_F3"><di:waypoint x="594" y="74" /><di:waypoint x="642" y="74" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-04_F4_di" bpmnElement="P-04_F4"><di:waypoint x="770" y="74" /><di:waypoint x="864" y="74" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

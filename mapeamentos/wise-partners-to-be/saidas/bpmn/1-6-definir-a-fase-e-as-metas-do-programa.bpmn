<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-07" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-07">
    <bpmn:participant id="Participant_P-07" name="1.6 Definir a fase e as metas do programa" processRef="Process_P-07" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-07" name="1.6 Definir a fase e as metas do programa" isExecutable="false">
    <bpmn:documentation>Registrar a fase e os portões da próxima; o Diretor define as metas, que entram quando fizer sentido. No portal: mostra a distância de cada portão e registra as metas do programa e por pessoa. [status do fluxo: Hipótese; evidências: nenhuma]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-07">
      <bpmn:lane id="Lane_P-07_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-07_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-07_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-07_f1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-07_PA-02" name="Diretor">
        <bpmn:flowNodeRef>P-07_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-07_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-07_t3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-07_i1" name="Início de cada trimestre"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-07_F1</bpmn:outgoing><bpmn:timerEventDefinition id="P-07_i1_def" /></bpmn:startEvent>
    <bpmn:serviceTask id="P-07_t1" name="Mostrar a distância de cada portão"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-07_F1</bpmn:incoming><bpmn:outgoing>P-07_F2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:task id="P-07_t2" name="Decidir se o programa muda de fase"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-07_F2</bpmn:incoming><bpmn:outgoing>P-07_F3</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-07_t3" name="Definir ou rever as metas do trimestre"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-07_F3</bpmn:incoming><bpmn:outgoing>P-07_F4</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="P-07_t4" name="Registrar a fase e as metas"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-07_F4</bpmn:incoming><bpmn:outgoing>P-07_F5</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P-07_f1" name="Fase e metas registradas"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-07_F5</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-07_F1" name="" sourceRef="P-07_i1" targetRef="P-07_t1" />
    <bpmn:sequenceFlow id="P-07_F2" name="" sourceRef="P-07_t1" targetRef="P-07_t2" />
    <bpmn:sequenceFlow id="P-07_F3" name="" sourceRef="P-07_t2" targetRef="P-07_t3" />
    <bpmn:sequenceFlow id="P-07_F4" name="" sourceRef="P-07_t3" targetRef="P-07_t4" />
    <bpmn:sequenceFlow id="P-07_F5" name="" sourceRef="P-07_t4" targetRef="P-07_f1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_P-07">
    <bpmndi:BPMNPlane id="BPMNPlane_P-07" bpmnElement="Collaboration_P-07">
      <bpmndi:BPMNShape id="Participant_P-07_di" bpmnElement="Participant_P-07" isHorizontal="true"><dc:Bounds x="0" y="0" width="1176" height="296" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_P-07_PA-01_di" bpmnElement="Lane_P-07_PA-01" isHorizontal="true"><dc:Bounds x="30" y="0" width="1146" height="148" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_P-07_PA-02_di" bpmnElement="Lane_P-07_PA-02" isHorizontal="true"><dc:Bounds x="30" y="148" width="1146" height="148" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-07_i1_di" bpmnElement="P-07_i1" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="160" y="204" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="123" y="246" width="110" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-07_t1_di" bpmnElement="P-07_t1" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="290" y="38" width="128" height="72" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-07_t2_di" bpmnElement="P-07_t2" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="466" y="186" width="128" height="72" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-07_t3_di" bpmnElement="P-07_t3" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="642" y="186" width="128" height="72" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-07_t4_di" bpmnElement="P-07_t4" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="818" y="38" width="128" height="72" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-07_f1_di" bpmnElement="P-07_f1" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="1040" y="56" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1003" y="98" width="110" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P-07_F1_di" bpmnElement="P-07_F1"><di:waypoint x="196" y="222" /><di:waypoint x="266" y="222" /><di:waypoint x="266" y="74" /><di:waypoint x="290" y="74" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-07_F2_di" bpmnElement="P-07_F2"><di:waypoint x="418" y="74" /><di:waypoint x="442" y="74" /><di:waypoint x="442" y="222" /><di:waypoint x="466" y="222" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-07_F3_di" bpmnElement="P-07_F3"><di:waypoint x="594" y="222" /><di:waypoint x="642" y="222" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-07_F4_di" bpmnElement="P-07_F4"><di:waypoint x="770" y="222" /><di:waypoint x="794" y="222" /><di:waypoint x="794" y="74" /><di:waypoint x="818" y="74" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-07_F5_di" bpmnElement="P-07_F5"><di:waypoint x="946" y="74" /><di:waypoint x="1040" y="74" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-11" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-11">
    <bpmn:participant id="Participant_P-11" name="2.3 Conduzir a mesa mensal do portfólio" processRef="Process_P-11" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-11" name="2.3 Conduzir a mesa mensal do portfólio" isExecutable="false">
    <bpmn:documentation>Ver o portfólio inteiro por duas lentes: o cubo, para os parceiros ativados (tipo de cada um e quem mudou de tipo), e o funil do onboarding, para os que ainda não ativaram. Decidir onde pôr as horas do mês. No portal: mostra o cubo, as mudanças de tipo, a jogada sugerida para cada parceiro e o funil do onboarding com os dias em cada etapa. [status do fluxo: Hipótese; evidências: nenhuma]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-11">
      <bpmn:lane id="Lane_P-11_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-11_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-11_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-11_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-11_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-11_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-11_f1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-11_i1" name="Primeira semana do mês"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-11_F1</bpmn:outgoing><bpmn:timerEventDefinition id="P-11_i1_def" /></bpmn:startEvent>
    <bpmn:serviceTask id="P-11_t1" name="Mostrar o cubo, as mudanças de tipo e o funil do onboarding"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-11_F1</bpmn:incoming><bpmn:outgoing>P-11_F2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:task id="P-11_t2" name="Escolher os parceiros que recebem atenção no mês"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-11_F2</bpmn:incoming><bpmn:outgoing>P-11_F3</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-11_t3" name="Decidir a jogada de cada um"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-11_F3</bpmn:incoming><bpmn:outgoing>P-11_F4</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="P-11_t4" name="Registrar o plano de atenção do mês"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-11_F4</bpmn:incoming><bpmn:outgoing>P-11_F5</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P-11_f1" name="Plano de atenção do mês definido"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-11_F5</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-11_F1" name="" sourceRef="P-11_i1" targetRef="P-11_t1" />
    <bpmn:sequenceFlow id="P-11_F2" name="" sourceRef="P-11_t1" targetRef="P-11_t2" />
    <bpmn:sequenceFlow id="P-11_F3" name="" sourceRef="P-11_t2" targetRef="P-11_t3" />
    <bpmn:sequenceFlow id="P-11_F4" name="" sourceRef="P-11_t3" targetRef="P-11_t4" />
    <bpmn:sequenceFlow id="P-11_F5" name="" sourceRef="P-11_t4" targetRef="P-11_f1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_P-11">
    <bpmndi:BPMNPlane id="BPMNPlane_P-11" bpmnElement="Collaboration_P-11">
      <bpmndi:BPMNShape id="Participant_P-11_di" bpmnElement="Participant_P-11" isHorizontal="true"><dc:Bounds x="0" y="0" width="1176" height="148" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_P-11_PA-01_di" bpmnElement="Lane_P-11_PA-01" isHorizontal="true"><dc:Bounds x="30" y="0" width="1146" height="148" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-11_i1_di" bpmnElement="P-11_i1" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="160" y="56" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="123" y="98" width="110" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-11_t1_di" bpmnElement="P-11_t1" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="290" y="38" width="128" height="72" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-11_t2_di" bpmnElement="P-11_t2" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="466" y="38" width="128" height="72" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-11_t3_di" bpmnElement="P-11_t3" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="642" y="38" width="128" height="72" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-11_t4_di" bpmnElement="P-11_t4" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="818" y="38" width="128" height="72" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-11_f1_di" bpmnElement="P-11_f1" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="1040" y="56" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1003" y="98" width="110" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P-11_F1_di" bpmnElement="P-11_F1"><di:waypoint x="196" y="74" /><di:waypoint x="290" y="74" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-11_F2_di" bpmnElement="P-11_F2"><di:waypoint x="418" y="74" /><di:waypoint x="466" y="74" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-11_F3_di" bpmnElement="P-11_F3"><di:waypoint x="594" y="74" /><di:waypoint x="642" y="74" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-11_F4_di" bpmnElement="P-11_F4"><di:waypoint x="770" y="74" /><di:waypoint x="818" y="74" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-11_F5_di" bpmnElement="P-11_F5"><di:waypoint x="946" y="74" /><di:waypoint x="1040" y="74" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

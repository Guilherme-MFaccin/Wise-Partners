<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-41" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-41">
    <bpmn:participant id="Participant_P-41" name="7.1 Aplicar a jogada do tipo" processRef="Process_P-41" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-41" name="7.1 Aplicar a jogada do tipo" isExecutable="false">
    <bpmn:documentation>Para cada um dos oito tipos (Embaixador, Gerador sob tensão, Âncora esfriando, Valioso em risco, Promissor, Ativo sem tração, Cordial seletivo, Desertor), uma ação, uma abordagem e uma cadência; o Potencial decide se o esforço vale. No portal: mostra a jogada e cria as tarefas da cadência do tipo. [status do fluxo: Hipótese; evidências: nenhuma]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-41">
      <bpmn:lane id="Lane_P-41_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-41_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-41_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-41_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-41_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-41_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-41_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-41_f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-41_f2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-41_i1" name="Mudança de tipo ou decisão da mesa mensal"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-41_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="P-41_t1" name="Mostrar a jogada do tipo e a mensagem sugerida"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-41_F1</bpmn:incoming><bpmn:outgoing>P-41_F2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P-41_g1" name="O tipo é de risco?"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-41_F2</bpmn:incoming><bpmn:outgoing>P-41_F3</bpmn:outgoing><bpmn:outgoing>P-41_F4</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="P-41_t2" name="Decidir a intensidade pelo Potencial do parceiro"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-41_F4</bpmn:incoming><bpmn:outgoing>P-41_F5</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-41_t3" name="Aplicar a ação do tipo com o parceiro"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Hipótese</bpmn:documentation><bpmn:incoming>P-41_F5</bpmn:incoming><bpmn:outgoing>P-41_F6</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="P-41_t4" name="Registrar a jogada e a próxima data"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-41_F6</bpmn:incoming><bpmn:outgoing>P-41_F7</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P-41_f1" name="Caso de risco encaminhado para a retomada"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-41_F3</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-41_f2" name="Jogada aplicada"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-41_F7</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-41_F1" name="" sourceRef="P-41_i1" targetRef="P-41_t1" />
    <bpmn:sequenceFlow id="P-41_F2" name="" sourceRef="P-41_t1" targetRef="P-41_g1" />
    <bpmn:sequenceFlow id="P-41_F3" name="Sim" sourceRef="P-41_g1" targetRef="P-41_f1" />
    <bpmn:sequenceFlow id="P-41_F4" name="Não" sourceRef="P-41_g1" targetRef="P-41_t2" />
    <bpmn:sequenceFlow id="P-41_F5" name="" sourceRef="P-41_t2" targetRef="P-41_t3" />
    <bpmn:sequenceFlow id="P-41_F6" name="" sourceRef="P-41_t3" targetRef="P-41_t4" />
    <bpmn:sequenceFlow id="P-41_F7" name="" sourceRef="P-41_t4" targetRef="P-41_f2" />
  </bpmn:process>

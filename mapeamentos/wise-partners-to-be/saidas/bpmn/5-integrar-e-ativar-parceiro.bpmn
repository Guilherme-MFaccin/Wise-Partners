<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-27" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-27">
    <bpmn:participant id="Participant_P-27" name="5 Integrar e ativar parceiro" processRef="Process_P-27" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-27" name="5 Integrar e ativar parceiro" isExecutable="false">
    <bpmn:documentation>Do termo assinado à ativação em até 90 dias (extensão até 120), entregando o primeiro valor em fatias. No portal: cria o plano de 90 dias com marcos dentro do card do parceiro e marca a ativação sozinho quando a primeira indicação no ICP vira reunião. [status do fluxo: Confirmado; evidências: EV-0016, EV-0049, EV-0125]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-27">
      <bpmn:lane id="Lane_P-27_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-27_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-27_s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-27_s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-27_s3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-27_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-27_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-27_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-27_f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-27_f2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-27_PA-05" name="Responsável nomeado no parceiro">
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-27_i1" name="Termo assinado"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:outgoing>P-27_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:subProcess id="P-27_s1" name="Preparar a entrada do parceiro"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-27_F1</bpmn:incoming><bpmn:outgoing>P-27_F2</bpmn:outgoing></bpmn:subProcess>
    <bpmn:subProcess id="P-27_s2" name="Conduzir o encontro de alinhamento"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-27_F2</bpmn:incoming><bpmn:outgoing>P-27_F3</bpmn:outgoing></bpmn:subProcess>
    <bpmn:subProcess id="P-27_s3" name="Ensinar o parceiro a indicar"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-27_F3</bpmn:incoming><bpmn:outgoing>P-27_F4</bpmn:outgoing></bpmn:subProcess>
    <bpmn:exclusiveGateway id="P-27_g1" name="Parceiro ativado em 90 dias?"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-27_F4</bpmn:incoming><bpmn:outgoing>P-27_F5</bpmn:outgoing><bpmn:outgoing>P-27_F6</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P-27_t1" name="Estender o plano até 120 dias"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-27_F6</bpmn:incoming><bpmn:outgoing>P-27_F7</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P-27_g2" name="Parceiro ativado em 120 dias?"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-27_F7</bpmn:incoming><bpmn:outgoing>P-27_F8</bpmn:outgoing><bpmn:outgoing>P-27_F9</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="P-27_f1" name="Parceiro ativado"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-27_F5</bpmn:incoming><bpmn:incoming>P-27_F8</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-27_f2" name="Parceiro não ativado"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-27_F9</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-27_F1" name="" sourceRef="P-27_i1" targetRef="P-27_s1" />
    <bpmn:sequenceFlow id="P-27_F2" name="" sourceRef="P-27_s1" targetRef="P-27_s2" />
    <bpmn:sequenceFlow id="P-27_F3" name="" sourceRef="P-27_s2" targetRef="P-27_s3" />
    <bpmn:sequenceFlow id="P-27_F4" name="" sourceRef="P-27_s3" targetRef="P-27_g1" />
    <bpmn:sequenceFlow id="P-27_F5" name="Sim" sourceRef="P-27_g1" targetRef="P-27_f1" />
    <bpmn:sequenceFlow id="P-27_F6" name="Não" sourceRef="P-27_g1" targetRef="P-27_t1" />
    <bpmn:sequenceFlow id="P-27_F7" name="" sourceRef="P-27_t1" targetRef="P-27_g2" />
    <bpmn:sequenceFlow id="P-27_F8" name="Sim" sourceRef="P-27_g2" targetRef="P-27_f1" />
    <bpmn:sequenceFlow id="P-27_F9" name="Não" sourceRef="P-27_g2" targetRef="P-27_f2" />
  </bpmn:process>

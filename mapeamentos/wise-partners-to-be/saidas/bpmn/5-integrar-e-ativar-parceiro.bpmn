<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-26" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-26">
    <bpmn:participant id="Participant_P-26" name="5 Integrar e ativar parceiro" processRef="Process_P-26" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-26" name="5 Integrar e ativar parceiro" isExecutable="false">
    <bpmn:documentation>Do acesso criado à ativação, por etapas e metas, sem prazo em dias: o tempo varia de caso a caso. Todo parceiro começa como Select; o portal mostra em que etapa cada um está e há quantos dias, e lembra quem parou. No portal: cria as etapas do nível no card do parceiro, mostra os dias em cada etapa e marca a ativação sozinho no primeiro cliente cadastrado pelo link. [status do fluxo: Confirmado; evidências: EV-0342, EV-0343]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-26">
      <bpmn:lane id="Lane_P-26_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-26_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-26_s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-26_s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-26_f1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-26_i1" name="Acesso criado na conversa de entrada"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:outgoing>P-26_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:subProcess id="P-26_s1" name="Preparar a entrada do parceiro"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-26_F1</bpmn:incoming><bpmn:outgoing>P-26_F2</bpmn:outgoing></bpmn:subProcess>
    <bpmn:subProcess id="P-26_s2" name="Conduzir o onboarding por etapas"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-26_F2</bpmn:incoming><bpmn:outgoing>P-26_F3</bpmn:outgoing></bpmn:subProcess>
    <bpmn:endEvent id="P-26_f1" name="Parceiro ativado e onboarding do Select concluído"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-26_F3</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-26_F1" name="" sourceRef="P-26_i1" targetRef="P-26_s1" />
    <bpmn:sequenceFlow id="P-26_F2" name="" sourceRef="P-26_s1" targetRef="P-26_s2" />
    <bpmn:sequenceFlow id="P-26_F3" name="" sourceRef="P-26_s2" targetRef="P-26_f1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_P-26">
    <bpmndi:BPMNPlane id="BPMNPlane_P-26" bpmnElement="Collaboration_P-26">
      <bpmndi:BPMNShape id="Participant_P-26_di" bpmnElement="Participant_P-26" isHorizontal="true"><dc:Bounds x="0" y="0" width="824" height="148" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_P-26_PA-01_di" bpmnElement="Lane_P-26_PA-01" isHorizontal="true"><dc:Bounds x="30" y="0" width="794" height="148" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-26_i1_di" bpmnElement="P-26_i1" color:background-color="#D9F2E1" color:border-color="#2F8F4E"><dc:Bounds x="160" y="56" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="123" y="98" width="110" height="42" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-26_s1_di" bpmnElement="P-26_s1" isExpanded="false" color:background-color="#D9F2E1" color:border-color="#2F8F4E"><dc:Bounds x="290" y="38" width="128" height="72" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-26_s2_di" bpmnElement="P-26_s2" isExpanded="false" color:background-color="#D9F2E1" color:border-color="#2F8F4E"><dc:Bounds x="466" y="38" width="128" height="72" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-26_f1_di" bpmnElement="P-26_f1" color:background-color="#D9F2E1" color:border-color="#2F8F4E"><dc:Bounds x="688" y="56" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="651" y="98" width="110" height="42" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P-26_F1_di" bpmnElement="P-26_F1"><di:waypoint x="196" y="74" /><di:waypoint x="290" y="74" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-26_F2_di" bpmnElement="P-26_F2"><di:waypoint x="418" y="74" /><di:waypoint x="466" y="74" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-26_F3_di" bpmnElement="P-26_F3"><di:waypoint x="594" y="74" /><di:waypoint x="688" y="74" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-24" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-24">
    <bpmn:participant id="Participant_P-24" name="4.4 Negociar e formalizar o termo" processRef="Process_P-24" />
    <bpmn:participant id="Ext_P-24_X1" name="Empresa candidata" />
    <bpmn:messageFlow id="P-24_M1" name="Minuta" sourceRef="P-24_t2" targetRef="Ext_P-24_X1" />
    <bpmn:messageFlow id="P-24_M2" name="Críticas" sourceRef="Ext_P-24_X1" targetRef="P-24_e1" />
    <bpmn:messageFlow id="P-24_M3" name="Termo assinado" sourceRef="Ext_P-24_X1" targetRef="P-24_e2" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-24" name="4.4 Negociar e formalizar o termo" isExecutable="false">
    <bpmn:documentation>Texto único: o Gerente propõe a minuta como rascunho, recebe críticas e ajusta até as duas partes aprovarem; o Diretor assina; assinatura digital. No portal: gera a minuta a partir do termo-quadro, guarda as versões e anexa o termo assinado. [status do fluxo: Confirmado; evidências: EV-0007, EV-0092, EV-0167, EV-0013]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-24">
      <bpmn:lane id="Lane_P-24_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-24_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-24_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-24_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-24_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-24_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-24_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-24_e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-24_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-24_f1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-24_PA-02" name="Diretor">
        <bpmn:flowNodeRef>P-24_t4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-24_i1" name="Plano conjunto acordado no workshop"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:outgoing>P-24_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P-24_t1" name="Preencher o termo-quadro"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-24_F1</bpmn:incoming><bpmn:outgoing>P-24_F2</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P-24_t2" name="Enviar a minuta pedindo críticas"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Confirmado</bpmn:documentation><bpmn:incoming>P-24_F2</bpmn:incoming><bpmn:incoming>P-24_F6</bpmn:incoming><bpmn:outgoing>P-24_F3</bpmn:outgoing></bpmn:userTask>
    <bpmn:intermediateCatchEvent id="P-24_e1" name="Críticas do candidato"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-24_F3</bpmn:incoming><bpmn:outgoing>P-24_F4</bpmn:outgoing><bpmn:messageEventDefinition id="P-24_e1_def" /></bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="P-24_g1" name="As duas partes aprovam?"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-24_F4</bpmn:incoming><bpmn:outgoing>P-24_F5</bpmn:outgoing><bpmn:outgoing>P-24_F7</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P-24_t3" name="Ajustar a minuta"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-24_F5</bpmn:incoming><bpmn:outgoing>P-24_F6</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P-24_t4" name="Assinar o termo"><bpmn:documentation>sistema: Autentique; status: Confirmado</bpmn:documentation><bpmn:incoming>P-24_F7</bpmn:incoming><bpmn:outgoing>P-24_F8</bpmn:outgoing></bpmn:userTask>
    <bpmn:intermediateCatchEvent id="P-24_e2" name="Assinatura do parceiro"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-24_F8</bpmn:incoming><bpmn:outgoing>P-24_F9</bpmn:outgoing><bpmn:messageEventDefinition id="P-24_e2_def" /></bpmn:intermediateCatchEvent>
    <bpmn:userTask id="P-24_t5" name="Anexar o termo assinado"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-24_F9</bpmn:incoming><bpmn:outgoing>P-24_F10</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P-24_f1" name="Termo assinado"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-24_F10</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-24_F1" name="" sourceRef="P-24_i1" targetRef="P-24_t1" />
    <bpmn:sequenceFlow id="P-24_F2" name="" sourceRef="P-24_t1" targetRef="P-24_t2" />
    <bpmn:sequenceFlow id="P-24_F3" name="" sourceRef="P-24_t2" targetRef="P-24_e1" />
    <bpmn:sequenceFlow id="P-24_F4" name="" sourceRef="P-24_e1" targetRef="P-24_g1" />
    <bpmn:sequenceFlow id="P-24_F5" name="Não" sourceRef="P-24_g1" targetRef="P-24_t3" />
    <bpmn:sequenceFlow id="P-24_F6" name="" sourceRef="P-24_t3" targetRef="P-24_t2" />
    <bpmn:sequenceFlow id="P-24_F7" name="Sim" sourceRef="P-24_g1" targetRef="P-24_t4" />
    <bpmn:sequenceFlow id="P-24_F8" name="" sourceRef="P-24_t4" targetRef="P-24_e2" />
    <bpmn:sequenceFlow id="P-24_F9" name="" sourceRef="P-24_e2" targetRef="P-24_t5" />
    <bpmn:sequenceFlow id="P-24_F10" name="" sourceRef="P-24_t5" targetRef="P-24_f1" />
  </bpmn:process>

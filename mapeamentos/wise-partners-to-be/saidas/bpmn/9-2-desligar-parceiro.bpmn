<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-56" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-56">
    <bpmn:participant id="Participant_P-56" name="9.2 Desligar parceiro" processRef="Process_P-56" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-56" name="9.2 Desligar parceiro" isExecutable="false">
    <bpmn:documentation>O Gerente decide; o Igor assina o aviso formal de 30 dias, entregue em conversa e por escrito; encerramento com acessos revogados e comissões preservadas. No portal: gera o aviso e revoga os acessos na data. [status do fluxo: Hipótese; evidências: nenhuma]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-56">
      <bpmn:lane id="Lane_P-56_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-56_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-56_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-56_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-56_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-56_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-56_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-56_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-56_f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-56_f2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-56_PA-02" name="Diretor">
        <bpmn:flowNodeRef>P-56_t2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-56_i1" name="Desligamento sugerido, descumprimento do termo ou dano a um cliente"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-56_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="P-56_t1" name="Decidir o desligamento com o motivo"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-56_F1</bpmn:incoming><bpmn:outgoing>P-56_F2</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="P-56_g1" name="Desligar?"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-56_F2</bpmn:incoming><bpmn:outgoing>P-56_F3</bpmn:outgoing><bpmn:outgoing>P-56_F4</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="P-56_t2" name="Assinar o aviso formal"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-56_F4</bpmn:incoming><bpmn:outgoing>P-56_F5</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-56_t3" name="Comunicar o encerramento em conversa e por escrito"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Hipótese</bpmn:documentation><bpmn:incoming>P-56_F5</bpmn:incoming><bpmn:outgoing>P-56_F6</bpmn:outgoing></bpmn:task>
    <bpmn:intermediateCatchEvent id="P-56_e1" name="30 dias de aviso"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-56_F6</bpmn:incoming><bpmn:outgoing>P-56_F7</bpmn:outgoing><bpmn:timerEventDefinition id="P-56_e1_def" /></bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="P-56_t4" name="Encerrar a parceria, revogar os acessos e fechar o link"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-56_F7</bpmn:incoming><bpmn:outgoing>P-56_F8</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P-56_t5" name="Pôr o ex-parceiro na lista de contato anual"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-56_F8</bpmn:incoming><bpmn:outgoing>P-56_F9</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P-56_f1" name="Parceiro mantido em observação"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-56_F3</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-56_f2" name="Parceria encerrada"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-56_F9</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-56_F1" name="" sourceRef="P-56_i1" targetRef="P-56_t1" />
    <bpmn:sequenceFlow id="P-56_F2" name="" sourceRef="P-56_t1" targetRef="P-56_g1" />
    <bpmn:sequenceFlow id="P-56_F3" name="Não" sourceRef="P-56_g1" targetRef="P-56_f1" />
    <bpmn:sequenceFlow id="P-56_F4" name="Sim" sourceRef="P-56_g1" targetRef="P-56_t2" />
    <bpmn:sequenceFlow id="P-56_F5" name="" sourceRef="P-56_t2" targetRef="P-56_t3" />
    <bpmn:sequenceFlow id="P-56_F6" name="" sourceRef="P-56_t3" targetRef="P-56_e1" />
    <bpmn:sequenceFlow id="P-56_F7" name="" sourceRef="P-56_e1" targetRef="P-56_t4" />
    <bpmn:sequenceFlow id="P-56_F8" name="" sourceRef="P-56_t4" targetRef="P-56_t5" />
    <bpmn:sequenceFlow id="P-56_F9" name="" sourceRef="P-56_t5" targetRef="P-56_f2" />
  </bpmn:process>

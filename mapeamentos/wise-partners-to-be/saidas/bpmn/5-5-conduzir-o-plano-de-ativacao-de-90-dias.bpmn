<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-94" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-94">
    <bpmn:participant id="Participant_P-94" name="5.5 Conduzir o plano de ativação de 90 dias" processRef="Process_P-94" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-94" name="5.5 Conduzir o plano de ativação de 90 dias" isExecutable="false">
    <bpmn:documentation>Ação de início logo depois do termo, para o parceiro sentir o valor antes de indicar. Semana 1: anúncio conjunto da parceria, com postagem dos dois lados. Mês 1: treinamento curto de gestão comercial para o time do parceiro e diagnóstico dos dois ou três primeiros clientes dele. Mês 2: divulgação do diagnóstico e do treinamento para a base do parceiro. Mês 3: encontro com a base e as primeiras oportunidades. Vale para todos os pacotes; a Base Ativa segue só no pacote A. No portal: monta o plano de 90 dias pelo pacote, cria as tarefas de cada mês e mostra ao parceiro o que já foi feito. [status do fluxo: Confirmado; evidências: EV-0326, EV-0319]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-94">
      <bpmn:lane id="Lane_P-94_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-94_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-94_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-94_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-94_s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-94_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-94_e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-94_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-94_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-94_f1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-94_PA-05" name="Responsável nomeado no parceiro">
        <bpmn:flowNodeRef>P-94_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-94_t4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-94_i1" name="Termo assinado"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:outgoing>P-94_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="P-94_t1" name="Montar o plano de 90 dias pelo pacote"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-94_F1</bpmn:incoming><bpmn:outgoing>P-94_F2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:task id="P-94_t2" name="Publicar o anúncio conjunto da parceria"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-94_F2</bpmn:incoming><bpmn:outgoing>P-94_F3</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-94_t3" name="Dar o treinamento curto de gestão comercial ao time do parceiro"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-94_F3</bpmn:incoming><bpmn:outgoing>P-94_F4</bpmn:outgoing></bpmn:task>
    <bpmn:subProcess id="P-94_s1" name="Conduzir o diagnóstico do cliente do parceiro"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-94_F4</bpmn:incoming><bpmn:outgoing>P-94_F5</bpmn:outgoing></bpmn:subProcess>
    <bpmn:intermediateCatchEvent id="P-94_e1" name="Início do segundo mês"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-94_F5</bpmn:incoming><bpmn:outgoing>P-94_F6</bpmn:outgoing><bpmn:timerEventDefinition id="P-94_e1_def" /></bpmn:intermediateCatchEvent>
    <bpmn:task id="P-94_t4" name="Divulgar o diagnóstico e o treinamento para a base"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-94_F6</bpmn:incoming><bpmn:outgoing>P-94_F7</bpmn:outgoing></bpmn:task>
    <bpmn:intermediateCatchEvent id="P-94_e2" name="Início do terceiro mês"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-94_F7</bpmn:incoming><bpmn:outgoing>P-94_F8</bpmn:outgoing><bpmn:timerEventDefinition id="P-94_e2_def" /></bpmn:intermediateCatchEvent>
    <bpmn:task id="P-94_t5" name="Conduzir o encontro com a base do parceiro"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-94_F8</bpmn:incoming><bpmn:outgoing>P-94_F9</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="P-94_t6" name="Registrar as primeiras oportunidades"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-94_F9</bpmn:incoming><bpmn:outgoing>P-94_F10</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P-94_f1" name="Plano de 90 dias cumprido"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-94_F10</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-94_F1" name="" sourceRef="P-94_i1" targetRef="P-94_t1" />
    <bpmn:sequenceFlow id="P-94_F2" name="" sourceRef="P-94_t1" targetRef="P-94_t2" />
    <bpmn:sequenceFlow id="P-94_F3" name="" sourceRef="P-94_t2" targetRef="P-94_t3" />
    <bpmn:sequenceFlow id="P-94_F4" name="" sourceRef="P-94_t3" targetRef="P-94_s1" />
    <bpmn:sequenceFlow id="P-94_F5" name="" sourceRef="P-94_s1" targetRef="P-94_e1" />
    <bpmn:sequenceFlow id="P-94_F6" name="" sourceRef="P-94_e1" targetRef="P-94_t4" />
    <bpmn:sequenceFlow id="P-94_F7" name="" sourceRef="P-94_t4" targetRef="P-94_e2" />
    <bpmn:sequenceFlow id="P-94_F8" name="" sourceRef="P-94_e2" targetRef="P-94_t5" />
    <bpmn:sequenceFlow id="P-94_F9" name="" sourceRef="P-94_t5" targetRef="P-94_t6" />
    <bpmn:sequenceFlow id="P-94_F10" name="" sourceRef="P-94_t6" targetRef="P-94_f1" />
  </bpmn:process>

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-09" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-09">
    <bpmn:participant id="Participant_P-09" name="2.1 Resolver as exceções do dia" processRef="Process_P-09" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-09" name="2.1 Resolver as exceções do dia" isExecutable="false">
    <bpmn:documentation>Abrir a fila única ordenada por prazo e tratar só o que fugiu da regra; quando outra pessoa executa, o Gerente combina por WhatsApp ou pessoalmente. No portal: gera a fila a partir das regras (marco atrasado, régua atrasada, mudança de tipo no cubo, oportunidade parada, cadastro na fila sem contato há mais de 24 horas úteis, parceiro parado numa etapa depois do lembrete, retorno pendente ao parceiro) e prepara a mensagem. [status do fluxo: Hipótese; evidências: nenhuma]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-09">
      <bpmn:lane id="Lane_P-09_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-09_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-09_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-09_t0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-09_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-09_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-09_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-09_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-09_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-09_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-09_f1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-09_i1" name="Início do dia de trabalho no programa"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-09_F1</bpmn:outgoing><bpmn:timerEventDefinition id="P-09_i1_def" /></bpmn:startEvent>
    <bpmn:userTask id="P-09_t1" name="Abrir a fila ordenada por prazo"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-09_F1</bpmn:incoming><bpmn:outgoing>P-09_F2</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P-09_t0" name="Pegar a próxima tarefa da fila"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-09_F2</bpmn:incoming><bpmn:incoming>P-09_F10</bpmn:incoming><bpmn:outgoing>P-09_F3</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P-09_g1" name="Quem executa a tarefa?"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-09_F3</bpmn:incoming><bpmn:outgoing>P-09_F4</bpmn:outgoing><bpmn:outgoing>P-09_F5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P-09_t2" name="Concluir a tarefa e registrar o resultado"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-09_F4</bpmn:incoming><bpmn:outgoing>P-09_F8</bpmn:outgoing></bpmn:userTask>
    <bpmn:task id="P-09_t3" name="Combinar com quem executa, pessoalmente ou por mensagem"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Hipótese</bpmn:documentation><bpmn:incoming>P-09_F5</bpmn:incoming><bpmn:outgoing>P-09_F6</bpmn:outgoing></bpmn:task>
    <bpmn:intermediateCatchEvent id="P-09_e1" name="Retorno de quem executa"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-09_F6</bpmn:incoming><bpmn:outgoing>P-09_F7</bpmn:outgoing></bpmn:intermediateCatchEvent>
    <bpmn:userTask id="P-09_t4" name="Registrar o retorno na tarefa"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-09_F7</bpmn:incoming><bpmn:outgoing>P-09_F9</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P-09_g2" name="Ainda há tarefa vencendo hoje?"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-09_F8</bpmn:incoming><bpmn:incoming>P-09_F9</bpmn:incoming><bpmn:outgoing>P-09_F10</bpmn:outgoing><bpmn:outgoing>P-09_F11</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="P-09_f1" name="Fila do dia resolvida"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-09_F11</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-09_F1" name="" sourceRef="P-09_i1" targetRef="P-09_t1" />
    <bpmn:sequenceFlow id="P-09_F2" name="" sourceRef="P-09_t1" targetRef="P-09_t0" />
    <bpmn:sequenceFlow id="P-09_F3" name="" sourceRef="P-09_t0" targetRef="P-09_g1" />
    <bpmn:sequenceFlow id="P-09_F4" name="O Gerente" sourceRef="P-09_g1" targetRef="P-09_t2" />
    <bpmn:sequenceFlow id="P-09_F5" name="Closer, consultor, financeiro ou parceiro" sourceRef="P-09_g1" targetRef="P-09_t3" />
    <bpmn:sequenceFlow id="P-09_F6" name="" sourceRef="P-09_t3" targetRef="P-09_e1" />
    <bpmn:sequenceFlow id="P-09_F7" name="" sourceRef="P-09_e1" targetRef="P-09_t4" />
    <bpmn:sequenceFlow id="P-09_F8" name="" sourceRef="P-09_t2" targetRef="P-09_g2" />
    <bpmn:sequenceFlow id="P-09_F9" name="" sourceRef="P-09_t4" targetRef="P-09_g2" />
    <bpmn:sequenceFlow id="P-09_F10" name="Sim" sourceRef="P-09_g2" targetRef="P-09_t0" />
    <bpmn:sequenceFlow id="P-09_F11" name="Não" sourceRef="P-09_g2" targetRef="P-09_f1" />
  </bpmn:process>

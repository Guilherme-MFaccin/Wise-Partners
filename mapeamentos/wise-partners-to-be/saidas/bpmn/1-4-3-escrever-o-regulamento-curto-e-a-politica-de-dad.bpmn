<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-63" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-63">
    <bpmn:participant id="Participant_P-63" name="1.4.3 Escrever o regulamento curto e a política de dados" processRef="Process_P-63" />
    <bpmn:participant id="Ext_P-63_X1" name="Jurídico" />
    <bpmn:messageFlow id="P-63_M1" name="Texto para revisão" sourceRef="P-63_t1" targetRef="Ext_P-63_X1" />
    <bpmn:messageFlow id="P-63_M2" name="Parecer" sourceRef="Ext_P-63_X1" targetRef="P-63_e1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-63" name="1.4.3 Escrever o regulamento curto e a política de dados" isExecutable="false">
    <bpmn:documentation>Poucas regras (quem participa, como se divide o valor, como se resolvem conflitos) e a política de privacidade e de dados (só dados de empresa, consentimento no cruzamento, resultado do cliente só com autorização, pesquisa com consentimento próprio). Todo texto novo passa pelo jurídico. No portal: gera a página de regras e versiona cada mudança. [status do fluxo: Hipótese; evidências: nenhuma]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-63">
      <bpmn:lane id="Lane_P-63_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-63_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-63_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-63_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-63_f1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-63_PA-02" name="Diretor">
        <bpmn:flowNodeRef>P-63_t2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-63_i1" name="Mudança de regra ou de uso de dados"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-63_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="P-63_t1" name="Redigir a mudança no regulamento ou na política"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-63_F1</bpmn:incoming><bpmn:outgoing>P-63_F2</bpmn:outgoing></bpmn:task>
    <bpmn:intermediateCatchEvent id="P-63_e1" name="Retorno do jurídico"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-63_F2</bpmn:incoming><bpmn:outgoing>P-63_F3</bpmn:outgoing><bpmn:messageEventDefinition id="P-63_e1_def" /></bpmn:intermediateCatchEvent>
    <bpmn:task id="P-63_t2" name="Aprovar o texto"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-63_F3</bpmn:incoming><bpmn:outgoing>P-63_F4</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="P-63_f1" name="Texto aprovado para publicação"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-63_F4</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-63_F1" name="" sourceRef="P-63_i1" targetRef="P-63_t1" />
    <bpmn:sequenceFlow id="P-63_F2" name="" sourceRef="P-63_t1" targetRef="P-63_e1" />
    <bpmn:sequenceFlow id="P-63_F3" name="" sourceRef="P-63_e1" targetRef="P-63_t2" />
    <bpmn:sequenceFlow id="P-63_F4" name="" sourceRef="P-63_t2" targetRef="P-63_f1" />
  </bpmn:process>

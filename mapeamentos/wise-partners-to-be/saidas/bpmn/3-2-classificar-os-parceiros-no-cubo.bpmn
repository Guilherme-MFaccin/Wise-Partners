<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-16" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-16">
    <bpmn:participant id="Participant_P-16" name="3.2 Classificar os parceiros no cubo" processRef="Process_P-16" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-16" name="3.2 Classificar os parceiros no cubo" isExecutable="false">
    <bpmn:documentation>Ler cada parceiro em Valor (receita e pipeline ponderado em 12 meses), Ritmo (recência e frequência de ações de valor) e Relação (pulso trimestral, retorno mútuo e equilíbrio entre dar e receber); o tipo sai da tabela de oito células. No portal: calcula Valor e Ritmo todo dia, Relação a cada trimestre, e avisa quando um parceiro muda de tipo. [status do fluxo: Confirmado; evidências: EV-0139, EV-0091, EV-0162, EV-0092, EV-0163, EV-0137]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-16">
      <bpmn:lane id="Lane_P-16_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-16_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-16_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-16_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-16_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-16_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-16_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-16_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-16_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-16_f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-16_f2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-16_i1" name="Leitura diária do portal"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:outgoing>P-16_F1</bpmn:outgoing><bpmn:timerEventDefinition id="P-16_i1_def" /></bpmn:startEvent>
    <bpmn:serviceTask id="P-16_t1" name="Calcular o Valor de cada parceiro"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-16_F1</bpmn:incoming><bpmn:outgoing>P-16_F2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P-16_t2" name="Calcular o Ritmo de cada parceiro"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-16_F2</bpmn:incoming><bpmn:outgoing>P-16_F3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P-16_g1" name="É fechamento trimestral?"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-16_F3</bpmn:incoming><bpmn:outgoing>P-16_F4</bpmn:outgoing><bpmn:outgoing>P-16_F5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P-16_t3" name="Calcular a Relação com o pulso"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-16_F4</bpmn:incoming><bpmn:outgoing>P-16_F6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P-16_t4" name="Ler o tipo na tabela de oito células"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-16_F5</bpmn:incoming><bpmn:incoming>P-16_F6</bpmn:incoming><bpmn:outgoing>P-16_F7</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P-16_g2" name="O parceiro mudou de tipo?"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-16_F7</bpmn:incoming><bpmn:outgoing>P-16_F8</bpmn:outgoing><bpmn:outgoing>P-16_F9</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P-16_t5" name="Criar a tarefa da jogada do novo tipo"><bpmn:documentation>sistema: Portal Wise Partners; status: Confirmado</bpmn:documentation><bpmn:incoming>P-16_F9</bpmn:incoming><bpmn:outgoing>P-16_F10</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="P-16_f1" name="Tipo mantido"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-16_F8</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-16_f2" name="Tipo atualizado e jogada criada"><bpmn:documentation>status: Confirmado</bpmn:documentation><bpmn:incoming>P-16_F10</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-16_F1" name="" sourceRef="P-16_i1" targetRef="P-16_t1" />
    <bpmn:sequenceFlow id="P-16_F2" name="" sourceRef="P-16_t1" targetRef="P-16_t2" />
    <bpmn:sequenceFlow id="P-16_F3" name="" sourceRef="P-16_t2" targetRef="P-16_g1" />
    <bpmn:sequenceFlow id="P-16_F4" name="Sim" sourceRef="P-16_g1" targetRef="P-16_t3" />
    <bpmn:sequenceFlow id="P-16_F5" name="Não" sourceRef="P-16_g1" targetRef="P-16_t4" />
    <bpmn:sequenceFlow id="P-16_F6" name="" sourceRef="P-16_t3" targetRef="P-16_t4" />
    <bpmn:sequenceFlow id="P-16_F7" name="" sourceRef="P-16_t4" targetRef="P-16_g2" />
    <bpmn:sequenceFlow id="P-16_F8" name="Não" sourceRef="P-16_g2" targetRef="P-16_f1" />
    <bpmn:sequenceFlow id="P-16_F9" name="Sim" sourceRef="P-16_g2" targetRef="P-16_t5" />
    <bpmn:sequenceFlow id="P-16_F10" name="" sourceRef="P-16_t5" targetRef="P-16_f2" />
  </bpmn:process>

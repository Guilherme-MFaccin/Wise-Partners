      <bpmndi:BPMNShape id="P-16_f1_di" bpmnElement="P-16_f1" color:background-color="#D9F2E1" color:border-color="#2F8F4E"><dc:Bounds x="1392" y="56" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1355" y="98" width="110" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>

    <bpmndi:BPMNPlane id="BPMNPlane_P-16" bpmnElement="Collaboration_P-16">
      <bpmndi:BPMNShape id="Participant_P-16_di" bpmnElement="Participant_P-16" isHorizontal="true"><dc:Bounds x="0" y="0" width="1704" height="252" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_P-16_PA-01_di" bpmnElement="Lane_P-16_PA-01" isHorizontal="true"><dc:Bounds x="30" y="0" width="1674" height="252" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-16_i1_di" bpmnElement="P-16_i1" color:background-color="#D9F2E1" color:border-color="#2F8F4E"><dc:Bounds x="160" y="56" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="123" y="98" width="110" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-03" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-03">
    <bpmn:participant id="Participant_P-03" name="1.2 Desenhar a arquitetura de valor para a indústria" processRef="Process_P-03" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-03" name="1.2 Desenhar a arquitetura de valor para a indústria" isExecutable="false">
    <bpmn:documentation>Revisar os cinco elementos de valor e a cobertura de cada um pelos parceiros Premium e Elite, que são os que a Wise recomenda. No portal: mostra a matriz de parceiros Premium e Elite por elemento e onde a cobertura está fraca. [status do fluxo: Hipótese; evidências: nenhuma]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-03">
      <bpmn:lane id="Lane_P-03_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-03_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-03_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-03_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-03_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-03_f1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-03_i1" name="Planejamento anual"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-03_F1</bpmn:outgoing><bpmn:timerEventDefinition id="P-03_i1_def" /></bpmn:startEvent>
    <bpmn:serviceTask id="P-03_t1" name="Montar a matriz de parceiros Premium e Elite por elemento de valor"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-03_F1</bpmn:incoming><bpmn:outgoing>P-03_F2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:task id="P-03_t2" name="Marcar os elementos com cobertura fraca"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-03_F2</bpmn:incoming><bpmn:outgoing>P-03_F3</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-03_t3" name="Escolher as categorias em que falta parceiro para recomendar"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-03_F3</bpmn:incoming><bpmn:outgoing>P-03_F4</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="P-03_f1" name="Matriz de cobertura revista"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-03_F4</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-03_F1" name="" sourceRef="P-03_i1" targetRef="P-03_t1" />
    <bpmn:sequenceFlow id="P-03_F2" name="" sourceRef="P-03_t1" targetRef="P-03_t2" />
    <bpmn:sequenceFlow id="P-03_F3" name="" sourceRef="P-03_t2" targetRef="P-03_t3" />
    <bpmn:sequenceFlow id="P-03_F4" name="" sourceRef="P-03_t3" targetRef="P-03_f1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_P-03">
    <bpmndi:BPMNPlane id="BPMNPlane_P-03" bpmnElement="Collaboration_P-03">
      <bpmndi:BPMNShape id="Participant_P-03_di" bpmnElement="Participant_P-03" isHorizontal="true"><dc:Bounds x="0" y="0" width="1000" height="148" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_P-03_PA-01_di" bpmnElement="Lane_P-03_PA-01" isHorizontal="true"><dc:Bounds x="30" y="0" width="970" height="148" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-03_i1_di" bpmnElement="P-03_i1" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="160" y="56" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="123" y="98" width="110" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-03_t1_di" bpmnElement="P-03_t1" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="290" y="38" width="128" height="72" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-03_t2_di" bpmnElement="P-03_t2" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="466" y="38" width="128" height="72" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-03_t3_di" bpmnElement="P-03_t3" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="642" y="38" width="128" height="72" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-03_f1_di" bpmnElement="P-03_f1" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="864" y="56" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="827" y="98" width="110" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P-03_F1_di" bpmnElement="P-03_F1"><di:waypoint x="196" y="74" /><di:waypoint x="290" y="74" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-03_F2_di" bpmnElement="P-03_F2"><di:waypoint x="418" y="74" /><di:waypoint x="466" y="74" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-03_F3_di" bpmnElement="P-03_F3"><di:waypoint x="594" y="74" /><di:waypoint x="642" y="74" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P-03_F4_di" bpmnElement="P-03_F4"><di:waypoint x="770" y="74" /><di:waypoint x="864" y="74" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

      <bpmndi:BPMNShape id="P-105_t2_di" bpmnElement="P-105_t2" color:background-color="#FFF3C4" color:border-color="#B8860B"><dc:Bounds x="466" y="38" width="128" height="72" /></bpmndi:BPMNShape>

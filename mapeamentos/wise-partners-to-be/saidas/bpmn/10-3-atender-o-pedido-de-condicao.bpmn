      <bpmndi:BPMNEdge id="P-105_F2_di" bpmnElement="P-105_F2"><di:waypoint x="418" y="222" /><di:waypoint x="442" y="222" /><di:waypoint x="442" y="74" /><di:waypoint x="466" y="74" /></bpmndi:BPMNEdge>

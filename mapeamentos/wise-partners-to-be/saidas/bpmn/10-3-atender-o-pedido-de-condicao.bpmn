<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-105" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-105">
    <bpmn:participant id="Participant_P-105" name="10.3 Atender o pedido de condição" processRef="Process_P-105" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-105" name="10.3 Atender o pedido de condição" isExecutable="false">
    <bpmn:documentation>O membro pede a condição pelo portal e recebe um protocolo; quem oferece recebe o contato e fala com ele. Não há etapas de acompanhamento: quem oferece só marca, se quiser, se fechou. A comissão do parceiro à Wise sobre negócio fechado pelo catálogo não é obrigatória. A avaliação de quem comprou entra depois, com a nota visível só para a Wise. [status do fluxo: Declarado; evidências: EV-0456]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-105">
      <bpmn:lane id="Lane_P-105_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-105_t2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-105_PA-08" name="Empresa cliente do Grupo Tríade">
        <bpmn:flowNodeRef>P-105_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-105_t1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-105_PA-05" name="Responsável nomeado no parceiro">
        <bpmn:flowNodeRef>P-105_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-105_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-105_f1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-105_i1" name="Oferta escolhida no catálogo"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:outgoing>P-105_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P-105_t1" name="Pedir a condição e aceitar compartilhar o contato"><bpmn:documentation>sistema: Portal Wise Partners; status: Declarado</bpmn:documentation><bpmn:incoming>P-105_F1</bpmn:incoming><bpmn:outgoing>P-105_F2</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P-105_t2" name="Gerar o protocolo e avisar quem oferece"><bpmn:documentation>sistema: Portal Wise Partners; status: Declarado</bpmn:documentation><bpmn:incoming>P-105_F2</bpmn:incoming><bpmn:outgoing>P-105_F3</bpmn:outgoing></bpmn:userTask>
    <bpmn:task id="P-105_t3" name="Falar com a empresa que pediu"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-105_F3</bpmn:incoming><bpmn:outgoing>P-105_F4</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="P-105_t4" name="Marcar se fechou negócio"><bpmn:documentation>sistema: Portal Wise Partners; status: Declarado</bpmn:documentation><bpmn:incoming>P-105_F4</bpmn:incoming><bpmn:outgoing>P-105_F5</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P-105_f1" name="Pedido atendido"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-105_F5</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-105_F1" name="" sourceRef="P-105_i1" targetRef="P-105_t1" />
    <bpmn:sequenceFlow id="P-105_F2" name="" sourceRef="P-105_t1" targetRef="P-105_t2" />
    <bpmn:sequenceFlow id="P-105_F3" name="" sourceRef="P-105_t2" targetRef="P-105_t3" />
    <bpmn:sequenceFlow id="P-105_F4" name="" sourceRef="P-105_t3" targetRef="P-105_t4" />
    <bpmn:sequenceFlow id="P-105_F5" name="" sourceRef="P-105_t4" targetRef="P-105_f1" />
  </bpmn:process>

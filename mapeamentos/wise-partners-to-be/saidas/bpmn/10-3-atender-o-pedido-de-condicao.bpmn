      <bpmndi:BPMNShape id="P-105_t4_di" bpmnElement="P-105_t4" color:background-color="#FFF3C4" color:border-color="#B8860B"><dc:Bounds x="818" y="334" width="128" height="72" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-105_f1_di" bpmnElement="P-105_f1" color:background-color="#FFF3C4" color:border-color="#B8860B"><dc:Bounds x="1040" y="352" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1003" y="394" width="110" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>

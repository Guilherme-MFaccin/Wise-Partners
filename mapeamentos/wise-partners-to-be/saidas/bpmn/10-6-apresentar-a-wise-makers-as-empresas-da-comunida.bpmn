  <bpmn:collaboration id="Collaboration_P-108">
    <bpmn:participant id="Participant_P-108" name="10.6 Apresentar a Wise Makers às empresas da comunidade" processRef="Process_P-108" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-108" name="10.6 Apresentar a Wise Makers às empresas da comunidade" isExecutable="false">
    <bpmn:documentation>Toda empresa da comunidade tem a aba Conhecer a Wise Makers: o que a Wise Makers faz, o que a empresa indicada recebe e o minicurso Como vender a Wise Makers. Clientes do grupo confirmados e parceiros têm o link próprio para indicar a consultoria gratuita. [status do fluxo: Declarado; evidências: EV-0468]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-108">
      <bpmn:lane id="Lane_P-108_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-108_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-108_t3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-108_PA-08" name="Empresa cliente do Grupo Tríade">
        <bpmn:flowNodeRef>P-108_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-108_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-108_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-108_f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-108_f2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-108_i1" name="Empresa abriu Conhecer a Wise Makers"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:outgoing>P-108_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="P-108_t1" name="Assistir aos módulos do minicurso Como vender a Wise Makers"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-108_F1</bpmn:incoming><bpmn:outgoing>P-108_F2</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="P-108_g1" name="A empresa tem o link de indicação?"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-108_F2</bpmn:incoming><bpmn:outgoing>P-108_F3</bpmn:outgoing><bpmn:outgoing>P-108_F5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="P-108_t2" name="Mandar o link a quem tem time comercial"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-108_F3</bpmn:incoming><bpmn:outgoing>P-108_F4</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="P-108_f1" name="Consultoria indicada"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-108_F4</bpmn:incoming></bpmn:endEvent>
    <bpmn:userTask id="P-108_t3" name="Mostrar o que falta para ter o link"><bpmn:documentation>sistema: Portal Wise Partners; status: Declarado</bpmn:documentation><bpmn:incoming>P-108_F5</bpmn:incoming><bpmn:outgoing>P-108_F6</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P-108_f2" name="Empresa conhece a Wise Makers"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-108_F6</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-108_F1" name="" sourceRef="P-108_i1" targetRef="P-108_t1" />
    <bpmn:sequenceFlow id="P-108_F2" name="" sourceRef="P-108_t1" targetRef="P-108_g1" />
    <bpmn:sequenceFlow id="P-108_F3" name="Sim" sourceRef="P-108_g1" targetRef="P-108_t2" />
    <bpmn:sequenceFlow id="P-108_F4" name="" sourceRef="P-108_t2" targetRef="P-108_f1" />
    <bpmn:sequenceFlow id="P-108_F5" name="Não" sourceRef="P-108_g1" targetRef="P-108_t3" />
    <bpmn:sequenceFlow id="P-108_F6" name="" sourceRef="P-108_t3" targetRef="P-108_f2" />
  </bpmn:process>

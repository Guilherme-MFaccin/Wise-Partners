  <bpmn:collaboration id="Collaboration_P-68">
    <bpmn:participant id="Participant_P-68" name="3.2.4 Ler o tipo e sugerir a jogada" processRef="Process_P-68" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-68" name="3.2.4 Ler o tipo e sugerir a jogada" isExecutable="false">
    <bpmn:documentation>Ler o tipo na tabela de oito células e, se mudou, criar a tarefa da jogada do novo tipo; o Potencial decide a intensidade. No portal: lê a tabela e cria a tarefa. [status do fluxo: Hipótese; evidências: nenhuma]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-68">
      <bpmn:lane id="Lane_P-68_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-68_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-68_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-68_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-68_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-68_f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-68_f2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-68_i1" name="Fator recalculado"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-68_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="P-68_t1" name="Ler o tipo na tabela de oito células"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-68_F1</bpmn:incoming><bpmn:outgoing>P-68_F2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P-68_g1" name="O tipo mudou?"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-68_F2</bpmn:incoming><bpmn:outgoing>P-68_F3</bpmn:outgoing><bpmn:outgoing>P-68_F4</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P-68_t2" name="Criar a tarefa da jogada do novo tipo"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-68_F4</bpmn:incoming><bpmn:outgoing>P-68_F5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="P-68_f1" name="Tipo mantido"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-68_F3</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-68_f2" name="Tipo atualizado e jogada criada"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-68_F5</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-68_F1" name="" sourceRef="P-68_i1" targetRef="P-68_t1" />
    <bpmn:sequenceFlow id="P-68_F2" name="" sourceRef="P-68_t1" targetRef="P-68_g1" />
    <bpmn:sequenceFlow id="P-68_F3" name="Não" sourceRef="P-68_g1" targetRef="P-68_f1" />
    <bpmn:sequenceFlow id="P-68_F4" name="Sim" sourceRef="P-68_g1" targetRef="P-68_t2" />
    <bpmn:sequenceFlow id="P-68_F5" name="" sourceRef="P-68_t2" targetRef="P-68_f2" />
  </bpmn:process>

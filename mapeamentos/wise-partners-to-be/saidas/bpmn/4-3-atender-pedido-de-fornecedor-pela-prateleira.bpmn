<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-25" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-25">
    <bpmn:participant id="Participant_P-25" name="4.3 Atender pedido de fornecedor pela prateleira" processRef="Process_P-25" />
    <bpmn:participant id="Ext_P-25_X1" name="Cliente industrial" />
    <bpmn:participant id="Ext_P-25_X2" name="Parceiro" />
    <bpmn:messageFlow id="P-25_M1" name="Necessidade" sourceRef="Ext_P-25_X1" targetRef="P-25_i1" />
    <bpmn:messageFlow id="P-25_M2" name="Link da página" sourceRef="P-25_t6" targetRef="Ext_P-25_X1" />
    <bpmn:messageFlow id="P-25_M3" name="Clique em falar com o parceiro" sourceRef="Ext_P-25_X1" targetRef="P-25_e1" />
    <bpmn:messageFlow id="P-25_M4" name="Aviso de contato" sourceRef="P-25_t7" targetRef="Ext_P-25_X2" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-25" name="4.3 Atender pedido de fornecedor pela prateleira" isExecutable="false">
    <bpmn:documentation>Registrar a necessidade do cliente, recomendar parceiros com apoio da IA, publicar a página do cliente e acompanhar o contato. [status do fluxo: Declarado; evidências: EV-0089, EV-0123, EV-0068]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-25">
      <bpmn:lane id="Lane_P-25_PA-03" name="Consultor ou gerente de conta do grupo">
        <bpmn:flowNodeRef>P-25_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-25_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-25_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-25_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-25_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-25_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-25_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-25_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-25_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-25_t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-25_f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-25_f2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-25_i1" name="Cliente pede um fornecedor"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:outgoing>P-25_F1</bpmn:outgoing><bpmn:messageEventDefinition id="P-25_i1_def" /></bpmn:startEvent>
    <bpmn:userTask id="P-25_t1" name="Registrar o pedido do cliente"><bpmn:documentation>sistema: Portal Wise Partners; status: Declarado</bpmn:documentation><bpmn:incoming>P-25_F1</bpmn:incoming><bpmn:outgoing>P-25_F2</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P-25_t2" name="Recomendar parceiros por categoria"><bpmn:documentation>sistema: Portal Wise Partners; status: Declarado</bpmn:documentation><bpmn:incoming>P-25_F2</bpmn:incoming><bpmn:outgoing>P-25_F3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P-25_g1" name="Há parceiros assinados na categoria?"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-25_F3</bpmn:incoming><bpmn:outgoing>P-25_F4</bpmn:outgoing><bpmn:outgoing>P-25_F5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P-25_t3" name="Registrar a categoria a prospectar"><bpmn:documentation>sistema: Portal Wise Partners; status: Declarado</bpmn:documentation><bpmn:incoming>P-25_F5</bpmn:incoming><bpmn:outgoing>P-25_F6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P-25_t4" name="Ajustar a seleção de parceiros"><bpmn:documentation>sistema: Portal Wise Partners; No mínimo 3 por categoria sempre que houver 3 ou mais assinados.; status: Declarado</bpmn:documentation><bpmn:incoming>P-25_F4</bpmn:incoming><bpmn:outgoing>P-25_F7</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P-25_t5" name="Montar a página do cliente"><bpmn:documentation>sistema: Portal Wise Partners; status: Declarado</bpmn:documentation><bpmn:incoming>P-25_F7</bpmn:incoming><bpmn:outgoing>P-25_F8</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P-25_t6" name="Revisar e publicar a página"><bpmn:documentation>sistema: Portal Wise Partners; status: Declarado</bpmn:documentation><bpmn:incoming>P-25_F8</bpmn:incoming><bpmn:outgoing>P-25_F9</bpmn:outgoing></bpmn:userTask>
    <bpmn:intermediateCatchEvent id="P-25_e1" name="Cliente escolhe falar com um parceiro"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-25_F9</bpmn:incoming><bpmn:outgoing>P-25_F10</bpmn:outgoing><bpmn:messageEventDefinition id="P-25_e1_def" /></bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="P-25_t7" name="Avisar o consultor e o parceiro"><bpmn:documentation>sistema: Portal Wise Partners; status: Declarado</bpmn:documentation><bpmn:incoming>P-25_F10</bpmn:incoming><bpmn:outgoing>P-25_F11</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="P-25_f1" name="Categoria sem fornecedor"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-25_F6</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-25_f2" name="Cliente em contato com o parceiro"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-25_F11</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-25_F1" name="" sourceRef="P-25_i1" targetRef="P-25_t1" />
    <bpmn:sequenceFlow id="P-25_F2" name="" sourceRef="P-25_t1" targetRef="P-25_t2" />
    <bpmn:sequenceFlow id="P-25_F3" name="" sourceRef="P-25_t2" targetRef="P-25_g1" />
    <bpmn:sequenceFlow id="P-25_F4" name="Sim" sourceRef="P-25_g1" targetRef="P-25_t4" />
    <bpmn:sequenceFlow id="P-25_F5" name="Não" sourceRef="P-25_g1" targetRef="P-25_t3" />
    <bpmn:sequenceFlow id="P-25_F6" name="" sourceRef="P-25_t3" targetRef="P-25_f1" />
    <bpmn:sequenceFlow id="P-25_F7" name="" sourceRef="P-25_t4" targetRef="P-25_t5" />
    <bpmn:sequenceFlow id="P-25_F8" name="" sourceRef="P-25_t5" targetRef="P-25_t6" />
    <bpmn:sequenceFlow id="P-25_F9" name="" sourceRef="P-25_t6" targetRef="P-25_e1" />
    <bpmn:sequenceFlow id="P-25_F10" name="" sourceRef="P-25_e1" targetRef="P-25_t7" />
    <bpmn:sequenceFlow id="P-25_F11" name="" sourceRef="P-25_t7" targetRef="P-25_f2" />
  </bpmn:process>

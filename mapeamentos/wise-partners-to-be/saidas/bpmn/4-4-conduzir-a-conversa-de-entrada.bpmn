    <bpmn:task id="P-23_t3" name="Mostrar como o parceiro ganha e a consultoria gratuita para os clientes dele"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-23_F7</bpmn:incoming><bpmn:outgoing>P-23_F8</bpmn:outgoing></bpmn:task>

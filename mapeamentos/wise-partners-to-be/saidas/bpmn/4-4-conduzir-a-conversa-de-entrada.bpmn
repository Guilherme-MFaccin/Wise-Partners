    <bpmn:exclusiveGateway id="P-23_g1" name="O candidato quer seguir?"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-23_F10</bpmn:incoming><bpmn:outgoing>P-23_F11</bpmn:outgoing><bpmn:outgoing>P-23_F12</bpmn:outgoing></bpmn:exclusiveGateway>

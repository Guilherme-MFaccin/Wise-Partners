    <bpmn:exclusiveGateway id="P-23_g2" name="O Gerente aprova a entrada?"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-23_F13</bpmn:incoming><bpmn:outgoing>P-23_F14</bpmn:outgoing><bpmn:outgoing>P-23_F16</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P-23_t7" name="Descartar o cadastro com o motivo"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-23_F14</bpmn:incoming><bpmn:outgoing>P-23_F15</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P-23_t8" name="Aprovar o cadastro e criar a conta no portal"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-23_F16</bpmn:incoming><bpmn:outgoing>P-23_F17</bpmn:outgoing></bpmn:userTask>
    <bpmn:task id="P-23_ta" name="Entrar no portal com a senha provisória"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-23_F17</bpmn:incoming><bpmn:outgoing>P-23_F18</bpmn:outgoing></bpmn:task>

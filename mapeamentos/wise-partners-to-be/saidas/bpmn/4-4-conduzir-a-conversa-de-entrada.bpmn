    <bpmn:startEvent id="P-23_i1" name="Horário marcado e confirmado"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-23_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="P-23_t0" name="Abrir a reunião no horário marcado"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-23_F1</bpmn:incoming><bpmn:outgoing>P-23_F2</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="P-23_g0" name="O candidato compareceu?"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-23_F2</bpmn:incoming><bpmn:outgoing>P-23_F3</bpmn:outgoing><bpmn:outgoing>P-23_F5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="P-23_t9" name="Oferecer um novo horário"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Hipótese</bpmn:documentation><bpmn:incoming>P-23_F3</bpmn:incoming><bpmn:outgoing>P-23_F4</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-23_t1" name="Perguntar sobre a empresa e os clientes do candidato"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-23_F5</bpmn:incoming><bpmn:outgoing>P-23_F6</bpmn:outgoing></bpmn:task>

  <bpmn:collaboration id="Collaboration_P-45">
    <bpmn:participant id="Participant_P-45" name="7.4 Conduzir o ciclo do Base Ativa" processRef="Process_P-45" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-45" name="7.4 Conduzir o ciclo do Base Ativa" isExecutable="false">
    <bpmn:documentation>Fila por horas disponíveis, 12 semanas com 6 encontros e evento da comunidade do parceiro. No portal: controla a fila, a agenda dos encontros e o evento. [status do fluxo: Declarado; evidências: EV-0155, EV-0183, EV-0184, EV-0185, EV-0186, EV-0187, EV-0188, EV-0189, EV-0190]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-45">
      <bpmn:lane id="Lane_P-45_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-45_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-45_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-45_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-45_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-45_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-45_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-45_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-45_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-45_t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-45_t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-45_f1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-45_PA-05" name="Responsável nomeado no parceiro">
        <bpmn:flowNodeRef>P-45_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-45_t8</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-45_i1" name="Parceiro de pacote A assinado"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:outgoing>P-45_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:exclusiveGateway id="P-45_g1" name="Há horas disponíveis?"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-45_F1</bpmn:incoming><bpmn:outgoing>P-45_F2</bpmn:outgoing><bpmn:outgoing>P-45_F3</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P-45_t1" name="Colocar o parceiro na fila com a data prevista"><bpmn:documentation>sistema: Portal Wise Partners; status: Declarado</bpmn:documentation><bpmn:incoming>P-45_F3</bpmn:incoming><bpmn:outgoing>P-45_F4</bpmn:outgoing></bpmn:userTask>
    <bpmn:intermediateCatchEvent id="P-45_e1" name="Vez do parceiro na fila"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-45_F4</bpmn:incoming><bpmn:outgoing>P-45_F5</bpmn:outgoing><bpmn:timerEventDefinition id="P-45_e1_def" /></bpmn:intermediateCatchEvent>
    <bpmn:task id="P-45_t2" name="Diagnosticar a base do parceiro"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-45_F2</bpmn:incoming><bpmn:incoming>P-45_F5</bpmn:incoming><bpmn:outgoing>P-45_F6</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-45_t3" name="Categorizar a carteira"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-45_F6</bpmn:incoming><bpmn:outgoing>P-45_F7</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-45_t4" name="Definir estrutura e anúncio da comunidade"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-45_F7</bpmn:incoming><bpmn:outgoing>P-45_F8</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="P-45_t5" name="Definir oferta e nutrição"><bpmn:documentation>sistema: Wise Hub; status: Declarado</bpmn:documentation><bpmn:incoming>P-45_F8</bpmn:incoming><bpmn:outgoing>P-45_F9</bpmn:outgoing></bpmn:userTask>
    <bpmn:task id="P-45_t6" name="Planejar formação e evento"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-45_F9</bpmn:incoming><bpmn:outgoing>P-45_F10</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-45_t7" name="Preparar roteiro, divulgação e logística do evento"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-45_F10</bpmn:incoming><bpmn:outgoing>P-45_F11</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-45_t8" name="Promover o evento da comunidade"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-45_F11</bpmn:incoming><bpmn:outgoing>P-45_F12</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="P-45_t9" name="Emitir o certificado metodológico"><bpmn:documentation>sistema: Portal Wise Partners; status: Declarado</bpmn:documentation><bpmn:incoming>P-45_F12</bpmn:incoming><bpmn:outgoing>P-45_F13</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P-45_f1" name="Comunidade validada"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-45_F13</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-45_F1" name="" sourceRef="P-45_i1" targetRef="P-45_g1" />

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-107" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-107">
    <bpmn:participant id="Participant_P-107" name="10.2 Confirmar o cliente do grupo declarado" processRef="Process_P-107" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-107" name="10.2 Confirmar o cliente do grupo declarado" isExecutable="false">
    <bpmn:documentation>Quem declara no cadastro que é cliente de uma empresa do grupo vê o catálogo em vitrine até a Wise confirmar o vínculo. A confirmação libera as condições, os pedidos, as ofertas e o link de indicação; a recusa vai com o motivo para a empresa. O cadastro do cliente pela CS da Tríade ou pelo consultor também confirma. [status do fluxo: Declarado; evidências: EV-0464]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-107">
      <bpmn:lane id="Lane_P-107_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-107_i1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-107_PA-03" name="Closer da empresa do grupo">
        <bpmn:flowNodeRef>P-107_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-107_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-107_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-107_t3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-107_PA-08" name="Empresa cliente do Grupo Tríade">
        <bpmn:flowNodeRef>P-107_f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-107_f2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-107_i1" name="Empresa se declarou cliente do grupo"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:outgoing>P-107_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="P-107_t1" name="Conferir o contrato com a empresa do grupo"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-107_F1</bpmn:incoming><bpmn:outgoing>P-107_F2</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="P-107_g1" name="A empresa é cliente ativa do grupo?"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-107_F2</bpmn:incoming><bpmn:outgoing>P-107_F3</bpmn:outgoing><bpmn:outgoing>P-107_F5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P-107_t2" name="Confirmar o cliente e a empresa do grupo"><bpmn:documentation>sistema: Portal Wise Partners; status: Declarado</bpmn:documentation><bpmn:incoming>P-107_F3</bpmn:incoming><bpmn:outgoing>P-107_F4</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P-107_f1" name="Condições e link de indicação liberados"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-107_F4</bpmn:incoming></bpmn:endEvent>
    <bpmn:userTask id="P-107_t3" name="Registrar o motivo para a empresa"><bpmn:documentation>sistema: Portal Wise Partners; status: Declarado</bpmn:documentation><bpmn:incoming>P-107_F5</bpmn:incoming><bpmn:outgoing>P-107_F6</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P-107_f2" name="Empresa segue com o catálogo em vitrine"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-107_F6</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-107_F1" name="" sourceRef="P-107_i1" targetRef="P-107_t1" />
    <bpmn:sequenceFlow id="P-107_F2" name="" sourceRef="P-107_t1" targetRef="P-107_g1" />
    <bpmn:sequenceFlow id="P-107_F3" name="Sim" sourceRef="P-107_g1" targetRef="P-107_t2" />
    <bpmn:sequenceFlow id="P-107_F4" name="" sourceRef="P-107_t2" targetRef="P-107_f1" />
    <bpmn:sequenceFlow id="P-107_F5" name="Não" sourceRef="P-107_g1" targetRef="P-107_t3" />
    <bpmn:sequenceFlow id="P-107_F6" name="" sourceRef="P-107_t3" targetRef="P-107_f2" />
  </bpmn:process>

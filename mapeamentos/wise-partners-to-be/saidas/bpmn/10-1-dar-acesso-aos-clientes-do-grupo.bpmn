<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-103" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-103">
    <bpmn:participant id="Participant_P-103" name="10.1 Dar acesso aos clientes do grupo" processRef="Process_P-103" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-103" name="10.1 Dar acesso aos clientes do grupo" isExecutable="false">
    <bpmn:documentation>Os clientes da Tríade que já estão na base recebem o login pela CS da Tríade Digital, que apresenta o portal e os benefícios a cada um. Os clientes da Wise recebem a mensagem do consultor responsável. A mensagem leva um vídeo do Igor com os benefícios de estar no ecossistema por ser cliente do Grupo Tríade. [status do fluxo: Declarado; evidências: EV-0448]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-103">
      <bpmn:lane id="Lane_P-103_PA-09" name="CS da Tríade Digital">
        <bpmn:flowNodeRef>P-103_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-103_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-103_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-103_t3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-103_PA-08" name="Empresa cliente do Grupo Tríade">
        <bpmn:flowNodeRef>P-103_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-103_f1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-103_i1" name="Cliente ativo do grupo sem acesso"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:outgoing>P-103_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P-103_t1" name="Cadastrar a empresa cliente no portal"><bpmn:documentation>sistema: Portal Wise Partners; status: Declarado</bpmn:documentation><bpmn:incoming>P-103_F1</bpmn:incoming><bpmn:outgoing>P-103_F2</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P-103_t2" name="Criar o acesso com senha provisória"><bpmn:documentation>sistema: Portal Wise Partners; status: Declarado</bpmn:documentation><bpmn:incoming>P-103_F2</bpmn:incoming><bpmn:outgoing>P-103_F3</bpmn:outgoing></bpmn:userTask>
    <bpmn:task id="P-103_t3" name="Mandar a mensagem com o vídeo do Igor e o acesso"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-103_F3</bpmn:incoming><bpmn:outgoing>P-103_F4</bpmn:outgoing></bpmn:task>
    <bpmn:task id="P-103_t4" name="Entrar no portal e criar a senha"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-103_F4</bpmn:incoming><bpmn:outgoing>P-103_F5</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="P-103_f1" name="Cliente com acesso ao catálogo"><bpmn:documentation>status: Declarado</bpmn:documentation><bpmn:incoming>P-103_F5</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-103_F1" name="" sourceRef="P-103_i1" targetRef="P-103_t1" />
    <bpmn:sequenceFlow id="P-103_F2" name="" sourceRef="P-103_t1" targetRef="P-103_t2" />
    <bpmn:sequenceFlow id="P-103_F3" name="" sourceRef="P-103_t2" targetRef="P-103_t3" />
    <bpmn:sequenceFlow id="P-103_F4" name="" sourceRef="P-103_t3" targetRef="P-103_t4" />
    <bpmn:sequenceFlow id="P-103_F5" name="" sourceRef="P-103_t4" targetRef="P-103_f1" />
  </bpmn:process>

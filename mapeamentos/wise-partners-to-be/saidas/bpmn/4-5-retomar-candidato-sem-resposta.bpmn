<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-25" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-25">
    <bpmn:participant id="Participant_P-25" name="4.5 Retomar candidato sem resposta" processRef="Process_P-25" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-25" name="4.5 Retomar candidato sem resposta" isExecutable="false">
    <bpmn:documentation>Para quem não respondeu ao primeiro contato, não marcou horário ou pediu para falar depois: um número limitado de novas mensagens, espaçadas, cada uma com algo útil. Sem resposta até o fim, o cadastro sai da fila como 'sem resposta'; a empresa pode se cadastrar de novo. No portal: mostra há quantos dias o cadastro está sem resposta, conta as tentativas e lembra a data de retomada. [status do fluxo: Hipótese; evidências: nenhuma]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-25">
      <bpmn:lane id="Lane_P-25_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-25_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-25_i2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-25_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-25_e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-25_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-25_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-25_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-25_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-25_f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-25_f2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-25_i1" name="Candidato sem resposta ou sem horário marcado"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-25_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:startEvent id="P-25_i2" name="Candidato pediu para retomar depois"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-25_F4</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P-25_t3" name="Registrar a data de retomada"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-25_F4</bpmn:incoming><bpmn:outgoing>P-25_F5</bpmn:outgoing></bpmn:userTask>
    <bpmn:intermediateCatchEvent id="P-25_e2" name="Data de retomada"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-25_F5</bpmn:incoming><bpmn:outgoing>P-25_F6</bpmn:outgoing><bpmn:timerEventDefinition id="P-25_e2_def" /></bpmn:intermediateCatchEvent>
    <bpmn:task id="P-25_t1" name="Enviar nova mensagem com algo útil"><bpmn:documentation>sistema: Comunidade Wise Partners no WhatsApp (um grupo por parceiro); status: Hipótese</bpmn:documentation><bpmn:incoming>P-25_F1</bpmn:incoming><bpmn:incoming>P-25_F6</bpmn:incoming><bpmn:incoming>P-25_F8</bpmn:incoming><bpmn:outgoing>P-25_F2</bpmn:outgoing></bpmn:task>
    <bpmn:intermediateCatchEvent id="P-25_e1" name="Intervalo entre as tentativas"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-25_F2</bpmn:incoming><bpmn:outgoing>P-25_F3</bpmn:outgoing><bpmn:timerEventDefinition id="P-25_e1_def" /></bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="P-25_g1" name="O candidato respondeu?"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-25_F3</bpmn:incoming><bpmn:outgoing>P-25_F7</bpmn:outgoing><bpmn:outgoing>P-25_F8</bpmn:outgoing><bpmn:outgoing>P-25_F9</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P-25_t2" name="Tirar o cadastro da fila como sem resposta"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-25_F9</bpmn:incoming><bpmn:outgoing>P-25_F10</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P-25_f1" name="Candidato retomado"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-25_F7</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-25_f2" name="Candidato sem resposta"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-25_F10</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-25_F1" name="" sourceRef="P-25_i1" targetRef="P-25_t1" />
    <bpmn:sequenceFlow id="P-25_F2" name="" sourceRef="P-25_t1" targetRef="P-25_e1" />
    <bpmn:sequenceFlow id="P-25_F3" name="" sourceRef="P-25_e1" targetRef="P-25_g1" />
    <bpmn:sequenceFlow id="P-25_F4" name="" sourceRef="P-25_i2" targetRef="P-25_t3" />
    <bpmn:sequenceFlow id="P-25_F5" name="" sourceRef="P-25_t3" targetRef="P-25_e2" />
    <bpmn:sequenceFlow id="P-25_F6" name="" sourceRef="P-25_e2" targetRef="P-25_t1" />
    <bpmn:sequenceFlow id="P-25_F7" name="Sim" sourceRef="P-25_g1" targetRef="P-25_f1" />
    <bpmn:sequenceFlow id="P-25_F8" name="Não, e ainda há tentativa" sourceRef="P-25_g1" targetRef="P-25_t1" />
    <bpmn:sequenceFlow id="P-25_F9" name="Não, e as tentativas acabaram" sourceRef="P-25_g1" targetRef="P-25_t2" />
    <bpmn:sequenceFlow id="P-25_F10" name="" sourceRef="P-25_t2" targetRef="P-25_f2" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_P-25">
    <bpmndi:BPMNPlane id="BPMNPlane_P-25" bpmnElement="Collaboration_P-25">
      <bpmndi:BPMNShape id="Participant_P-25_di" bpmnElement="Participant_P-25" isHorizontal="true"><dc:Bounds x="0" y="0" width="1528" height="252" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_P-25_PA-01_di" bpmnElement="Lane_P-25_PA-01" isHorizontal="true"><dc:Bounds x="30" y="0" width="1498" height="252" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-25_i1_di" bpmnElement="P-25_i1" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="160" y="56" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="123" y="98" width="110" height="42" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>

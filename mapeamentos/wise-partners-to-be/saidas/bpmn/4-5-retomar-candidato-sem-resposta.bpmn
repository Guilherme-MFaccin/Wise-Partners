      <bpmndi:BPMNShape id="P-25_t3_di" bpmnElement="P-25_t3" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="290" y="38" width="128" height="72" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-25_e2_di" bpmnElement="P-25_e2" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="512" y="56" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="475" y="98" width="110" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-25_t1_di" bpmnElement="P-25_t1" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="642" y="38" width="128" height="72" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-25_e1_di" bpmnElement="P-25_e1" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="864" y="56" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="827" y="98" width="110" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-25_g1_di" bpmnElement="P-25_g1" isMarkerVisible="true" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="1033" y="49" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1003" y="15" width="110" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-25_t2_di" bpmnElement="P-25_t2" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="1170" y="142" width="128" height="72" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-25_f1_di" bpmnElement="P-25_f1" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="1216" y="56" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1179" y="98" width="110" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-25_f2_di" bpmnElement="P-25_f2" color:background-color="#FFFFFF" color:border-color="#8A9099"><dc:Bounds x="1392" y="56" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1355" y="98" width="110" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>

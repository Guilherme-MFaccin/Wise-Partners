<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-92" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-92">
    <bpmn:participant id="Participant_P-92" name="12.2 Proteger dados e privacidade" processRef="Process_P-92" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-92" name="12.2 Proteger dados e privacidade" isExecutable="false">
    <bpmn:documentation>Cruzamento com consentimento que revela só coincidências, só dados de empresa, auditoria de acesso, e o atendimento de quem pede para ver, corrigir ou apagar os dados que deixou numa das páginas. No portal: processa o cruzamento, guarda só as coincidências e registra cada pedido atendido. [status do fluxo: Hipótese; evidências: nenhuma]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-92">
      <bpmn:lane id="Lane_P-92_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-92_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-92_i2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-92_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-92_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-92_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-92_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-92_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-92_f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-92_f2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-92_i1" name="Carteira recebida para cruzamento"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-92_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:startEvent id="P-92_i2" name="Pedido de alguém sobre os próprios dados"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-92_F4</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P-92_t1" name="Conferir o consentimento do parceiro"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-92_F1</bpmn:incoming><bpmn:outgoing>P-92_F2</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P-92_t2" name="Cruzar as carteiras e guardar só as coincidências"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-92_F2</bpmn:incoming><bpmn:outgoing>P-92_F3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P-92_t3" name="Conferir quem pede e quais dados existem"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-92_F4</bpmn:incoming><bpmn:outgoing>P-92_F5</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P-92_t4" name="Atender o pedido: mostrar, corrigir ou apagar"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-92_F5</bpmn:incoming><bpmn:outgoing>P-92_F6</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P-92_t5" name="Registrar o atendimento"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-92_F6</bpmn:incoming><bpmn:outgoing>P-92_F7</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P-92_f1" name="Coincidências guardadas com consentimento"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-92_F3</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-92_f2" name="Pedido atendido e registrado"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-92_F7</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-92_F1" name="" sourceRef="P-92_i1" targetRef="P-92_t1" />
    <bpmn:sequenceFlow id="P-92_F2" name="" sourceRef="P-92_t1" targetRef="P-92_t2" />
    <bpmn:sequenceFlow id="P-92_F3" name="" sourceRef="P-92_t2" targetRef="P-92_f1" />
    <bpmn:sequenceFlow id="P-92_F4" name="" sourceRef="P-92_i2" targetRef="P-92_t3" />

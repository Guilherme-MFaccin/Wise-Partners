<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_P-99" targetNamespace="http://bpmn.io/schema/bpmn" exporter="mapear-processos" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P-99">
    <bpmn:participant id="Participant_P-99" name="10.3 Suspender a recomendação de um parceiro" processRef="Process_P-99" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P-99" name="10.3 Suspender a recomendação de um parceiro" isExecutable="false">
    <bpmn:documentation>Quando um cliente da Wise relata um problema sério com um parceiro recomendado, o Gerente ouve o consultor e o cliente e, se o problema for sério, suspende a recomendação: o parceiro some das listas de recomendação, sem aviso e sem rebaixar o nível. No portal: guarda a marca interna de recomendação suspensa e tira o parceiro das listas de recomendação. [status do fluxo: Hipótese; evidências: nenhuma]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P-99">
      <bpmn:lane id="Lane_P-99_PA-01" name="Gerente de Parcerias">
        <bpmn:flowNodeRef>P-99_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-99_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-99_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-99_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-99_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-99_f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P-99_f2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-99_PA-07" name="Consultor da Wise Makers">
        <bpmn:flowNodeRef>P-99_i1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P-99_i1" name="Consultor relata problema de um cliente com um parceiro recomendado"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:outgoing>P-99_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="P-99_t1" name="Ouvir o consultor e o cliente"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-99_F1</bpmn:incoming><bpmn:outgoing>P-99_F2</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="P-99_g1" name="O problema é sério?"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-99_F2</bpmn:incoming><bpmn:outgoing>P-99_F3</bpmn:outgoing><bpmn:outgoing>P-99_F5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P-99_t2" name="Registrar o problema na ficha do parceiro"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-99_F3</bpmn:incoming><bpmn:outgoing>P-99_F4</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P-99_t3" name="Marcar a recomendação como suspensa"><bpmn:documentation>sistema: Portal Wise Partners; status: Hipótese</bpmn:documentation><bpmn:incoming>P-99_F5</bpmn:incoming><bpmn:outgoing>P-99_F6</bpmn:outgoing></bpmn:userTask>
    <bpmn:task id="P-99_t4" name="Levar o caso à conversa da semana com o Diretor"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-99_F6</bpmn:incoming><bpmn:outgoing>P-99_F7</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="P-99_f1" name="Problema registrado, recomendação mantida"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-99_F4</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P-99_f2" name="Recomendação suspensa"><bpmn:documentation>status: Hipótese</bpmn:documentation><bpmn:incoming>P-99_F7</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P-99_F1" name="" sourceRef="P-99_i1" targetRef="P-99_t1" />
    <bpmn:sequenceFlow id="P-99_F2" name="" sourceRef="P-99_t1" targetRef="P-99_g1" />
    <bpmn:sequenceFlow id="P-99_F3" name="Não" sourceRef="P-99_g1" targetRef="P-99_t2" />
    <bpmn:sequenceFlow id="P-99_F4" name="" sourceRef="P-99_t2" targetRef="P-99_f1" />
    <bpmn:sequenceFlow id="P-99_F5" name="Sim" sourceRef="P-99_g1" targetRef="P-99_t3" />
    <bpmn:sequenceFlow id="P-99_F6" name="" sourceRef="P-99_t3" targetRef="P-99_t4" />
    <bpmn:sequenceFlow id="P-99_F7" name="" sourceRef="P-99_t4" targetRef="P-99_f2" />
  </bpmn:process>

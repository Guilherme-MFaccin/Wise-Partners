o parceiro quanto ganha por indicação&lt;br&gt;&lt;font style='font-size:10px'&gt;Gerente de Parcerias&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D9F2E1;strokeColor=#2F8F4E;fontColor=#14532D;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="640" y="2620" width="250" height="56" as="geometry" /></mxCell><mxCell id="pg-hierarquia-c52" value="&lt;b&gt;4.5&lt;/b&gt; Declarar a ativação ou estender o plano&lt;br&gt;&lt;font style='font-size:10px'&gt;Gerente de Parcerias&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF3C4;strokeColor=#B8860B;fontColor=#5C4300;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="320" y="2690" width="250" height="56" as="geometry" /></mxCell><UserObject label="&lt;b&gt;5&lt;/b&gt; Gerar oportunidades no ecossistema&lt;br&gt;&lt;font style='font-size:10px'&gt;Gerente de Parcerias&lt;/font&gt;" link="data:page/id,pg-p-51" id="pg-hierarquia-c53"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#8A9099;fontColor=#3F4650;dashed=1;dashPattern=6 4;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="0" y="3005" width="250" height="56" as="geometry" /></mxCell></UserObject><mxCell id="pg-hierarquia-c54" value="&lt;b&gt;5.1&lt;/b&gt; Receber e qualificar a oportunidade&lt;br&gt;&lt;font style='font-size:10px'&gt;Gerente de Parcerias&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF3C4;strokeColor=#B8860B;fontColor=#5C4300;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="320" y="2760" width="250" height="56" as="geometry" /></mxCell><mxCell id="pg-hierarquia-c55" value="&lt;b&gt;5.2&lt;/b&gt; Passar a oportunidade a quem vende&lt;br&gt;&lt;font style='font-size:10px'&gt;Gerente de Parcerias&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D9F2E1;strokeColor=#2F8F4E;fontColor=#14532D;fontSize=12;
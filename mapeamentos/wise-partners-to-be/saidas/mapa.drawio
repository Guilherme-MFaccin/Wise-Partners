acote&lt;br&gt;&lt;font style='font-size:10px'&gt;Gerente de Parcerias&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF3C4;strokeColor=#B8860B;fontColor=#5C4300;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="320" y="3670" width="250" height="56" as="geometry" /></mxCell><UserObject label="&lt;b&gt;7.6&lt;/b&gt; Manter a cadência de contato com o parceiro&lt;br&gt;&lt;font style='font-size:10px'&gt;Gerente de Parcerias&lt;/font&gt;" link="data:page/id,pg-p-46" id="pg-hierarquia-c48"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D9F2E1;strokeColor=#2F8F4E;fontColor=#14532D;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="320" y="3740" width="250" height="56" as="geometry" /></mxCell></UserObject><mxCell id="pg-hierarquia-c49" value="&lt;b&gt;8&lt;/b&gt; Cultivar a comunidade Wise Partners&lt;br&gt;&lt;font style='font-size:10px'&gt;Gerente de Parcerias&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D9F2E1;strokeColor=#2F8F4E;fontColor=#14532D;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="0" y="4090" width="250" height="56" as="geometry" /></mxCell><mxCell id="pg-hierarquia-c50" value="&lt;b&gt;8.1&lt;/b&gt; Definir o objetivo da comunidade por fase&lt;br&gt;&lt;font style='font-size:10px'&gt;Gerente de Parcerias&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D9F2E1;strokeColor=#2F8F4E;fontColor=#14532D;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="320" y="3810" width="250" height="56" as="geometry" /></mxCell><mxCell id="pg-hierarquia-c51" value="&lt;b&gt;8.2&lt;/b&gt; Conduzir os rituais da comunidade&lt;br&gt;&lt;font style='font-size:10px'&gt;Gerente de Parcerias&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D9F2E1;strokeColor=#2F8F4E;fontColor=#14532D;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1
;fontColor=#5C4300;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="320" y="870" width="250" height="56" as="geometry" /></mxCell></UserObject><mxCell id="pg-hierarquia-c18" value="&lt;b&gt;2.6&lt;/b&gt; Nutrir candidato&lt;br&gt;&lt;font style='font-size:10px'&gt;Gerente de Parcerias&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF3C4;strokeColor=#B8860B;fontColor=#5C4300;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="320" y="940" width="250" height="56" as="geometry" /></mxCell><UserObject label="&lt;b&gt;3&lt;/b&gt; Integrar parceiro&lt;br&gt;&lt;font style='font-size:10px'&gt;Gerente de Parcerias&lt;/font&gt;" link="data:page/id,pg-p-17" id="pg-hierarquia-c19"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D9F2E1;strokeColor=#2F8F4E;fontColor=#14532D;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="0" y="1115" width="250" height="56" as="geometry" /></mxCell></UserObject><mxCell id="pg-hierarquia-c20" value="&lt;b&gt;3.1&lt;/b&gt; Entregar os itens de entrada do pacote&lt;br&gt;&lt;font style='font-size:10px'&gt;Gerente de Parcerias&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF3C4;strokeColor=#B8860B;fontColor=#5C4300;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="320" y="1010" width="250" height="56" as="geometry" /></mxCell><mxCell id="pg-hierarquia-c21" value="&lt;b&gt;3.2&lt;/b&gt; Conduzir os encontros do plano de 90 dias&lt;br&gt;&lt;font style='font-size:10px'&gt;Gerente de Parcerias&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF3C4;strokeColor=#B8860B;fontColor=#5C4300;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="320" y="1080" width="250" height="56" as="geometry" /></mxCell><mxCell id="pg-hierarquia-c22" value="&lt;b&gt;3.3&lt;/b&gt; Capacitar e certificar pessoas do parceiro&lt;br&gt;&lt;font style='font-size:10px'&gt;Gerente de Parcerias&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF3C4;strokeColor=#B8860B;fontColor=#5C4300;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="320" y="1150" width="250" height="56" as="geometry" /></mxCell><mxCell id="pg-hierarquia-c23" value="&lt;b&gt;3.4&lt;/b&gt; Cruzar carteiras com o parceiro&lt;br&gt;&lt;font style='font-size:10px'&gt;Gerente de Parcerias&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF3C4;strokeColor=#B8860B;fontColor=#5C4300;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="320" y="1220" width="250" height="56" as="geometry" /></mxCell><mxCell id="pg-hierarquia-c24" value="&lt;b&gt;4&lt;/b&gt; Gerar negócios com o parceiro&lt;br&gt;&lt;font style='font-size:10px'&gt;Gerente de Parcerias&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF3C4;strokeColor=#B8860B;fontColor=#5C4300;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="0" y="1465" width="250" height="56" as="geometry" /></mxCell><UserObject label="&lt;b&gt;4.1&lt;/b&gt; Tratar indicação do parceiro&lt;br&gt;&lt;font style='font-size:10px'&gt;Gerente de Parcerias&lt;/font&gt;" link="data:page/id,pg-p-23" id="pg-hierarquia-c25"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF3C4;strokeColor=#B8860B;fontColor=#5C4300;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="320" y="1290" width="250" height="56" as="geometry" /></mxCell></UserObject><mxCell id="pg-hierarquia-c26" value="&lt;b&gt;4.2&lt;/b&gt; Indicar cliente do grupo ao parceiro&lt;br&gt;&lt;font style='font-size:10px'&gt;Consultor ou gerente de conta do grupo&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF3C4;strokeColor=#B8860B;fontColor=#5C4300;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="320" y="1360" width="250" height="56" as="geometry" /></mxCell><UserObject label="&lt;b&gt;4.3&lt;/b&gt; Atender pedido de fornecedor pela prateleira&lt;br&gt;&lt;font style='font-size:10px'&gt;Consultor ou gerente de conta do grupo&lt;/font&gt;" link="data:page/id,pg-p-25" id="pg-hierarquia-c27"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF3C4;strokeColor=#B8860B;fontColor=#5C4300;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="320" y="1430" width="250" height="56" as="geometry" /></mxCell></UserObject><mxCell id="pg-hierarquia-c28" value="&lt;b&gt;4.4&lt;/b&gt; Pedir apoio do parceiro numa venda da Wise&lt;br&gt;&lt;font style='font-size:10px'&gt;Consultor ou gerente de conta do grupo&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#8A9099;fontColor=#3F4650;dashed=1;dashPattern=6 4;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="320" y="1500" width="250" height="56" as="geometry" /></mxCell><mxCell id="pg-hierarquia-c29" value="&lt;b&gt;4.5&lt;/b&gt; Pagar comissão ao parceiro&lt;br&gt;&lt;font style='font-size:10px'&gt;Financeiro&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF3C4;strokeColor=#B8860B;fontColor=#5C4300;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="320" y="1570" width="250" height="56" as="geometry" /></mxCell><mxCell id="pg-hierarquia-c30" value="&lt;b&gt;4.6&lt;/b&gt; Checar cliente indicado aos 6 e 12 meses&lt;br&gt;&lt;font style='font-size:10px'&gt;Gerente de Parcerias&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF3C4;strokeColor=#B8860B;fontColor=#5C4300;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="320" y="1640" width="250" height="56" as="geometry" /></mxCell><mxCell id="pg-hierarquia-c31" value="&lt;b&gt;5&lt;/b&gt; Desenvolver o parceiro&lt;br&gt;&lt;font style='font-size:10px'&gt;Gerente de Parcerias&lt;
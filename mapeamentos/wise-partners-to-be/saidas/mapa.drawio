Color=#5C4300;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="0" y="245" width="250" height="56" as="geometry" /></mxCell><mxCell id="pg-hierarquia-c4" value="&lt;b&gt;1.1&lt;/b&gt; Definir o perfil de parceiro ideal e a proposta de valor&lt;br&gt;&lt;font style='font-size:10px'&gt;Gerente de Parcerias&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF3C4;strokeColor=#B8860B;fontColor=#5C4300;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="320" y="0" width="250" height="56" as="geometry" /></mxCell><mxCell id="pg-hierarquia-c5" value="&lt;b&gt;1.2&lt;/b&gt; Planejar metas e fase do programa&lt;br&gt;&lt;font style='font-size:10px'&gt;Gerente de Parcerias&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF3C4;strokeColor=#B8860B;fontColor=#5C4300;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="320" y="70" width="250" height="56" as="geometry" /></mxCell><mxCell id="pg-hierarquia-c6" value="&lt;b&gt;1.3&lt;/b&gt; Revisar o programa semanalmente&lt;br&gt;&lt;font style='font-size:10px'&gt;Gerente de Parcerias&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF3C4;strokeColor=#B8860B;fontColor=#5C4300;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="320" y="140" width="250" height="56" as="geometry" /></mxCell><UserObject label="&lt;b&gt;1.4&lt;/b&gt; Revisar o nível dos parceiros&lt;br&gt;&lt;font style='font-size:10px'&gt;Gerente de Parcerias&lt;/font&gt;" link="data:page/id,pg-p-05" id="pg-hierarquia-c7"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D9F2E1;strokeColor=#2F8F4E;fontColor=#14532D;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="320" y="210" width="250" height="56" as="geometry" /></mxCell></UserObject><mxCell id="pg-hierarquia-c8" value="&lt;b&gt;1.5&lt;/b&gt; Publicar regras e comunicados&lt;br&gt;&lt;font style='font-size:10px'&gt;Gerente de Parcerias&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF3C4;strokeColor=#B8860B;fontColor=#5C4300;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="320" y="280" width="250" height="56" as="geometry" /></mxCell><mxCell id="pg-hierarquia-c9" value="&lt;b&gt;1.6&lt;/b&gt; Apurar o resultado e o ROI do canal&lt;br&gt;&lt;font style='font-size:10px'&gt;Gerente de Parcerias&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF3C4;strokeColor=#B8860B;fontColor=#5C4300;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="320" y="350" width="250" height="56" as="geometry" /></mxCell><mxCell id="pg-hierarquia-c10" value="&lt;b&gt;1.7&lt;/b&gt; Ouvir a satisfação dos parceiros&lt;br&gt;&lt;font style='font-size:10px'&gt;Gerente de Parcerias&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF3C4;strokeColor=#B8860B;fontColor=#5C4300;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="320" y="420" width="250" height="56" as="geometry" /></mxCell><mxCell id="pg-hierarquia-c11" value="&lt;b&gt;1.8&lt;/b&gt; Apurar o ranking e premiar parceiros&lt;br&gt;&lt;font style='font-size:10px'&gt;Gerente de Parcerias&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF3C4;strokeColor=#B8860B;fontColor=#5C4300;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="320" y="490" width="250" height="56" as="geometry" /></mxCell><UserObject label="&lt;b&gt;2&lt;/b&gt; Captar parceiros&lt;br&gt;&lt;font style='font-size:10px'&gt;Gerente de Parcerias&lt;/font&gt;" link="data:page/id,pg-p-10" id="pg-hierarquia-c12"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF3C4;strokeColor=#B8860B;fontColor=#5C4300;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="0" y="765" width="250" height="56" as="geometry" /></mxCell
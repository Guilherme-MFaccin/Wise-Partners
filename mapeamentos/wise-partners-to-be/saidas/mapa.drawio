" width="250" height="56" as="geometry" /></mxCell><UserObject label="&lt;b&gt;6.3&lt;/b&gt; Revisar a parceria com o parceiro&lt;br&gt;&lt;font style='font-size:10px'&gt;Gerente de Parcerias&lt;/font&gt;" link="data:page/id,pg-p-63" id="pg-hierarquia-c65"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D9F2E1;strokeColor=#2F8F4E;fontColor=#14532D;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="320" y="3460" width="250" height="56" as="geometry" /></mxCell></UserObject><mxCell id="pg-hierarquia-c66" value="&lt;b&gt;6.4&lt;/b&gt; Animar a comunidade Wise Partners&lt;br&gt;&lt;font style='font-size:10px'&gt;Gerente de Parcerias&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#8A9099;fontColor=#3F4650;dashed=1;dashPattern=6 4;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="320" y="3600" width="250" height="56" as="geometry" /></mxCell><mxCell id="pg-hierarquia-c67" value="&lt;b&gt;6.4.1&lt;/b&gt; Publicar o comunicado do mês na comunidade&lt;br&gt;&lt;font style='font-size:10px'&gt;Gerente de Parcerias&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#8A9099;fontColor=#3F4650;dashed=1;dashPattern=6 4;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="640" y="3530" width="250" height="56" as="geometry" /></mxCell><mxCell id="pg-hierarquia-c68" value="&lt;b&gt;6.4.2&lt;/b&gt; Promover a troca entre parceiros&lt;br&gt;&lt;font style='font-size:10px'&gt;Gerente de Parcerias&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#8A9099;fontColor=#3F4650;dashed=1;dashPattern=6 4;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="640" y="3600" width="250" height="56" as="geometry" /></mxCell><mxCell id="pg-hierarquia-c69" value="&lt;b&gt;6.4.3&lt;/b&gt; Abrir a mentoria mensal à carteira dos parceiros&lt;br&gt;&lt;font
# Frontend (Vite). No Lovable, estas variáveis vêm da integração com o Supabase.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=chave-anon-publica

# Edge Functions (defina com: supabase secrets set NOME=valor)
# SUPABASE_URL, SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY já existem no ambiente das funções.
AI_PROVIDER=lovable            # lovable | openai | anthropic | gemini
AI_API_KEY=                    # no Lovable AI: LOVABLE_API_KEY é usada automaticamente
AI_MODEL=google/gemini-2.5-flash
RESEND_API_KEY=
EMAIL_FROM="Wise Partners <parcerias@wisemakers.com.br>"
APP_URL=https://portal.wisemakers.com.br   # endereço público do portal (links nos e-mails e na página de RFP)
CRON_SECRET=troque-por-um-segredo-longo    # usado pelo pg_cron para chamar as rotinas
